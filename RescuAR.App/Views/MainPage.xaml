<ContentPage
    x:Class="RescuAR.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout
        Padding="30"
        Spacing="20">

        <Label
            FontSize="24"
            Text="Evacuation Center Test" />

        <Picker
            x:Name="CenterPicker"
            Title="Select Evacuation Center" />

        <Button
            Text="Launch Unity"
            Clicked="LaunchUnityClicked" />
            
        <Button
            Text="Test Routing"
            Clicked="TestRoutingClicked" />
            
        <Label
            x:Name="RoutingResultLabel"
            Text="" />

    </VerticalStackLayout>

</ContentPage>
    