<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="RescuAR.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            HorizontalOptions="Center"
            FontSize="24"
            Text="Unity Launch Test" />

        <Button
            Text="Launch Unity"
            Clicked="LaunchUnityClicked" />

        <Label
            HorizontalOptions="Center"
            FontSize="18"
            Text="Profile Modules Test"
            Margin="0,20,0,0"/>

        <Button
            Text="View Help Center"
            Clicked="OnHelpCenterClicked" />
            
        <Button
            Text="View Privacy Policy"
            Clicked="OnPrivacyPolicyClicked" />
            
        <Button
            Text="View Terms &amp; Conditions"
            Clicked="OnTermsConditionsClicked" />
            
        <Button
            Text="View System Information"
            Clicked="OnSystemInformationClicked" />

        <Label
            HorizontalOptions="Center"
            FontSize="18"
            Text="Home Modules Test"
            Margin="0,20,0,0"/>

        <Button
            Text="View Summary"
            Clicked="OnSummaryClicked" />

    </VerticalStackLayout>

</ContentPage>
    