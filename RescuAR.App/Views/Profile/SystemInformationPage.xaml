<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="RescuAR.App.Views.Profile.SystemInformationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Profile"
    x:DataType="vm:SystemInformationViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource FillNeutralsPrimaryLight}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Row Label Style (left side) -->
            <Style x:Key="InfoLabelStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="GeistRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TypoNeutralsPrimaryLight}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Row Value Style (right side) -->
            <Style x:Key="InfoValueStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="GeistRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TypoNeutralsSecondaryLight}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

            <!-- Section Header Style -->
            <Style x:Key="SysInfoSectionHeaderStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="GeistSemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TypoNeutralsSecondaryLight}" />
                <Setter Property="Margin" Value="0,24,0,8" />
            </Style>

            <!-- Permission row template -->
            <DataTemplate x:Key="PermissionRowTemplate" x:DataType="vm:PermissionStatusItem">
                <VerticalStackLayout>
                    <!-- Divider -->
                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource FillNeutralsOutlineAndDividersLight}" />

                    <Grid
                        Padding="16,14"
                        ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{Binding Name}"
                            Style="{StaticResource InfoLabelStyle}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding Status}"
                            Style="{StaticResource InfoValueStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="20,0,20,24"
            Spacing="0">

            <!-- ===== Top Navigation Bar ===== -->
            <Grid
                Padding="0,12,0,8"
                ColumnDefinitions="Auto,*,Auto">

                <!-- Back Button -->
                <HorizontalStackLayout
                    Grid.Column="0"
                    Spacing="4"
                    VerticalOptions="Center">
                    <Label
                        Text="‹"
                        FontFamily="GeistRegular"
                        FontSize="24"
                        TextColor="{StaticResource TypoNeutralsPrimaryLight}"
                        VerticalOptions="Center" />
                    <Label
                        Text="Back"
                        FontFamily="GeistRegular"
                        FontSize="16"
                        TextColor="{StaticResource TypoNeutralsPrimaryLight}"
                        VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>

                <!-- Title -->
                <Label
                    Grid.Column="1"
                    Text="RescuAR"
                    FontFamily="GeistSemiBold"
                    FontSize="16"
                    TextColor="{StaticResource TypoNeutralsPrimaryLight}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <!-- Notification Bell -->
                <Label
                    Grid.Column="2"
                    Text="🔔"
                    FontSize="18"
                    VerticalOptions="Center"
                    HorizontalOptions="End" />
            </Grid>

            <!-- ===== Header ===== -->
            <VerticalStackLayout
                Spacing="4"
                Margin="0,8,0,20">

                <Label
                    Text="Profile/"
                    FontFamily="GeistRegular"
                    FontSize="13"
                    TextColor="{StaticResource TypoNeutralsSecondaryLight}" />

                <Label
                    Text="System Information"
                    FontFamily="GeistBold"
                    FontSize="28"
                    TextColor="{StaticResource TypoNeutralsPrimaryLight}" />
            </VerticalStackLayout>

            <!-- ===== App Version Row ===== -->
            <Border
                StrokeShape="RoundRectangle 12"
                Stroke="{StaticResource FillNeutralsOutlineAndDividersLight}"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="16,14"
                Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="App version"
                        Style="{StaticResource InfoLabelStyle}" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding AppVersion}"
                        Style="{StaticResource InfoValueStyle}" />
                </Grid>
            </Border>

            <!-- ===== Last Updated Row ===== -->
            <Border
                StrokeShape="RoundRectangle 12"
                Stroke="{StaticResource FillNeutralsOutlineAndDividersLight}"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="16,14">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="Last updated"
                        Style="{StaticResource InfoLabelStyle}" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding LastUpdated}"
                        Style="{StaticResource InfoValueStyle}" />
                </Grid>
            </Border>

            <!-- ===== Permissions Section ===== -->
            <Label
                Text="Permissions"
                Style="{StaticResource SysInfoSectionHeaderStyle}" />

            <Border
                StrokeShape="RoundRectangle 12"
                Stroke="{StaticResource FillNeutralsOutlineAndDividersLight}"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="0">

                <VerticalStackLayout Spacing="0">
                    <!-- First permission row (no top divider) -->
                    <Grid
                        Padding="16,14"
                        ColumnDefinitions="*,Auto"
                        IsVisible="False" />

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Permissions}"
                        BindableLayout.ItemTemplate="{StaticResource PermissionRowTemplate}"
                        Spacing="0" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== Manage Permissions Link ===== -->
            <HorizontalStackLayout
                Spacing="4"
                Margin="0,16,0,0">
                <Label
                    Text="Manage permissions"
                    FontFamily="GeistSemiBold"
                    FontSize="14"
                    TextColor="{StaticResource RescuARFillBtnPrimaryDefaultLight}" />
                <Label
                    Text="›"
                    FontFamily="GeistRegular"
                    FontSize="18"
                    TextColor="{StaticResource RescuARFillBtnPrimaryDefaultLight}"
                    VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ManagePermissionsCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>

            <!-- Bottom spacing -->
            <BoxView HeightRequest="24" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>