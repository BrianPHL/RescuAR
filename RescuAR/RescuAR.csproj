<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<Nullable>enable</Nullable>

		<GenerateEvergineContent>True</GenerateEvergineContent>
		<GenerateEvergineAssets>False</GenerateEvergineAssets>
		<GenerateEvergineScenesCode>True</GenerateEvergineScenesCode>
	</PropertyGroup>

	<!-- The exporter excludes compiled scenes from the packaged assets. Their
	     generated factories are therefore required even in a fast local build. -->
	<Target Name="ValidateEvergineStartupSceneGeneration" BeforeTargets="CoreCompile"
	        Condition="'$(DesignTimeBuild)' != 'true'">
		<Error Condition="'$(GenerateEvergineScenesCode)' != 'true'"
		       Text="RescuAR requires GenerateEvergineScenesCode=true: startup scenes are compiled into the assembly and excluded from exported assets. Disabling scene generation produces a black AR camera." />
	</Target>

	<ItemGroup>
		<PackageReference Include="Evergine.Common" Version="2025.10.21.3204" />
		<PackageReference Include="Evergine.Components" Version="2025.10.21.3204" />
		<PackageReference Include="Evergine.Framework" Version="2025.10.21.3204" />
		<PackageReference Include="Evergine.Mathematics" Version="2025.10.21.3204" />
		<PackageReference Include="Evergine.Bullet" Version="2025.10.21.3204" />
		<PackageReference Include="Evergine.Targets" Version="2025.10.21.3204" />
		<PackageReference Include="Evergine.CodeScenes" Version="2025.10.21.3204" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Navigation\Data\evacuation-policy.json" />
		<EmbeddedResource Include="Navigation\Data\Resources\*ROADS.geojson;Navigation\Data\Resources\*POINTS.geojson" />
		<EmbeddedResource Include="Navigation\Data\Resources\routing-manifest.json" Condition="Exists('Navigation\Data\Resources\routing-manifest.json')" />
	</ItemGroup>

</Project>
