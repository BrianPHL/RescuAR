+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import { createSystemAuditService, SYSTEM_AUDIT_PAGE_SIZE } from '../src/services/systemAuditService.js';
+
+const read = (file) => fs.readFileSync(new URL(`../${file}`, import.meta.url), 'utf8');
+
+test('viewer never renders synthetic audit records', () => {
+  const src = read('src/components/SystemLogs.jsx');
+  assert.doesNotMatch(src, /TelemetryProcessor\] Received reading|8f7a9d|Brian Pasco/);
+  assert.match(src, /Loading actual audit records/);
+  const legacy = read('src/components/AuditLogs.jsx');
+  assert.match(legacy, /SystemLogs/);
+});
+
+test('audit service paginates and requests backend filters', async () => {
+  let args;
+  const s = createSystemAuditService({ rpc: async (name, values) => { args = [name, values]; return { data: Array.from({ length: 26 }, (_, i) => ({ id: 50 - i, event_type: 'advisory.created', recorded_at: new Date().toISOString() })) }; } });
+  const page = await s.list({ module: 'content-advisories', beforeId: 123 });
+  assert.equal(args[0], 'web_admin_audit_list');
+  assert.equal(args[1].p_limit, SYSTEM_AUDIT_PAGE_SIZE + 1);
+  assert.equal(args[1].p_before_id, 123);
+  assert.equal(page.rows.length, SYSTEM_AUDIT_PAGE_SIZE);
+  assert.equal(page.hasMore, true);
+  assert.equal(page.nextId, 26);
+});
+
+test('audit service rejects invalid actor filter and denied results', async () => {
+  const s = createSystemAuditService({ rpc: async () => ({ error: { code: '42501', message: 'Forbidden' } }) });
+  await assert.rejects(() => s.list({ actorId: 'not-a-uuid' }), /valid administrator UUID/);
+  await assert.rejects(() => s.list(), /Access denied/);
+});
+
+test('migration restricts audit read RPC and direct DML', () => {
+  const sql = read('database/migrations/009_web_admin_audit_foundation.sql');
+  assert.match(sql, /REVOKE ALL ON public\.web_admin_audit_events FROM PUBLIC, anon, authenticated/);
+  assert.match(sql, /auth\.uid\(\) IS NULL OR NOT public\.rbac_can\('system\.all'\)/);
+  assert.match(sql, /AFTER INSERT OR UPDATE OR DELETE ON public\.advisories/);
+  assert.match(sql, /AFTER INSERT ON public\.rbac_audit_log/);
+  assert.doesNotMatch(sql, /GRANT INSERT ON public\.web_admin_audit_events TO authenticated/);
+  assert.doesNotMatch(sql, /CREATE OR REPLACE FUNCTION public\.record_web_audit_event/);
+});
