# Copy to RescuAR.Admin/.env for a new local setup and replace every placeholder.
# Only public frontend settings may use VITE_. Restart/rebuild Vite after edits.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_OR_PUBLISHABLE_KEY
VITE_PREP_EXPOSURE_API_URL=http://localhost:8000

# Worker only. scraper/syncWorker.js loads this parent .env locally.
# Set these only if running the worker; never prefix the service key with VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
