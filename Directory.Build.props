<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<!-- The property AdditionalDefineConstants is used by Evergine Editor to add 'EVERGINE_EDITOR' build constant. -->
		<DefineConstants Condition="'$(AdditionalDefineConstants)' != ''">$(DefineConstants);$(AdditionalDefineConstants)</DefineConstants>
		<!--
			Production is the default. Diagnostic behavior must be requested
			explicitly with /p:RescuArDiagnosticBuild=true.
		-->
		<RescuArDiagnosticBuild Condition="'$(RescuArDiagnosticBuild)' == ''">false</RescuArDiagnosticBuild>
		<DefineConstants Condition="'$(RescuArDiagnosticBuild)' == 'true'">$(DefineConstants);RESCUAR_DIAGNOSTICS</DefineConstants>
	</PropertyGroup>
</Project>
