<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>RescuAR.MAUI</RootNamespace>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!--
			Migration constraint: the current Evergine integration is pinned to
			net9.0-android. Suppress the SDK end-of-support diagnostic until the
			engine stack is validated on a newer target framework.
		-->
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<CheckEolWorkloads>false</CheckEolWorkloads>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>RescuAR.MAUI</ApplicationTitle>

		<!-- App identifier -->
		<ApplicationId>com.rescuar.app</ApplicationId>
		<ApplicationIdGuid>d62842df-e7e1-4c24-a05d-dea1969b1bd2</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 8.0 / API 26 minimum -->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

		<!-- Required by Vulkan and native interop code -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>

		<!-- Android ABI targets -->
		<RuntimeIdentifier>android-arm64</RuntimeIdentifier>

		<!--
			Validated AR compatibility profile. Change one layer at a time and
			update the compatibility evidence before modifying these pins.
		-->
		<MauiVersion>9.0.120</MauiVersion>
		<EvergineVersion>2025.10.21.3204</EvergineVersion>
		<EvergineLibBulletcVersion>2025.8.29.27</EvergineLibBulletcVersion>
		<ArCoreBindingVersion>1.47.1</ArCoreBindingVersion>
		<RescuArCompatibilityProfile>net9-maui9.0.120-evergine2025.10-arcore1.47.1</RescuArCompatibilityProfile>
	</PropertyGroup>

	<!--
		Native Android build-tool paths.

		Update these version folders only when your installed NDK or CMake
		version changes.
	-->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
		<NativeBridgeAbi>arm64-v8a</NativeBridgeAbi>
		<NativeBridgeFileName>libnative_bridge.so</NativeBridgeFileName>
		<NativeBridgeNdkVersion>28.2.13676358</NativeBridgeNdkVersion>
		<NativeBridgeCMakeVersion>3.22.1</NativeBridgeCMakeVersion>
		<NativeBridgeAndroidApi>26</NativeBridgeAndroidApi>
		<RescuArCorrectiveBatch>ARCore-09</RescuArCorrectiveBatch>
		<RescuArSourceRevision Condition="'$(RescuArSourceRevision)' == '' and '$(SourceRevisionId)' != ''">$(SourceRevisionId)</RescuArSourceRevision>
		<RescuArSourceRevision Condition="'$(RescuArSourceRevision)' == ''">unavailable</RescuArSourceRevision>

		<!--
			A verified ARM64 bridge is checked into Platforms\Android\lib.
			Keep native compilation opt-in so normal MAUI builds do not require
			a machine-specific NDK/CMake installation. CI always rebuilds it from
			the pinned source/toolchain before packaging.
		-->
		<BuildNativeBridgeOnBuild Condition="'$(BuildNativeBridgeOnBuild)' == '' and '$(ContinuousIntegrationBuild)' == 'true'">true</BuildNativeBridgeOnBuild>
		<BuildNativeBridgeOnBuild Condition="'$(BuildNativeBridgeOnBuild)' == ''">false</BuildNativeBridgeOnBuild>
		<VerifyPackagedNativeBridge Condition="'$(VerifyPackagedNativeBridge)' == '' and '$(ContinuousIntegrationBuild)' == 'true'">true</VerifyPackagedNativeBridge>
		<VerifyPackagedNativeBridge Condition="'$(VerifyPackagedNativeBridge)' == ''">false</VerifyPackagedNativeBridge>

		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(ANDROID_SDK_ROOT)' != ''">$(ANDROID_SDK_ROOT)</AndroidSdkDirectory>
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(ANDROID_HOME)' != ''">$(ANDROID_HOME)</AndroidSdkDirectory>
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == ''">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>

		<AndroidNdkDirectory Condition="'$(AndroidNdkDirectory)' == ''">$(AndroidSdkDirectory)\ndk\$(NativeBridgeNdkVersion)</AndroidNdkDirectory>
		<AndroidCMakeDirectory Condition="'$(AndroidCMakeDirectory)' == ''">$(AndroidSdkDirectory)\cmake\$(NativeBridgeCMakeVersion)</AndroidCMakeDirectory>

		<CMakeExecutable>$(AndroidCMakeDirectory)\bin\cmake.exe</CMakeExecutable>
		<NinjaExecutable>$(AndroidCMakeDirectory)\bin\ninja.exe</NinjaExecutable>

		<AndroidCMakeToolchain>$(AndroidNdkDirectory)\build\cmake\android.toolchain.cmake</AndroidCMakeToolchain>
		<NativeBridgeReadElf>$(AndroidNdkDirectory)\toolchains\llvm\prebuilt\windows-x86_64\bin\llvm-readelf.exe</NativeBridgeReadElf>

		<NativeFolder>$(MSBuildProjectDirectory)\Platforms\Android\Native</NativeFolder>
		<NativeBuildFolder>$(NativeFolder)\build</NativeBuildFolder>

		<NativeLibraryFolder>$(MSBuildProjectDirectory)\Platforms\Android\lib</NativeLibraryFolder>
		<NativeBridgePath>$(NativeLibraryFolder)\$(NativeBridgeAbi)\$(NativeBridgeFileName)</NativeBridgePath>
		<NativeBridgeVerifier>$(MSBuildProjectDirectory)\..\build\Verify-AndroidNativeBridge.ps1</NativeBridgeVerifier>
	</PropertyGroup>

	<!-- MAUI resources -->
	<ItemGroup>
		<!-- App icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" BaseSize="168,208" />

		<!-- Custom fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- MAUI packages -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Mapsui.Maui" Version="5.1.0" />
		<PackageReference Include="Mapsui.Nts" Version="5.1.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
		<PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Supabase" Version="1.1.1" />
	</ItemGroup>

	<!-- Evergine application project -->
	<ItemGroup>
		<ProjectReference Include="..\RescuAR\RescuAR.csproj" />
	</ItemGroup>

	<!--
		Register the generated native shared libraries for Android packaging.

		The checked-in ARM64 library is packaged by default. Native source is
		rebuilt first only when BuildNativeBridgeOnBuild=true is supplied.
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
		<AndroidNativeLibrary Include="$(NativeBridgePath)" Abi="$(NativeBridgeAbi)" />
		<AssemblyMetadata Include="RescuAR.CorrectiveBatch" Value="$(RescuArCorrectiveBatch)" />
		<AssemblyMetadata Include="RescuAR.SourceRevision" Value="$(RescuArSourceRevision)" />
		<AssemblyMetadata Include="RescuAR.DiagnosticBuild" Value="$(RescuArDiagnosticBuild)" />
		<AssemblyMetadata Include="RescuAR.DiagnosticRouteOverride" Value="$(RescuArDiagnosticBuild)" />
		<AssemblyMetadata Include="RescuAR.LocationLogPolicy" Value="production-redacted;diagnostic-consent-quantized" />
		<AssemblyMetadata Include="RescuAR.LocationLogRetentionDays" Value="30" />
		<AssemblyMetadata Include="RescuAR.StateGlossary" Value="AR_STATE_GLOSSARY_V1" />
		<AssemblyMetadata Include="RescuAR.ArSupportPolicy" Value="required" />
		<AssemblyMetadata Include="RescuAR.RequiredAbi" Value="$(NativeBridgeAbi)" />
		<AssemblyMetadata Include="RescuAR.AndroidMinApi" Value="$(NativeBridgeAndroidApi)" />
		<AssemblyMetadata Include="RescuAR.VulkanRequirement" Value="vulkan-1.0-level-0" />
		<AssemblyMetadata Include="RescuAR.CompatibilityProfile" Value="$(RescuArCompatibilityProfile)" />
		<AssemblyMetadata Include="RescuAR.MauiVersion" Value="$(MauiVersion)" />
		<AssemblyMetadata Include="RescuAR.EvergineVersion" Value="$(EvergineVersion)" />
		<AssemblyMetadata Include="RescuAR.ArCoreBindingVersion" Value="$(ArCoreBindingVersion)" />
		<AssemblyMetadata Include="RescuAR.NdkVersion" Value="$(NativeBridgeNdkVersion)" />
		<AssemblyMetadata Include="RescuAR.CMakeVersion" Value="$(NativeBridgeCMakeVersion)" />
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="Views\Camera\CameraPage.Diagnostics.cs" />
		<Compile Include="Views\Camera\CameraPage.Diagnostics.cs" Condition="'$(RescuArDiagnosticBuild)' == 'true'" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Platforms\Android\Vulkan\Shaders\" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
		<EmbeddedResource Include="Platforms\Android\Vulkan\Shaders\CameraFullscreen.vert.spv" />
		<EmbeddedResource Include="Platforms\Android\Vulkan\Shaders\CameraExternal.frag.spv" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Resources\Styles\RescuARColors.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Reports\CommunityPostingPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<!--
		Entry point for native bridge preparation.

		This target runs before Android begins preparing build inputs.
		It executes BuildNativeBridge first, followed by CopyNativeBridge.
	-->
	<Target Name="ValidateArCoreCompatibilityProfile" BeforeTargets="PrepareForBuild">
		<Error Condition="'$(TargetFramework)' != 'net9.0-android'" Text="The validated AR compatibility profile requires TargetFramework=net9.0-android. Validate a controlled compatibility candidate before changing it." />
		<Error Condition="'$(MauiVersion)' != '9.0.120'" Text="The validated AR compatibility profile requires Microsoft.Maui.Controls 9.0.120." />
		<Error Condition="'$(EvergineVersion)' != '2025.10.21.3204'" Text="The validated AR compatibility profile requires Evergine 2025.10.21.3204." />
		<Error Condition="'$(EvergineLibBulletcVersion)' != '2025.8.29.27'" Text="The validated AR compatibility profile requires Evergine.LibBulletc.Natives 2025.8.29.27." />
		<Error Condition="'$(ArCoreBindingVersion)' != '1.47.1'" Text="The validated AR compatibility profile requires Vapolia.Google.ARCore 1.47.1." />
	</Target>

	<Target Name="ValidateNativeBridgeInput" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)' == 'net9.0-android'">
		<Error Condition="'$(RuntimeIdentifier)' != 'android-arm64'" Text="The current native camera bridge supports only RuntimeIdentifier=android-arm64." />
		<Error Condition="!Exists('$(NativeBridgePath)') and '$(BuildNativeBridgeOnBuild)' != 'true'" Text="The required ARM64 native bridge is missing: $(NativeBridgePath). Rebuild with BuildNativeBridgeOnBuild=true." />
	</Target>

	<Target Name="PrepareNativeBridge" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildNativeBridge;CopyNativeBridge" Condition="'$(TargetFramework)' == 'net9.0-android' and '$(BuildNativeBridgeOnBuild)' == 'true'" />

	<!-- Build libnative_bridge.so for every supported ABI -->
	<Target Name="BuildNativeBridge" Condition="'$(TargetFramework)' == 'net9.0-android' and '$(BuildNativeBridgeOnBuild)' == 'true'">

		<Message Text="Preparing ARM64 Android native bridge..." Importance="high" />

		<Error Condition="!Exists('$(NativeFolder)\CMakeLists.txt')" Text="CMakeLists.txt was not found: $(NativeFolder)\CMakeLists.txt" />

		<Error Condition="!Exists('$(NativeFolder)\native_bridge.cpp')" Text="native_bridge.cpp was not found: $(NativeFolder)\native_bridge.cpp" />

		<Error Condition="!Exists('$(AndroidCMakeToolchain)')" Text="Android CMake toolchain was not found: $(AndroidCMakeToolchain)" />

		<Error Condition="!Exists('$(CMakeExecutable)')" Text="CMake executable was not found: $(CMakeExecutable)" />

		<Error Condition="!Exists('$(NinjaExecutable)')" Text="Ninja executable was not found: $(NinjaExecutable)" />

		<Message Text="Configuring native bridge for arm64-v8a..." Importance="high" />

		<Exec Command="&quot;$(CMakeExecutable)&quot; -S &quot;$(NativeFolder)&quot; -B &quot;$(NativeBuildFolder)\$(NativeBridgeAbi)&quot; -G Ninja -DCMAKE_MAKE_PROGRAM=&quot;$(NinjaExecutable)&quot; -DCMAKE_TOOLCHAIN_FILE=&quot;$(AndroidCMakeToolchain)&quot; -DANDROID_ABI=$(NativeBridgeAbi) -DANDROID_PLATFORM=android-$(NativeBridgeAndroidApi) -DCMAKE_BUILD_TYPE=Release" />

		<Message Text="Building native bridge for arm64-v8a..." Importance="high" />

		<Exec Command="&quot;$(CMakeExecutable)&quot; --build &quot;$(NativeBuildFolder)\$(NativeBridgeAbi)&quot;" />
	</Target>

	<!-- Copy generated libraries into the Android native-library folders -->
	<Target Name="CopyNativeBridge" Condition="'$(TargetFramework)' == 'net9.0-android' and '$(BuildNativeBridgeOnBuild)' == 'true'">

		<Error Condition="!Exists('$(NativeBuildFolder)\$(NativeBridgeAbi)\$(NativeBridgeFileName)')" Text="The ARM64 native bridge was not generated: $(NativeBuildFolder)\$(NativeBridgeAbi)\$(NativeBridgeFileName)" />

		<MakeDir Directories="$(NativeLibraryFolder)\$(NativeBridgeAbi)" />

		<Copy SourceFiles="$(NativeBuildFolder)\$(NativeBridgeAbi)\$(NativeBridgeFileName)" DestinationFolder="$(NativeLibraryFolder)\$(NativeBridgeAbi)" SkipUnchangedFiles="true" />

		<Message Text="ARM64 native bridge copied successfully." Importance="high" />
	</Target>

	<Target Name="VerifyPackagedNativeBridgeArtifact" AfterTargets="Publish" Condition="'$(TargetFramework)' == 'net9.0-android' and '$(VerifyPackagedNativeBridge)' == 'true' and '$(OS)' == 'Windows_NT'">
		<ItemGroup>
			<_RescuArAndroidArtifact Include="$(PublishDir)*.apk" />
			<_RescuArAndroidArtifact Include="$(PublishDir)*.aab" />
		</ItemGroup>
		<Error Condition="!Exists('$(NativeBridgeVerifier)')" Text="Native bridge artifact verifier was not found: $(NativeBridgeVerifier)" />
		<Error Condition="'@(_RescuArAndroidArtifact)' == ''" Text="No APK or AAB was produced under $(PublishDir); native bridge packaging cannot be verified." />
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(NativeBridgeVerifier)&quot; -ArtifactPath &quot;%(_RescuArAndroidArtifact.FullPath)&quot; -ExpectedAbi &quot;$(NativeBridgeAbi)&quot; -ReadElfPath &quot;$(NativeBridgeReadElf)&quot; -RequireStripped -ProvenanceOutput &quot;%(_RescuArAndroidArtifact.RootDir)%(_RescuArAndroidArtifact.Directory)%(_RescuArAndroidArtifact.Filename)-native-provenance.json&quot;" />
	</Target>

	<!-- Evergine Android configuration -->
	<Choose>
		<When Condition="'$(TargetFramework)' == 'net9.0-android'">

			<PropertyGroup>
				<EvergineProfileName>#MAUI#Android</EvergineProfileName>
			</PropertyGroup>

			<ItemGroup>
				<PackageReference Include="Evergine.Android" Version="$(EvergineVersion)" />

				<PackageReference Include="Evergine.LibBulletc.Natives" Version="$(EvergineLibBulletcVersion)" />

				<PackageReference Include="Evergine.OpenAL" Version="$(EvergineVersion)" />

				<PackageReference Include="Evergine.Targets" Version="$(EvergineVersion)" />

				<PackageReference Include="Evergine.Targets.Maui" Version="$(EvergineVersion)" />

				<PackageReference Include="Evergine.Vulkan" Version="$(EvergineVersion)" />

				<PackageReference Include="Vapolia.Google.ARCore" Version="$(ArCoreBindingVersion)" />
			</ItemGroup>

			<ItemGroup>
				<TrimmerRootDescriptor Include="Platforms\Android\linker.xml" />
			</ItemGroup>

		</When>
	</Choose>

</Project>
