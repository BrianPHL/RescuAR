<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RescuAR.App.Views.Dashboard"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    xmlns:models="clr-namespace:RescuAR.App.Models"
    x:Class="RescuAR.App.Views.Dashboard.AdvisoryFeedPage"
    x:Name="DashboardAdvisoryPageRoot"
    x:DataType="vm:AdvisoryFeedViewModel"
    Title="Updates"
    BackgroundColor="#F8FAFC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Top Custom Header Bar with Back Button and Title Banner (RescuAR Teal Brand Palette #0A8491) -->
        <Border Grid.Row="0"
                BackgroundColor="#0A8491"
                StrokeThickness="0"
                Padding="16,11">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Back Button Pill with Professional Triangle Back Arrow (same as Community Reports) -->
                <Border Grid.Column="0"
                        BackgroundColor="#065F69"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                          Fill="#FFFFFF"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Title Banner -->
                <Label Grid.Column="1"
                       Text="Disaster Updates"
                       TextColor="#FFFFFF"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />

                <!-- Notification Bell Pill (Self-contained, NO shadow, badge inside, never overlaps) -->
                <Grid Grid.Column="2" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Border BackgroundColor="#065F69"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="36"
                            HeightRequest="36"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                        </Border.GestureRecognizers>
                        <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                              Fill="#FFFFFF"
                              WidthRequest="18"
                              HeightRequest="18"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>
                    <!-- Notification Badge -->
                    <Border BackgroundColor="#EF4444"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 7"
                            WidthRequest="15"
                            HeightRequest="15"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,1,1,0"
                            InputTransparent="True">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding UnreadNotificationsCount}" Value="0">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding UnreadNotificationsCount}"
                               TextColor="#FFFFFF"
                               FontSize="8"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Scrollable Body Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="16,16,16,32">

                <!-- Title & Breadcrumbs Section -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Home / Updates" TextColor="#64748B" FontSize="13" FontAttributes="Bold" />
                    <Label Text="Disaster Updates" TextColor="#0F172A" FontSize="26" FontAttributes="Bold" />
                    <Label Text="Official disaster alerts and verified agency advisories." TextColor="#475569" FontSize="14" />
                </VerticalStackLayout>

                <!-- Active Monitoring Hero Card (Unified Teal Brand Palette #0A8491) -->
                <Border StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        BackgroundColor="#0A8491"
                        Padding="18">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#065F69"
                                    Padding="10,5"
                                    HorizontalOptions="Start"
                                    StrokeThickness="0">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="#4ADE80" VerticalOptions="Center" />
                                    <Label Text="Active Monitoring" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Label Text="Within 5 km of your location." TextColor="#FFFFFF" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding LastUpdatedText}" TextColor="#E0F2FE" FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Signal Waves Icon -->
                        <Path Grid.Column="1"
                              Data="M12,11A1,1 0 0,0 11,12A1,1 0 0,0 12,13A1,1 0 0,0 13,12A1,1 0 0,0 12,11M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A9,9 0 0,0 21,12A9,9 0 0,0 12,3Z"
                              Fill="#CCFBF1"
                              WidthRequest="44"
                              HeightRequest="44"
                              Aspect="Uniform"
                              VerticalOptions="Center"
                              HorizontalOptions="End" />
                    </Grid>
                </Border>

                <!-- Categories Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Categories" TextColor="#64748B" FontSize="13" FontAttributes="Bold" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CategoryChips}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryChipItem">
                                    <Border StrokeShape="RoundRectangle 12"
                                            StrokeThickness="1"
                                            Stroke="{Binding BorderColor}"
                                            BackgroundColor="{Binding BgColor}"
                                            Padding="16,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={x:Reference DashboardAdvisoryPageRoot}, Path=ViewModel.SelectCategoryCommand, x:DataType=local:AdvisoryFeedPage}"
                                                CommandParameter="{Binding Name}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}" TextColor="{Binding TextColor}" FontSize="13" FontAttributes="Bold" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Status Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Status" TextColor="#64748B" FontSize="13" FontAttributes="Bold" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding StatusChips}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryChipItem">
                                    <Border StrokeShape="RoundRectangle 12"
                                            StrokeThickness="1"
                                            Stroke="{Binding BorderColor}"
                                            BackgroundColor="{Binding BgColor}"
                                            Padding="16,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={x:Reference DashboardAdvisoryPageRoot}, Path=ViewModel.SelectStatusCommand, x:DataType=local:AdvisoryFeedPage}"
                                                CommandParameter="{Binding Name}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}" TextColor="{Binding TextColor}" FontSize="13" FontAttributes="Bold" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Advisory Feed List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DisplayedAdvisories}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:DisasterAdvisory">
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1"
                                    Stroke="#E2E8F0"
                                    BackgroundColor="#FFFFFF"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.04" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="12">
                                    <!-- Badges Pill Row -->
                                    <HorizontalStackLayout Spacing="6">
                                        <!-- Severity Pill -->
                                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="{Binding AlertBadgeBg}" Padding="10,4" StrokeThickness="0">
                                            <Label Text="{Binding Severity}" TextColor="{Binding AlertBadgeText}" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <!-- Category Pill -->
                                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" Padding="10,4">
                                            <Label Text="{Binding Category}" TextColor="#0F172A" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <!-- Type Tag Pill -->
                                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" Padding="10,4">
                                            <Label Text="Advisory" TextColor="#0F172A" FontSize="11" />
                                        </Border>
                                        <!-- Status Pill -->
                                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#DCFCE7" Padding="10,4" StrokeThickness="0">
                                            <Label Text="Active" TextColor="#166534" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Main Title -->
                                    <Label Text="{Binding Title}" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" LineBreakMode="WordWrap" />

                                    <!-- Description (if present) -->
                                    <Label Text="{Binding DisplayMessage}"
                                           TextColor="#475569"
                                           FontSize="13"
                                           LineBreakMode="WordWrap" />

                                    <!-- Key-Value Details Grid -->
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="6">
                                        <Label Grid.Row="0" Grid.Column="0" Text="Affected Area" TextColor="#64748B" FontSize="13" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding AffectedArea}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" />

                                        <Label Grid.Row="1" Grid.Column="0" Text="Issued by" TextColor="#64748B" FontSize="13" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="Not provided" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" />

                                        <Label Grid.Row="2" Grid.Column="0" Text="Issued at" TextColor="#64748B" FontSize="13" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding CreatedAtText}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" />
                                    </Grid>

                                    <!-- View Details Action Link -->
                                    <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={x:Reference DashboardAdvisoryPageRoot}, Path=ViewModel.ViewDetailsCommand, x:DataType=local:AdvisoryFeedPage}"
                                                CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label Text="View details  ❯" TextColor="#0A8491" FontSize="14" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Footer note -->
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,8,0,16">
                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="#15803D" VerticalOptions="Center" />
                    <Label Text="Alerts are updating in real time." TextColor="#64748B" FontSize="12" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
