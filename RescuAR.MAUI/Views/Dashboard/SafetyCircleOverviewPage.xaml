<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.SafetyCircleOverviewPage"
    x:DataType="vm:SafetyCircleOverviewViewModel">

    <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            Stroke="#E5E5EA"
            BackgroundColor="#FFFFFF"
            Padding="14"
            HeightRequest="150"
            VerticalOptions="Fill">

        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding NavigateToSafetyCircleCommand}" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="*,Auto" RowSpacing="8">
            <!-- Circles List -->
            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <!-- Mini Item 1 -->
                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#F0F0F2" BackgroundColor="#FAF9F6" Padding="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="{Binding Circle1Name}" TextColor="#000000" FontSize="11" FontAttributes="Bold" />
                            <Label Text="{Binding Circle1Status}" TextColor="#7F7F7F" FontSize="10" />
                        </VerticalStackLayout>
                        <!-- Warning Icon Vector -->
                        <Path Grid.Column="1" Data="M12,2L1,21H23L12,2M12,6L19.8,20H4.2L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z" Fill="#D97706" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Mini Item 2 -->
                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#F0F0F2" BackgroundColor="#FAF9F6" Padding="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="{Binding Circle2Name}" TextColor="#000000" FontSize="11" FontAttributes="Bold" />
                            <Label Text="{Binding Circle2Status}" TextColor="#7F7F7F" FontSize="10" />
                        </VerticalStackLayout>
                        <!-- Check Circle Vector -->
                        <Path Grid.Column="1" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z" Fill="#28A745" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Footer Link -->
            <HorizontalStackLayout Grid.Row="1" Spacing="4" VerticalOptions="End">
                <Label Text="{Binding ActionText}"
                       TextColor="#0A8491"
                       FontSize="13"
                       FontAttributes="Bold" />
                <Path Data="M6.4,18L5,16.6L14.6,7H7V5H18V16H16V8.4L6.4,18Z"
                      Fill="#0A8491"
                      WidthRequest="12"
                      HeightRequest="12"
                      Aspect="Uniform"
                      VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
