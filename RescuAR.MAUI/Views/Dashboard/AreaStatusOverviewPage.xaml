<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.AreaStatusOverviewPage"
    x:DataType="vm:AreaStatusOverviewViewModel">

    <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="0"
            BackgroundColor="{Binding BackgroundColor}"
            Padding="20"
            Margin="0,0,0,4">
        
        <Border.GestureRecognizers>
            <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding CycleRiskLevelCommand}" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="14">
            <!-- Header -->
            <Label Text="{Binding RiskTitle}"
                   TextColor="{Binding TextColor}"
                   FontSize="22"
                   FontAttributes="Bold" />

            <!-- Subtitle -->
            <Label Text="{Binding AdvisoriesText}"
                   TextColor="{Binding SubtitleColor}"
                   FontSize="13"
                   LineBreakMode="WordWrap" />

            <!-- Divider Line -->
            <BoxView HeightRequest="1" Color="{Binding SubtitleColor}" Opacity="0.15" Margin="0,4" />

            <!-- Details Stack -->
            <VerticalStackLayout Spacing="10">
                <!-- Nearest Center -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="Nearest Evacuation Center"
                           TextColor="{Binding LabelColor}"
                           FontSize="12"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding NearestCenterName}"
                           TextColor="{Binding LinkColor}"
                           FontAttributes="Bold"
                           FontSize="12"
                           HorizontalOptions="End"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                </Grid>

                <!-- Recommended Action -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="Recommended Action"
                           TextColor="{Binding LabelColor}"
                           FontSize="12"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding RecommendedAction}"
                           TextColor="{Binding TextColor}"
                           FontAttributes="Bold"
                           FontSize="12"
                           HorizontalOptions="End"
                           LineBreakMode="WordWrap" />
                </Grid>

                <!-- Updated time -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="Updated at"
                           TextColor="{Binding LabelColor}"
                           FontSize="12"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding UpdatedText}"
                           TextColor="{Binding LabelColor}"
                           FontSize="12"
                           HorizontalOptions="End"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Divider Line -->
            <BoxView HeightRequest="1" Color="{Binding SubtitleColor}" Opacity="0.15" Margin="0,4" />

            <!-- Footer Link -->
            <HorizontalStackLayout Spacing="4" VerticalOptions="End">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewEmergencySummaryCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="View emergency summary"
                       TextColor="{Binding LinkColor}"
                       FontAttributes="Bold"
                       FontSize="13" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
