<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.PASSOverviewPage"
    x:DataType="vm:PASSOverviewViewModel">

    <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="0"
            BackgroundColor="#D0E8F2"
            Padding="20">

        <VerticalStackLayout Spacing="12">
            <!-- Section Title -->
            <Label Text="{Binding Title}"
                   TextColor="#0070C0"
                   FontSize="13"
                   FontAttributes="Bold" />

            <!-- Assessment Score -->
            <Label Text="{Binding ScoreText}"
                   TextColor="#005691"
                   FontSize="28"
                   FontAttributes="Bold" />

            <!-- Description -->
            <Label Text="{Binding Description}"
                   TextColor="#005691"
                   FontSize="13"
                   LineBreakMode="WordWrap" />

            <!-- Take Assessment Action Button -->
            <Border StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    BackgroundColor="#0A8491"
                    Padding="12,14"
                    Margin="0,6,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TakeAssessmentCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <!-- Clipboard Icon vector -->
                    <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M12,3C12.55,3 13,3.45 13,4C13,4.55 12.55,5 12,5C11.45,5 11,4.55 11,4C11,3.45 11.45,3 12,3M19,19H5V5H7V7H17V5H19V19Z"
                          Fill="#FFFFFF"
                          WidthRequest="18"
                          HeightRequest="18"
                          Aspect="Uniform"
                          VerticalOptions="Center" />
                    <Label Text="{Binding ButtonText}"
                           TextColor="#FFFFFF"
                           FontSize="15"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Border>
</ContentView>
