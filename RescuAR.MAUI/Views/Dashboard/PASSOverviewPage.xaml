<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.PASSOverviewPage"
    x:DataType="vm:PASSOverviewViewModel">

    <Border StrokeShape="RoundRectangle 20"
            StrokeThickness="1"
            Stroke="#BAE6FD"
            BackgroundColor="#E0F2FE"
            Padding="14"
            HeightRequest="175">

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
            <!-- Header Row: Title & Big Score Badge -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding Title}"
                           TextColor="#0284C7"
                           FontSize="11"
                           FontAttributes="Bold" />
                    <Label Text="{Binding ScoreText}"
                           TextColor="#0369A1"
                           FontSize="22"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>

            <!-- Description Row -->
            <Label Grid.Row="1"
                   Text="{Binding Description}"
                   TextColor="#0369A1"
                   FontSize="11"
                   LineBreakMode="WordWrap"
                   MaxLines="2"
                   VerticalOptions="Center" />

            <!-- Take Assessment Action Button (Compact) -->
            <Border Grid.Row="2"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="#007E8A"
                    Padding="12,8"
                    HorizontalOptions="Fill">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TakeAssessmentCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M12,3C12.55,3 13,3.45 13,4C13,4.55 12.55,5 12,5C11.45,5 11,4.55 11,4C11,3.45 11.45,3 12,3M19,19H5V5H7V7H17V5H19V19Z"
                          Fill="#FFFFFF"
                          WidthRequest="14"
                          HeightRequest="14"
                          Aspect="Uniform"
                          VerticalOptions="Center" />
                    <Label Text="{Binding ButtonText}"
                           TextColor="#FFFFFF"
                           FontSize="13"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Border>
</ContentView>
