<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    x:Class="RescuAR.App.Views.Prepare.HotlineDirectoryPage"
    x:Name="thisHotlinePage"
    Title="Emergency Hotlines"
    BackgroundColor="#F8FAFC">

    <ContentPage.BindingContext>
        <vm:HotlineDirectoryViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,24" Spacing="20">
            
            <!-- Page Title Header -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Emergency Hotlines" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" CharacterSpacing="-0.5" />
                <Label Text="Instant 24/7 emergency contacts, rescue services &amp; medical lines." TextColor="#64748B" FontSize="14" />
            </VerticalStackLayout>

            <!-- Search Bar Input -->
            <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Search Glass Icon -->
                    <Path Grid.Column="0" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Fill="#94A3B8" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" Margin="0,0,10,0" />
                    
                    <Entry Grid.Column="1" Text="{Binding SearchQuery}" Placeholder="Search agency name or hotline number..."
                           PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="14" VerticalOptions="Center" ClearButtonVisibility="WhileEditing" />
                </Grid>
            </Border>

            <!-- Hotlines Feed -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredHotlines}" Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HotlineDirectoryItem">
                        <Border StrokeThickness="0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="18">
                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Offset="0,4" Radius="8" Opacity="0.05" />
                            </Border.Shadow>
                            
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- Info Left Column -->
                                <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Border BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3">
                                            <Label Text="{Binding BadgeText}" TextColor="#007E8A" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                    </HorizontalStackLayout>
                                    
                                    <Label Text="{Binding Number}" TextColor="#007E8A" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Type}" TextColor="#64748B" FontSize="13" />
                                </VerticalStackLayout>

                                <!-- Call Button Right Column -->
                                <Border Grid.Column="1" WidthRequest="48" HeightRequest="48" BackgroundColor="#007E8A" StrokeThickness="0" StrokeShape="RoundRectangle 24" HorizontalOptions="End" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.MakePhoneCallCommand, Source={x:Reference thisHotlinePage}}" CommandParameter="{Binding Number}" />
                                    </Border.GestureRecognizers>
                                    <Path Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
                                          Fill="#FFFFFF" WidthRequest="20" HeightRequest="20" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
