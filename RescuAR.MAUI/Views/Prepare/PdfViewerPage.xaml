<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RescuAR.App.Views.Prepare.PdfViewerPage"
             Title="Safety Guide PDF"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">
        <!-- Top Custom Header Bar with Back Button and Title Banner (RescuAR Teal Brand Palette) -->
        <Border Grid.Row="0"
                BackgroundColor="#0A8491"
                StrokeThickness="0"
                Padding="16,11">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Back Button Pill with Professional Triangle Back Arrow (same as Community Reports) -->
                <Border Grid.Column="0"
                        BackgroundColor="#065F69"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                          Fill="#FFFFFF"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Title Banner -->
                <Label Grid.Column="1"
                       Text="Safety Guide PDF"
                       TextColor="#FFFFFF"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />

                <!-- Spacer to ensure title remains perfectly centered -->
                <BoxView Grid.Column="2" WidthRequest="36" HeightRequest="36" Color="Transparent" />
            </Grid>
        </Border>

        <WebView Grid.Row="1" x:Name="PdfWebView" />
    </Grid>
</ContentPage>
