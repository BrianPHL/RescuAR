<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    x:Class="RescuAR.App.Views.Prepare.HistoricalPhotosPage"
    x:DataType="vm:HistoricalPhotosViewModel"
    Title="Historical Photos"
    BackgroundColor="#F8FAFC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Top Custom Header Bar -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="36" HeightRequest="36">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="Historical Photos" TextColor="#0F172A" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Page Content ScrollView -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="16">
                
                <!-- Hero Gallery Banner -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" HeightRequest="160" HorizontalOptions="Fill">
                    <Grid>
                        <Image Source="carousel_flood_history.png" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />
                        <BoxView HorizontalOptions="Fill" VerticalOptions="Fill">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#20032B36" Offset="0.0" />
                                    <GradientStop Color="#90032B36" Offset="0.5" />
                                    <GradientStop Color="#F0032B36" Offset="1.0" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <Grid Padding="18" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,4" HorizontalOptions="Start">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Path Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7Z" Fill="#0369A1" WidthRequest="10" HeightRequest="10" Aspect="Uniform" VerticalOptions="Center" />
                                    <Label Text="ARCHIVAL PHOTOGRAPHY" TextColor="#0369A1" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <VerticalStackLayout Grid.Row="1" Spacing="4" VerticalOptions="End">
                                <Label Text="Marikina Flood Photo Archives" TextColor="#FFFFFF" FontSize="22" FontAttributes="Bold" />
                                <Label Text="Visual history of river crests, flood control development, and rescue operations." TextColor="#E0F2FE" FontSize="12" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Section Title -->
                <Label Text="Photo Collections" TextColor="#0F172A" FontSize="17" FontAttributes="Bold" Margin="0,4,0,0" />

                <!-- Photo Card 1: 1992 Early Telemetry -->
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="#0284C7" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,4">
                                    <Label Text="1992" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                    <Label Text="18.5m Gauge" TextColor="#0369A1" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="DOST PJS" TextColor="#64748B" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="190">
                            <Image Source="carousel_flood_history.png" Aspect="AspectFill" />
                        </Border>

                        <Label Text="Early Marikina River Telemetry &amp; Flood Wall Construction" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                        <Label Text="Archival photography from DOST PJS documentation showing the initial construction of Santo Niño riverbank flood walls following the 1992 high water mark." TextColor="#475569" FontSize="13" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Photo Card 2: 2009 Typhoon Ondoy -->
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="#DC2626" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,4">
                                    <Label Text="2009 • ONDOY" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="#FEE2E2" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                    <Label Text="23.0m Peak" TextColor="#991B1B" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="PAGASA FFWS" TextColor="#64748B" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="190">
                            <Image Source="onboarding_flood.jpg" Aspect="AspectFill" />
                        </Border>

                        <Label Text="Typhoon Ondoy Submerged City Streets" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                        <Label Text="Historic floodwaters reaching 23.0 meters at the Marikina River gauge, submerging Provident Village, Tumana, and Malanday." TextColor="#475569" FontSize="13" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Photo Card 3: 2020 Typhoon Ulysses -->
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="#D97706" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,4">
                                    <Label Text="2020 • ULYSSES" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="#FEF3C7" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                    <Label Text="22.0m Peak" TextColor="#92400E" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="PNA Archive" TextColor="#64748B" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="190">
                            <Image Source="ulysses.jpg" Aspect="AspectFill" />
                        </Border>

                        <Label Text="Typhoon Ulysses 3rd Alarm Flood Rescues" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                        <Label Text="Marikina Rescue 161 and Coast Guard teams deploying rubber boats along J.P. Rizal St. during peak 22-meter flood crest." TextColor="#475569" FontSize="13" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Photo Card 4: 2024 Typhoon Carina -->
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="#2563EB" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,4">
                                    <Label Text="2024 • CARINA" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="#DBEAFE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                    <Label Text="20.7m Peak" TextColor="#1E40AF" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="Marikina Gov" TextColor="#64748B" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="190">
                            <Image Source="carina.jpg" Aspect="AspectFill" />
                        </Border>

                        <Label Text="Typhoon Carina Monsoon Pre-emptive Evacuations" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                        <Label Text="Timely warning sirens and pre-emptive evacuation drills ensuring smooth safety protocols in Tumana and Malanday shelters." TextColor="#475569" FontSize="13" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
