<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RescuAR.App.Views.Prepare.EvacuationCenterInfoPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    Title="Evacuation Centers"
    BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <Style x:Key="SectionTitleStyle"
               TargetType="Label">
            <Setter Property="FontSize"
                    Value="20" />
            <Setter Property="FontAttributes"
                    Value="Bold" />
            <Setter Property="TextColor"
                    Value="#0F172A" />
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="BackgroundColor"
                    Value="#DC2626" />
            <Setter Property="TextColor"
                    Value="White" />
            <Setter Property="FontAttributes"
                    Value="Bold" />
            <Setter Property="CornerRadius"
                    Value="12" />
            <Setter Property="HeightRequest"
                    Value="48" />
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="BackgroundColor"
                    Value="#E2E8F0" />
            <Setter Property="TextColor"
                    Value="#0F172A" />
            <Setter Property="CornerRadius"
                    Value="12" />
            <Setter Property="HeightRequest"
                    Value="44" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="16,18,16,28"
            Spacing="18">

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Emergency Information"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="#0F172A" />

                <Label
                    Text="Choose a verified evacuation center to start AR-guided navigation."
                    FontSize="14"
                    TextColor="#64748B" />
            </VerticalStackLayout>

            <Border
                Padding="14"
                BackgroundColor="#EFF6FF"
                Stroke="#BFDBFE"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Label
                    Text="AR navigation uses your current GPS position and the selected center as the MLD route destination."
                    FontSize="13"
                    TextColor="#1E3A8A" />
            </Border>

            <Label
                Text="Evacuation Centers"
                Style="{StaticResource SectionTitleStyle}" />

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding EvacuationCenters}"
                Spacing="16">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EvacuationCenterItem">
                        <Border
                            Padding="0"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="0">

                                <Grid HeightRequest="140">
                                    <Image
                                        Source="{Binding MapImageSource}"
                                        Aspect="AspectFill" />

                                    <Border
                                        Margin="12"
                                        Padding="10,5"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        BackgroundColor="{Binding StatusPillBg}"
                                        StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="{Binding StatusLabel}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{Binding StatusPillText}" />
                                    </Border>
                                </Grid>

                                <VerticalStackLayout
                                    Padding="16"
                                    Spacing="10">

                                    <VerticalStackLayout Spacing="3">
                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="#0F172A" />

                                        <Label
                                            Text="{Binding Distance}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="#DC2626" />

                                        <Label
                                            Text="{Binding Address}"
                                            FontSize="13"
                                            TextColor="#475569" />

                                        <Label
                                            Text="{Binding VerifiedBy, StringFormat='Verified by {0}'}"
                                            FontSize="12"
                                            TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Grid.Column="0"
                                                Text="Capacity"
                                                FontSize="12"
                                                TextColor="#64748B" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding CapacityText}"
                                                FontSize="12"
                                                TextColor="#475569" />
                                        </Grid>

                                        <ProgressBar
                                            Progress="{Binding ProgressValue}"
                                            HeightRequest="6" />
                                    </VerticalStackLayout>

                                    <Button
                                        Text="Start AR Navigation"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.StartArNavigationCommand}"
                                        CommandParameter="{Binding .}" />

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10">

                                        <Button
                                            Grid.Column="0"
                                            Text="View on Map"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ViewMoreDetailsCommand}"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Grid.Column="1"
                                            Text="Check In"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CheckInEvacueeCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid>

                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label
                Margin="0,8,0,0"
                Text="Emergency Hotlines"
                Style="{StaticResource SectionTitleStyle}" />

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding Hotlines}"
                Spacing="10">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EmergencyHotlineItem">
                        <Border
                            Padding="14"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12">

                                <Border
                                    Grid.Column="0"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="{Binding IconBg}"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Label
                                        Text="{Binding IconEmoji}"
                                        FontSize="22"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="{Binding Name}"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        TextColor="#0F172A" />
                                    <Label
                                        Text="{Binding Type}"
                                        FontSize="12"
                                        TextColor="#64748B" />
                                    <Label
                                        Text="{Binding Number}"
                                        FontSize="13"
                                        TextColor="#334155" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="2"
                                    Text="Call"
                                    Padding="14,6"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DialNumberCommand}"
                                    CommandParameter="{Binding Number}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button
                Text="Open Full Map"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding NavigateToMapCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
