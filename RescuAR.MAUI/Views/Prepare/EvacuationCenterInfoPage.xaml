<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RescuAR.App.Views.Prepare"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    x:Class="RescuAR.App.Views.Prepare.EvacuationCenterInfoPage"
    x:DataType="vm:EvacuationCenterInfoViewModel"
    x:Name="thisPage"
    Title="Evacuation Centers"
    BackgroundColor="#F8FAFC">

    <Grid>
        <!-- Virtualized Shelters CollectionView -->
        <CollectionView ItemsSource="{Binding EvacuationCenters}" SelectionMode="None">
            
            <!-- Collection Header: Search, Category Picker & Section Title -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,24,20,12" Spacing="20">
                    
                    <!-- Search Box & Dropdown Category Filter -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Search &amp; Category Filter" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                        
                        <!-- Search Input Box -->
                        <Border BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center" HeightRequest="44">
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.29,20.41L13.03,15.15C11.9,15.69 10.61,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5A4.5,4.5 0 0,0 5,9.5A4.5,4.5 0 0,0 9.5,14A4.5,4.5 0 0,0 14,9.5A4.5,4.5 0 0,0 9.5,5Z"
                                      Fill="#64748B" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay}" Placeholder="Search shelter name, barangay, or officer..." PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="14" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Dropdown Category Picker -->
                        <Border BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center" HeightRequest="46">
                                <Path Data="M10,18.17V14.41L19.5,4.91H4.5L10,10.41V18.17M21,3A1,1 0 0,1 22,4C22,4.27 21.89,4.53 21.71,4.71L14,12.42V20A1,1 0 0,1 13.42,20.83L9.42,22.83C8.86,23.11 8,22.7 8,22V12.42L0.29,4.71C0.11,4.53 0,4.27 0,4A1,1 0 0,1 1,3H21Z"
                                      Fill="#007E8A" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                                <Picker Grid.Column="1"
                                        ItemsSource="{Binding CategoryNames}"
                                        SelectedItem="{Binding SelectedCategoryDropdown, Mode=TwoWay}"
                                        Title="Select Classification..."
                                        TitleColor="#94A3B8"
                                        TextColor="#0F172A"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                <Path Grid.Column="2" Data="M7,10L12,15L17,10H7Z" Fill="#64748B" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" InputTransparent="True" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Section Title & Map Toggle -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Margin="0,4,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Evacuation Shelters" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                            <Label Text="Nearest shelter is listed first" TextColor="#0A8491" FontSize="12" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Interactive Map" TextColor="#0A8491" BackgroundColor="#E0F2FE" CornerRadius="12" HeightRequest="38" FontSize="13" FontAttributes="Bold" Padding="16,0"
                                Command="{Binding NavigateToMapCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Card Template -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:EvacuationCenterItem">
                    <Grid Padding="20,8">
                        <Border StrokeThickness="0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 20" Padding="16">
                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Offset="0,6" Radius="12" Opacity="0.06" />
                            </Border.Shadow>
                            
                            <VerticalStackLayout Spacing="14">
                                
                                <!-- Top Badges Row -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                        <Border IsVisible="{Binding IsNearestShelter}" BackgroundColor="#10B981" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,5">
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Path Data="M12,2A8,8 0 0,0 4,10C4,15.25 12,22 12,22C12,22 20,15.25 20,10A8,8 0 0,0 12,2M12,6A4,4 0 0,1 16,10A4,4 0 0,1 12,14A4,4 0 0,1 8,10A4,4 0 0,1 12,6Z"
                                                      Fill="#FFFFFF" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                                                <Label Text="NEAREST TO YOU" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>

                                        <Border BackgroundColor="#F1F5F9" StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="10,5">
                                            <Label Text="{Binding Classification}" TextColor="{Binding ClassificationColor}" FontSize="11" FontAttributes="Bold" />
                                        </Border>

                                        <Border IsVisible="{Binding IsWithin5Km}" BackgroundColor="#DBEAFE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,5">
                                            <Label Text="WITHIN 5 KM" TextColor="#1D4ED8" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <Border Grid.Column="1" WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleBookmarkCommand}" />
                                        </Border.GestureRecognizers>
                                        <Path Data="M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5C19,3.89 18.1,3 17,3Z" 
                                              Fill="{Binding BookmarkFill}" 
                                              Stroke="{Binding BookmarkStroke}" 
                                              StrokeThickness="1.8" 
                                              WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <!-- Facility Image Banner -->
                                <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" HeightRequest="160" BackgroundColor="#E2E8F0" IsVisible="{Binding HasFacilityImage}">
                                    <Grid>
                                        <Image Source="{Binding FacilityImageUrl}" Aspect="AspectFill" HeightRequest="160" />
                                        <Border HorizontalOptions="End" VerticalOptions="Start" Margin="10" BackgroundColor="{Binding StatusPillBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,5">
                                            <Label Text="{Binding StatusLabel}" TextColor="{Binding StatusPillText}" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Shelter Title and Distance -->
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="22" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding DetailedDistanceString}" TextColor="#0A8491" FontSize="14" FontAttributes="Bold" />
                                </VerticalStackLayout>

                                <!-- Metadata Grid -->
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,2,0,2">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Address" TextColor="#64748B" FontSize="13" VerticalOptions="Start" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Address}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" LineBreakMode="WordWrap" />
                                    
                                    <Label Grid.Row="1" Grid.Column="0" Text="Occupancy" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding OccupancyDisplay}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" />

                                    <Label Grid.Row="2" Grid.Column="0" Text="Head Officer" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding HeadOfficer}" TextColor="#0F172A" FontSize="13" HorizontalTextAlignment="End" />

                                    <Label Grid.Row="3" Grid.Column="0" Text="Hotline" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Contact}" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding ViewModel.MakePhoneCallCommand, Source={x:Reference thisPage}, x:DataType=local:EvacuationCenterInfoPage}"
                                                CommandParameter="{Binding Contact}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <!-- Facilities Tags -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Facilities &amp; Amenities" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                                    <Label Text="{Binding FacilitiesDisplay}" TextColor="#334155" FontSize="12" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" HorizontalOptions="Fill" />

                                <!-- Action Links -->
                                <VerticalStackLayout Spacing="12" Margin="0,2,0,0">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding ViewModel.NavigateToCameraCommand, Source={x:Reference thisPage}, x:DataType=local:EvacuationCenterInfoPage}"
                                                CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label Text="Start practice AR evacuation route" TextColor="#007E8A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#007E8A" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding ViewModel.ViewMoreDetailsCommand, Source={x:Reference thisPage}, x:DataType=local:EvacuationCenterInfoPage}"
                                                CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label Text="View complete shelter details &amp; map" TextColor="#007E8A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#007E8A" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Collection Footer: PASS Assessment Tool -->
            <CollectionView.Footer>
                <VerticalStackLayout Padding="20,16,20,32" Spacing="16">
                    <Label Text="Preparedness Tools" TextColor="#0F172A" FontSize="22" FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Preparation Assessment (PASS)" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                        
                        <Border StrokeThickness="0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 20" Padding="20">
                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Offset="0,4" Radius="10" Opacity="0.05" />
                            </Border.Shadow>
                            
                            <VerticalStackLayout Spacing="14">
                                <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M12,3C12.55,3 13,3.45 13,4C13,4.55 12.55,5 12,5C11.45,5 11,4.55 11,4C11,3.45 11.45,3 12,3Z"
                                      Fill="Transparent" Stroke="#CBD5E1" StrokeThickness="2" WidthRequest="28" HeightRequest="28" Aspect="Uniform" HorizontalOptions="Start" />

                                <Label Text="{Binding PassScoreText}" TextColor="#007E8A" FontSize="24" FontAttributes="Bold" />
                                <Label Text="Evaluate your overall preparedness for emergencies and evacuation." TextColor="#334155" FontSize="14" LineBreakMode="WordWrap" />

                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Margin="0,4,0,0">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenPASSAssessmentCommand}" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <Label Text="Take Assessment" TextColor="#007E8A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#007E8A" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

        <!-- FULL DETAILS OVERLAY POPUP DIALOG -->
        <Grid IsVisible="{Binding IsDetailsPopupVisible}" BackgroundColor="#660F172A" Padding="16,20">
            <Border StrokeThickness="0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 24" Padding="18,16" VerticalOptions="Center" MaximumHeightRequest="620">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,10" Radius="20" Opacity="0.2" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    
                    <!-- Row 0: Pop-up Header Row & Title -->
                    <VerticalStackLayout Grid.Row="0" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Shelter Details &amp; Admin Info" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                            <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="30" HeightRequest="30" HorizontalOptions="End">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseDetailsPopupCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="✕" TextColor="#64748B" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{Binding SelectedCenter.Name}" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Border Grid.Column="1" WidthRequest="32" HeightRequest="32" StrokeThickness="0" BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleSelectedCenterBookmarkCommand}" />
                                </Border.GestureRecognizers>
                                <Path Data="M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5C19,3.89 18.1,3 17,3Z" 
                                      Fill="{Binding SelectedCenter.BookmarkFill}" 
                                      Stroke="{Binding SelectedCenter.BookmarkStroke}" 
                                      StrokeThickness="1.8" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Row 1: Scrollable Body -->
                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default" Margin="0,4">
                        <VerticalStackLayout Spacing="14" Padding="0,2">
                            
                            <!-- Shelter Photo Banner (Cloudinary Upload from Admin) -->
                            <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" HeightRequest="140" BackgroundColor="#E2E8F0" IsVisible="{Binding SelectedCenter.HasFacilityImage}">
                                <Image Source="{Binding SelectedCenter.FacilityImageUrl}" Aspect="AspectFill" HeightRequest="140" />
                            </Border>

                            <!-- Map Section -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Location Map Preview" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 14" StrokeThickness="0" HeightRequest="130" BackgroundColor="#F1F5F9">
                                    <mapsui:MapControl x:Name="PopupMapControl" HorizontalOptions="Fill" VerticalOptions="Fill" HeightRequest="130" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Admin Information Metadata -->
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Admin &amp; Shelter Details" TextColor="#334155" FontSize="13" FontAttributes="Bold" />
                                
                                <!-- Classification -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="Classification" TextColor="#64748B" FontSize="13" />
                                    <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 6" Padding="8,4" HorizontalOptions="End">
                                        <Label Text="{Binding SelectedCenter.Classification}" TextColor="{Binding SelectedCenter.ClassificationColor}" FontSize="12" FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <!-- Status -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="Operating Status" TextColor="#64748B" FontSize="13" />
                                    <Border Grid.Column="1" BackgroundColor="{Binding SelectedCenter.StatusPillBg}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,4" HorizontalOptions="End">
                                        <Label Text="{Binding SelectedCenter.StatusLabel}" TextColor="{Binding SelectedCenter.StatusPillText}" FontSize="12" FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <!-- Address -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Start">
                                    <Label Grid.Column="0" Text="Barangay / Address" TextColor="#64748B" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SelectedCenter.Address}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" LineBreakMode="WordWrap" />
                                </Grid>

                                <!-- Occupancy & Capacity -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="Occupancy" TextColor="#64748B" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SelectedCenter.OccupancyDisplay}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                </Grid>

                                <!-- Distance -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="Distance" TextColor="#64748B" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SelectedCenter.DetailedDistanceString}" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                </Grid>

                                <!-- Head Officer -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="Head Officer" TextColor="#64748B" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SelectedCenter.HeadOfficer}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                </Grid>

                                <!-- Contact Hotline -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="Contact Hotline" TextColor="#64748B" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SelectedCenter.Contact}" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding MakePhoneCallCommand}" 
                                                CommandParameter="{Binding SelectedCenter.Contact}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <!-- GPS Coordinates -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="GPS Coordinates" TextColor="#64748B" FontSize="13" />
                                    <Label Grid.Column="1" Text="{Binding SelectedCenter.GpsDisplay}" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Available Facilities -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Available Facilities &amp; Amenities" TextColor="#334155" FontSize="13" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedCenter.FacilitiesDisplay}" TextColor="#0F172A" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Row 2: Fixed Bottom Action Buttons -->
                    <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,4,0,0">
                        <Button Text="Start AR Evacuation Guidance" 
                                TextColor="#FFFFFF" 
                                BackgroundColor="#0A8491" 
                                CornerRadius="14" 
                                HeightRequest="48" 
                                FontSize="15" 
                                FontAttributes="Bold" 
                                Command="{Binding StartARNavigationCommand}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Call Officer" 
                                    TextColor="#0A8491" 
                                    BackgroundColor="#E6F4F5" 
                                    CornerRadius="12" 
                                    HeightRequest="38" 
                                    FontSize="13" 
                                    FontAttributes="Bold" 
                                    Command="{Binding MakePhoneCallCommand}"
                                    CommandParameter="{Binding SelectedCenter.Contact}" />

                            <Button Grid.Column="1"
                                    Text="Close Details" 
                                    TextColor="#475569" 
                                    BackgroundColor="#F1F5F9" 
                                    CornerRadius="12" 
                                    HeightRequest="38" 
                                    FontSize="13" 
                                    FontAttributes="Bold" 
                                    Command="{Binding CloseDetailsPopupCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
