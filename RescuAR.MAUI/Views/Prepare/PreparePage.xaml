<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    x:Class="RescuAR.App.Views.Prepare.PreparePage"
    x:DataType="vm:PrepareViewModel"
    Title="Prepare Page"
    BackgroundColor="#F8FAFC">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="20" Padding="16,20,16,30">

            <!-- 1. HERO PREPAREDNESS SCORE BANNER -->
            <Border BackgroundColor="#0A8491"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="DISASTER PREPAREDNESS"
                                   TextColor="#E0F2FE"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1" />
                            <Label Text="Prepare Page"
                                   TextColor="#FFFFFF"
                                   FontSize="26"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <!-- Score Pill Badge -->
                        <Border Grid.Column="1"
                                BackgroundColor="#065F69"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,8">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding PercentReady, StringFormat='{0}%'}"
                                       TextColor="#4ADE80"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                                <Label Text="READY"
                                       TextColor="#FFFFFF"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="{Binding Subtitle}"
                           TextColor="#E0F2FE"
                           FontSize="13"
                           LineBreakMode="WordWrap" />

                    <!-- Progress Bar Track -->
                    <Border BackgroundColor="#065F69"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="16,12">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding PreparednessStatus}"
                                       TextColor="#FFFFFF"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                                <Label Grid.Column="1"
                                       Text="View Progress ↗"
                                       TextColor="#4ADE80"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Grid>

                            <ProgressBar Progress="{Binding ProgressFraction}"
                                         ProgressColor="#4ADE80"
                                         HeightRequest="8" />
                        </VerticalStackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenChecklistCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 2. SECTION 1: ESSENTIAL EMERGENCY TOOLS -->
            <VerticalStackLayout Spacing="10">
                <Label Text="ESSENTIAL EMERGENCY TOOLS"
                       TextColor="#64748B"
                       FontSize="12"
                       FontAttributes="Bold"
                       CharacterSpacing="0.8"
                       Margin="4,0,0,0" />

                <!-- Emergency Kit Checklist Card -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="16"
                        HeightRequest="95">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenChecklistCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                BackgroundColor="#DCFCE7"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                WidthRequest="46"
                                HeightRequest="46"
                                VerticalOptions="Center">
                            <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M14,17H7V15H14V17M17,13H7V11H17V13M17,9H7V7H17V9Z"
                                  Fill="#166534"
                                  WidthRequest="24"
                                  HeightRequest="24"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Emergency Kit Checklist"
                                       TextColor="#0F172A"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Border BackgroundColor="#DCFCE7"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="6,2"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding PercentReady, StringFormat='{0}%'}"
                                           TextColor="#166534"
                                           FontSize="10"
                                           FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="Track essential supplies, food, water &amp; medical kit items"
                                   TextColor="#64748B"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="➔"
                               TextColor="#0A8491"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Household Assessment Card -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="16"
                        HeightRequest="95">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAssessmentCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                BackgroundColor="#E0F2FE"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                WidthRequest="46"
                                HeightRequest="46"
                                VerticalOptions="Center">
                            <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1ZM12,11.99H19C18.47,15.61 15.72,18.78 12,19.93V12H5V6.3L12,3.19V11.99Z"
                                  Fill="#0369A1"
                                  WidthRequest="24"
                                  HeightRequest="24"
                                  Aspect="Uniform"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Preparation Assessment (PASS)"
                                   TextColor="#0F172A"
                                   FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="Evaluate household flood risk, structure &amp; readiness level"
                                   TextColor="#64748B"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="➔"
                               TextColor="#0A8491"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- 3. SECTION 2: SHELTERS & EMERGENCY DIRECTORY -->
            <VerticalStackLayout Spacing="10">
                <Label Text="SHELTERS &amp; EMERGENCY CONTACTS"
                       TextColor="#64748B"
                       FontSize="12"
                       FontAttributes="Bold"
                       CharacterSpacing="0.8"
                       Margin="4,0,0,0" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Evacuation Center Card -->
                    <Border Grid.Column="0"
                            BackgroundColor="#FFFFFF"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14"
                            HeightRequest="135">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenEvacuationCenterCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <Border BackgroundColor="#E0F2FE"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        VerticalOptions="Center">
                                    <Path Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z"
                                          Fill="#0369A1"
                                          WidthRequest="18"
                                          HeightRequest="18"
                                          Aspect="Uniform"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="2" Text="↗" TextColor="#0A8491" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout Grid.Row="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Evacuation Shelters" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Shelters &amp; live capacity" TextColor="#64748B" FontSize="11" />
                            </VerticalStackLayout>

                            <Label Grid.Row="2" Text="Locate Nearest ➔" TextColor="#0369A1" FontSize="11" FontAttributes="Bold" />
                        </Grid>
                    </Border>

                    <!-- Hotline Directory Card -->
                    <Border Grid.Column="1"
                            BackgroundColor="#FFFFFF"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="14"
                            HeightRequest="135">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenHotlineDirectoryCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                <Border BackgroundColor="#F3E8FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        VerticalOptions="Center">
                                    <Path Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21C10.61,21 3,13.39 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
                                          Fill="#7E22CE"
                                          WidthRequest="18"
                                          HeightRequest="18"
                                          Aspect="Uniform"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="2" Text="↗" TextColor="#0A8491" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout Grid.Row="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Emergency Hotlines" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Rescue, LGU &amp; Medical" TextColor="#64748B" FontSize="11" />
                            </VerticalStackLayout>

                            <Label Grid.Row="2" Text="Call Directory ➔" TextColor="#7E22CE" FontSize="11" FontAttributes="Bold" />
                        </Grid>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- 4. SECTION 3: GUIDES & PRACTICE DRILL -->
            <VerticalStackLayout Spacing="10">
                <Label Text="SAFETY GUIDES &amp; PRACTICE DRILL"
                       TextColor="#64748B"
                       FontSize="12"
                       FontAttributes="Bold"
                       CharacterSpacing="0.8"
                       Margin="4,0,0,0" />

                <!-- Disaster Safety Guide Card (Opens PDF Viewer) -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPreparednessGuideCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0" BackgroundColor="#E0E7FF" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                            <Path Data="M19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M14,17H7V15H14V17M17,13H7V11H17V13M17,9H7V7H17V9Z"
                                  Fill="#4338CA" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Disaster Safety Guide" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                                <Border BackgroundColor="#E0E7FF" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,1" VerticalOptions="Center">
                                    <Label Text="PDF Protocol" TextColor="#4338CA" FontSize="9" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="Official DRRMO Marikina City Protocol PDF Document" TextColor="#64748B" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="➔" TextColor="#0A8491" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- AR Evacuation Practice Card (Routes to Camera) -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPracticeARCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0" BackgroundColor="#DCFCE7" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                            <Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z"
                                  Fill="#15803D" WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="AR Evacuation Practice" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                                <Border BackgroundColor="#DCFCE7" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,1" VerticalOptions="Center">
                                    <Label Text="Camera AR" TextColor="#15803D" FontSize="9" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="Practice AR safe route navigation with live camera" TextColor="#64748B" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="➔" TextColor="#0A8491" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
