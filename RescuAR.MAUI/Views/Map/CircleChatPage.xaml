<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Map"
             x:Class="RescuAR.App.Views.Map.CircleChatPage"
             x:DataType="vm:CircleChatViewModel"
             Title="Safety Circle Chat"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Top App Bar / Header -->
        <Border Grid.Row="0" BackgroundColor="#0F8068" HeightRequest="80" StrokeThickness="0" Padding="12,0" Shadow="{Shadow Brush=Black, Offset='0,4', Radius=10, Opacity=0.2}">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto" VerticalOptions="Center">
                <!-- Back Button -->
                <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="38" HeightRequest="38" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="White" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Group Photo Avatar with Change Action -->
                <Border Grid.Column="1" BackgroundColor="White" Stroke="#34D399" StrokeThickness="2" WidthRequest="46" HeightRequest="46" Margin="6,0,10,0" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="23" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickGroupPhotoCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <!-- Default Group Icon -->
                        <Path IsVisible="{Binding HasNoGroupAvatar}" 
                              Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" 
                              Fill="#0F8068" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        
                        <!-- Custom Group Photo if uploaded -->
                        <Image IsVisible="{Binding HasGroupAvatar}" Source="{Binding GroupAvatarUrl}" Aspect="AspectFill" />
                    </Grid>
                </Border>

                <!-- Circle Info -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding CircleName}" TextColor="White" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="3.5" BackgroundColor="#4ADE80" VerticalOptions="Center"/>
                        <Label Text="{Binding MemberCountText}" TextColor="#E2E8F0" FontSize="11"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Invite Code Chip -->
                <Border Grid.Column="3" BackgroundColor="#134E4A" StrokeThickness="1" Stroke="#2DD4BF" Padding="8,4" Margin="4,0,0,0" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyInviteCodeCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding InviteCode, StringFormat='Code: {0}'}" TextColor="#5EEAD4" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" 
                              Fill="#5EEAD4" Aspect="Uniform" WidthRequest="11" HeightRequest="11" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Uploading Indicator Banner -->
        <Border Grid.Row="1" IsVisible="{Binding IsUploading}" BackgroundColor="#E0F2FE" Stroke="#BAE6FD" StrokeThickness="1" Padding="12,8" Margin="12,8,12,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="#0284C7" WidthRequest="18" HeightRequest="18"/>
                <Label Text="{Binding UploadStatusText}" TextColor="#0369A1" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Messages Stream -->
        <CollectionView Grid.Row="2" 
                        x:Name="MessagesCollectionView"
                        ItemsSource="{Binding Messages}" 
                        Margin="12,6"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,70,0,0">
                    <Border BackgroundColor="#E2E8F0" StrokeThickness="0" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="35" />
                        </Border.StrokeShape>
                        <Path Data="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z" 
                              Fill="#64748B" Aspect="Uniform" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Family Safety Chat" TextColor="#334155" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Share updates, emergency status, photos, and location proof with joined family members." 
                           TextColor="#64748B" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaximumWidthRequest="290"/>
                    
                    <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" Padding="14,8" Margin="0,8,0,0" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CopyInviteCodeCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Tap to Copy Family Invite Code" TextColor="#0F8068" FontSize="12" FontAttributes="Bold"/>
                            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" 
                                  Fill="#0F8068" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageItem">
                    <Grid Padding="0,5">
                        <!-- My Message (Right Aligned) -->
                        <VerticalStackLayout IsVisible="{Binding IsMyMessage}" HorizontalOptions="End" MaximumWidthRequest="290">
                            <Border BackgroundColor="#0F8068" StrokeThickness="0" Padding="12,10" Shadow="{Shadow Brush=Black, Offset='0,2', Radius=6, Opacity=0.15}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18,18,4,18" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <!-- Attached Media -->
                                    <Border IsVisible="{Binding HasMedia}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Margin="0,0,0,4">
                                        <Image Source="{Binding MediaUrl}" Aspect="AspectFill" HeightRequest="195" WidthRequest="255"/>
                                    </Border>
                                    
                                    <!-- Text Message -->
                                    <Label IsVisible="{Binding HasText}" Text="{Binding MessageText}" TextColor="White" FontSize="14" LineBreakMode="WordWrap"/>
                                    
                                    <!-- Time & Read status -->
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                        <Label Text="{Binding FormattedTime}" TextColor="#B2DFDB" FontSize="10" VerticalOptions="Center"/>
                                        <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="#80CBC4" Aspect="Uniform" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Other Family Member's Message (Left Aligned) -->
                        <Grid IsVisible="{Binding IsNotMyMessage}" ColumnDefinitions="Auto, *" ColumnSpacing="8" HorizontalOptions="Start" MaximumWidthRequest="310">
                            <!-- Sender Avatar -->
                            <Border Grid.Column="0" BackgroundColor="#0F8068" StrokeThickness="0" WidthRequest="34" HeightRequest="34" VerticalOptions="Start" Margin="0,2,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>
                                <Grid>
                                    <Label Text="{Binding SenderInitials}" TextColor="White" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Image Source="{Binding SenderAvatarUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding SenderName}" TextColor="#0F8068" FontSize="12" FontAttributes="Bold" Margin="4,0,0,3"/>
                                <Border BackgroundColor="White" StrokeThickness="0" Padding="12,10" Shadow="{Shadow Brush=Black, Offset='0,2', Radius=6, Opacity=0.08}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4,18,18,18" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6">
                                        <!-- Attached Media -->
                                        <Border IsVisible="{Binding HasMedia}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Margin="0,0,0,4">
                                            <Image Source="{Binding MediaUrl}" Aspect="AspectFill" HeightRequest="195" WidthRequest="255"/>
                                        </Border>
                                        
                                        <!-- Text Message -->
                                        <Label IsVisible="{Binding HasText}" Text="{Binding MessageText}" TextColor="#1E293B" FontSize="14" LineBreakMode="WordWrap"/>
                                        
                                        <!-- Time -->
                                        <Label Text="{Binding FormattedTime}" TextColor="#94A3B8" FontSize="10" HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Chat Input Bar -->
        <Border Grid.Row="3" BackgroundColor="White" StrokeThickness="0" Padding="10,8" Shadow="{Shadow Brush=Black, Offset='0,-3', Radius=8, Opacity=0.08}">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="6" VerticalOptions="Center">
                <!-- Camera Button (Proof of status) -->
                <Border Grid.Column="0" BackgroundColor="#0F8068" StrokeThickness="0" WidthRequest="42" HeightRequest="42" VerticalOptions="Center" Shadow="{Shadow Brush=Black, Offset='0,2', Radius=4, Opacity=0.15}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CapturePhotoCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" 
                          Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Gallery Button (Photo / Video upload) -->
                <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeThickness="0" WidthRequest="42" HeightRequest="42" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickMediaCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" 
                          Fill="#0F8068" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Message Input Entry -->
                <Border Grid.Column="2" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="14,0" HeightRequest="44" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding NewMessageText}" 
                           Placeholder="Type update to family..." 
                           PlaceholderColor="#94A3B8" 
                           TextColor="#0F172A" 
                           FontSize="13" 
                           VerticalOptions="Center"
                           ReturnCommand="{Binding SendMessageCommand}" />
                </Border>

                <!-- Send Button -->
                <Border Grid.Column="3" BackgroundColor="#0F8068" StrokeThickness="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" Shadow="{Shadow Brush=Black, Offset='0,3', Radius=6, Opacity=0.2}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" Fill="White" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,0"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
