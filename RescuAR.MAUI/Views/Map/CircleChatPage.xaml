<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Map"
             xmlns:sc="clr-namespace:RescuAR.App.Services.SafetyCircle"
             xmlns:local="clr-namespace:RescuAR.App.Views.Map"
             x:Class="RescuAR.App.Views.Map.CircleChatPage"
             x:Name="CircleChatRoot"
             x:DataType="vm:CircleChatViewModel"
             Title="Safety Circle Chat"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, Auto">
        <!-- Top App Bar / Header -->
        <Border Grid.Row="0" BackgroundColor="#0A8491" HeightRequest="64" StrokeThickness="0" Padding="14,0" Shadow="{Shadow Brush=Black, Offset='0,2', Radius=6, Opacity=0.12}">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto" VerticalOptions="Center">
                <!-- Back Button -->
                <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Group Avatar -->
                <Border Grid.Column="1" BackgroundColor="White" Stroke="#2DD4BF" StrokeThickness="2" WidthRequest="40" HeightRequest="40" Margin="6,0,10,0" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickGroupPhotoCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <!-- Default Group Icon -->
                        <Path IsVisible="{Binding HasNoGroupAvatar}"
                              Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                              Fill="#0A8491" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>

                        <!-- Custom Group Photo -->
                        <Image IsVisible="{Binding HasGroupAvatar}" Source="{Binding GroupAvatarUrl}" Aspect="AspectFill" />
                    </Grid>
                </Border>

                <!-- Circle Info & Dropdown Trigger -->
                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleCirclePickerCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                        <Label Text="{Binding CircleName}" TextColor="White" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" MaximumWidthRequest="130"/>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" BackgroundColor="#4ADE80" VerticalOptions="Center"/>
                            <Label Text="{Binding MemberCountText}" TextColor="#E2E8F0" FontSize="10.5"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Path Data="M7 10l5 5 5-5z" Fill="White" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" Margin="2,0,0,0"/>
                </HorizontalStackLayout>

                <!-- Invite Code Chip -->
                <Border Grid.Column="3" BackgroundColor="#08646E" StrokeThickness="1" Stroke="#2DD4BF" Padding="8,4" Margin="4,0,0,0" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyInviteCodeCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding InviteCode}" TextColor="#CCFBF1" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                              Fill="#CCFBF1" Aspect="Uniform" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Circle Dropdown Switcher Overlay -->
        <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsCirclePickerOpen}" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" Margin="16,4,16,0" Padding="0" VerticalOptions="Start" ZIndex="30" Shadow="{Shadow Brush=Black, Offset='0,4', Radius=10, Opacity=0.18}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="0">
                <Grid Padding="14,10" ColumnDefinitions="*,Auto" BackgroundColor="#F8FAFC">
                    <Label Text="Switch Safety Circle" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                    <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="24" HeightRequest="24">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCirclePickerCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="✕" TextColor="#64748B" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>
                <CollectionView ItemsSource="{Binding MyCircles}" SelectionMode="None" MaximumHeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="sc:CircleMembership">
                            <Grid Padding="14,10" ColumnDefinitions="Auto,*" BackgroundColor="White">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CircleChatViewModel}}, Path=SwitchCircleCommand, x:DataType=vm:CircleChatViewModel}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#E6F4F2" StrokeThickness="0" WidthRequest="28" HeightRequest="28" Margin="0,0,10,0" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                          Fill="#0A8491" Aspect="Uniform" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Name}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Delivery/cache state stays visible and wraps on narrow screens. -->
        <Border Grid.Row="1" BackgroundColor="#E0F2FE" Stroke="#BAE6FD" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,6" Margin="12,6,12,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0284C7" WidthRequest="16" HeightRequest="16" />
                <Label Grid.Column="1" Text="{Binding StatusMessage}" TextColor="#0369A1" FontSize="11" LineBreakMode="WordWrap" />
                <Button Grid.Column="2" Text="Refresh" Command="{Binding RefreshMessagesCommand}" IsEnabled="{Binding CanSend}" BackgroundColor="Transparent" TextColor="#0369A1" FontSize="10" Padding="4,0" />
            </Grid>
        </Border>

        <!-- Messages Stream -->
        <CollectionView Grid.Row="2"
                        x:Name="MessagesCollectionView"
                        ItemsSource="{Binding Messages}"
                        Margin="12,6"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Margin="0,60,0,0">
                    <Border BackgroundColor="#E2E8F0" StrokeThickness="0" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Path Data="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z"
                              Fill="#64748B" Aspect="Uniform" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Family Safety Chat" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Share messages, updates, and photos with joined members."
                           TextColor="#64748B" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaximumWidthRequest="260"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageItem">
                    <Grid Padding="0,4">
                        <!-- My Message (Right Aligned - Tail on Right) -->
                        <VerticalStackLayout IsVisible="{Binding IsMyMessage}" HorizontalOptions="End" MaximumWidthRequest="280">
                            <Border BackgroundColor="#0A8491" StrokeThickness="0" Padding="12,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16, 16, 2, 16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <!-- Attached Media -->
                                    <Border IsVisible="{Binding HasMedia}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Margin="0,0,0,3">
                                        <VerticalStackLayout Spacing="4">
                                            <Image IsVisible="{Binding IsImage}" Source="{Binding MediaUrl}" Aspect="AspectFit" HeightRequest="160" WidthRequest="230" />
                                            <Button IsVisible="{Binding IsVideo}" Text="Open video" FontSize="12" BackgroundColor="#E2E8F0" TextColor="#0F172A"
                                                    Command="{Binding ViewModel.OpenMediaCommand, Source={x:Reference CircleChatRoot}, x:DataType=local:CircleChatPage}" CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Text Message -->
                                    <Label IsVisible="{Binding HasText}" Text="{Binding MessageText}" TextColor="White" FontSize="13.5" LineBreakMode="WordWrap"/>

                                    <!-- Time -->
                                    <Label Text="{Binding FormattedTime}" TextColor="#CCFBF1" FontSize="9.5" HorizontalOptions="End"/>
                                    <Label Text="{Binding DeliveryText}" TextColor="#CCFBF1" FontSize="10" HorizontalOptions="End" />
                                    <Button IsVisible="{Binding CanRetry}" Text="Retry" FontSize="11" BackgroundColor="White" TextColor="#0A8491" Padding="8,0"
                                            IsEnabled="{Binding ViewModel.CanSend, Source={x:Reference CircleChatRoot}, x:DataType=local:CircleChatPage}"
                                            Command="{Binding ViewModel.RetryMessageCommand, Source={x:Reference CircleChatRoot}, x:DataType=local:CircleChatPage}" CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Other Family Member's Message (Left Aligned - Tail on Left) -->
                        <Grid IsVisible="{Binding IsNotMyMessage}" ColumnDefinitions="Auto, *" ColumnSpacing="8" HorizontalOptions="Start" MaximumWidthRequest="300">
                            <!-- Sender Avatar -->
                            <Border Grid.Column="0" BackgroundColor="#E6F4F2" StrokeThickness="0" WidthRequest="32" HeightRequest="32" VerticalOptions="Start" Margin="0,2,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Grid>
                                    <Label Text="{Binding SenderInitials}" TextColor="#0A8491" FontSize="10.5" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Image Source="{Binding SenderAvatarUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding SenderName}" TextColor="#0A8491" FontSize="11" FontAttributes="Bold" Margin="2,0,0,2"/>
                                <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16, 16, 16, 2" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <!-- Attached Media -->
                                        <Border IsVisible="{Binding HasMedia}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Margin="0,0,0,3">
                                            <VerticalStackLayout Spacing="4">
                                            <Image IsVisible="{Binding IsImage}" Source="{Binding MediaUrl}" Aspect="AspectFit" HeightRequest="160" WidthRequest="230" />
                                            <Button IsVisible="{Binding IsVideo}" Text="Open video" FontSize="12" BackgroundColor="#E2E8F0" TextColor="#0F172A"
                                                    Command="{Binding ViewModel.OpenMediaCommand, Source={x:Reference CircleChatRoot}, x:DataType=local:CircleChatPage}" CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                        </Border>

                                        <!-- Text Message -->
                                        <Label IsVisible="{Binding HasText}" Text="{Binding MessageText}" TextColor="#0F172A" FontSize="13.5" LineBreakMode="WordWrap"/>

                                        <!-- Time -->
                                        <Label Text="{Binding FormattedTime}" TextColor="#94A3B8" FontSize="9.5" HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="3" IsVisible="{Binding HasAttachment}" BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeShape="RoundRectangle 10" Padding="10" Margin="12,4">
            <VerticalStackLayout Spacing="5">
                <Label Text="Review attachment — nothing has been uploaded" FontAttributes="Bold" FontSize="12" TextColor="#0F172A" />
                <Label Text="{Binding AttachmentDetails}" FontSize="11" TextColor="#475569" />
                <Image IsVisible="{Binding IsAttachmentImage}" Source="{Binding AttachmentPath}" Aspect="AspectFit" HeightRequest="130" />
                <Button Text="Open full preview" Command="{Binding PreviewAttachmentCommand}" IsEnabled="{Binding IsNotBusy}" BackgroundColor="#DBEAFE" TextColor="#1E40AF" FontSize="11" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Cancel attachment" Command="{Binding CancelAttachmentCommand}" IsEnabled="{Binding CanSend}" BackgroundColor="#E2E8F0" TextColor="#475569" FontSize="11" />
                    <Button Grid.Column="1" Text="Send attachment" Command="{Binding SendMessageCommand}" IsEnabled="{Binding CanSend}" BackgroundColor="#0A8491" TextColor="White" FontSize="11" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Quick Chat Emergency Chips Bar -->
        <ScrollView IsEnabled="{Binding CanSend}" Grid.Row="4" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,4,0,4">
            <HorizontalStackLayout Spacing="6" Padding="12,0">
                <Border BackgroundColor="#E6F4F2" Stroke="#0A8491" StrokeThickness="1" Padding="10,6" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding QuickChatCommand}" CommandParameter="Hello everyone! 👋" />
                    </Border.GestureRecognizers>
                    <Label Text="👋 Hello everyone!" TextColor="#0A8491" FontSize="11" FontAttributes="Bold" />
                </Border>

                <Border BackgroundColor="#DCFCE7" Stroke="#16A34A" StrokeThickness="1" Padding="10,6" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding QuickChatCommand}" CommandParameter="I am safe at my current location. 📍" />
                    </Border.GestureRecognizers>
                    <Label Text="📍 I'm safe" TextColor="#15803D" FontSize="11" FontAttributes="Bold" />
                </Border>

                <Border BackgroundColor="#FEE2E2" Stroke="#EF4444" StrokeThickness="1" Padding="10,6" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding QuickChatCommand}" CommandParameter="EMERGENCY: I need assistance! ⚠️" />
                    </Border.GestureRecognizers>
                    <Label Text="⚠️ Need Help!" TextColor="#B91C1C" FontSize="11" FontAttributes="Bold" />
                </Border>

                <Border BackgroundColor="#FEF3C7" Stroke="#F59E0B" StrokeThickness="1" Padding="10,6" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding QuickChatCommand}" CommandParameter="Heading to the evacuation center now. 🏃‍♂️" />
                    </Border.GestureRecognizers>
                    <Label Text="🏃‍♂️ Going to Evac" TextColor="#B45309" FontSize="11" FontAttributes="Bold" />
                </Border>

                <Border BackgroundColor="#EFF6FF" Stroke="#3B82F6" StrokeThickness="1" Padding="10,6" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding QuickChatCommand}" CommandParameter="My phone battery is running low. 🔋" />
                    </Border.GestureRecognizers>
                    <Label Text="🔋 Low Battery" TextColor="#1D4ED8" FontSize="11" FontAttributes="Bold" />
                </Border>

                <Border BackgroundColor="#F3E8FF" Stroke="#A855F7" StrokeThickness="1" Padding="10,6" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding QuickChatCommand}" CommandParameter="Please update me on your status! 💬" />
                    </Border.GestureRecognizers>
                    <Label Text="💬 What's your status?" TextColor="#7E22CE" FontSize="11" FontAttributes="Bold" />
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Bottom Chat Input Bar -->
        <Border IsEnabled="{Binding CanSend}" Grid.Row="5" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="8,8" Shadow="{Shadow Brush=Black, Offset='0,-2', Radius=6, Opacity=0.06}">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                <!-- Photo Upload Button -->
                <Border Grid.Column="0" BackgroundColor="#F1F5F9" StrokeThickness="0" WidthRequest="38" HeightRequest="38" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickMediaCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"
                          Fill="#0A8491" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Message Input Entry -->
                <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="14,0" HeightRequest="40" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding NewMessageText}"
                           Placeholder="Type a message..."
                           PlaceholderColor="#94A3B8"
                           TextColor="#0F172A"
                           FontSize="13"
                           VerticalOptions="Center"
                           ReturnCommand="{Binding SendMessageCommand}" />
                </Border>

                <!-- Send Button -->
                <Border Grid.Column="2" BackgroundColor="#0A8491" StrokeThickness="0" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" Fill="White" Aspect="Uniform" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,0"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
