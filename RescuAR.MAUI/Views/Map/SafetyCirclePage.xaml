<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RescuAR.App.Views.Map"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Map"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    xmlns:sc="clr-namespace:RescuAR.App.Services.SafetyCircle"
    x:Class="RescuAR.App.Views.Map.SafetyCirclePage"
    x:Name="SafetyCircleRoot"
    x:DataType="vm:SafetyCircleViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Top App Bar / Header -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                HeightRequest="56"
                StrokeThickness="0"
                Padding="16,0"
                ZIndex="10"
                Shadow="{Shadow Brush=Black, Offset='0,2', Radius=4, Opacity=0.06}">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="RescuAR"
                       TextColor="#0F172A"
                       FontSize="16"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />

                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"
                          Fill="#334155"
                          Aspect="Uniform"
                          WidthRequest="20"
                          HeightRequest="20"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" BackgroundColor="White" Padding="12,2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Button Text="General / Offline Map" Command="{Binding OpenGeneralMapCommand}" BackgroundColor="#E6F4F2" TextColor="#0A8491" CornerRadius="8" FontSize="11" Padding="8,0" />
            <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Sharing" FontSize="12" TextColor="#334155" VerticalOptions="Center" />
                <Switch IsToggled="{Binding IsSharingEnabled}" OnColor="#0A8491" />
            </HorizontalStackLayout>
            <Button Grid.Column="2" Text="Info" Command="{Binding ToggleMapDetailsCommand}" BackgroundColor="Transparent" TextColor="#0A8491" FontSize="11" Padding="6,0" />
        </Grid>

        <!-- Main Map Area -->
        <Grid Grid.Row="2">
            <!-- Mapsui Native Map -->
            <mapsui:MapControl x:Name="MapControl"
                               HorizontalOptions="FillAndExpand"
                               VerticalOptions="FillAndExpand" />

            <!-- Top Circle Selector Pill -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,16,0,0"
                    Padding="16,10"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.15}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleCircleDropdownCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="{Binding SelectedCircleName, FallbackValue='Select Circle'}"
                           TextColor="#0F172A"
                           FontSize="14"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Path Data="M7 10l5 5 5-5z"
                          Fill="#0F172A"
                          Aspect="Uniform"
                          WidthRequest="12"
                          HeightRequest="12"
                          VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsMapDetailsOpen}" ZIndex="30" BackgroundColor="White" Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 16" Padding="14" Margin="16,64,16,0" VerticalOptions="Start">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding LocalLocationStatus}" TextColor="#0D5C68" FontSize="12" />
                    <Label Text="{Binding SharingStatus}" TextColor="#334155" FontSize="12" />
                    <Label Text="{Binding OfflineMapStatus}" TextColor="#64748B" FontSize="11" />
                    <Label Text="{Binding StatusMessage}" TextColor="#64748B" FontSize="11" />
                    <Label Text="Other members' pins show dated, last-shared positions. Your device pin stays local unless Sharing is On." TextColor="#64748B" FontSize="11" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Refresh" Command="{Binding RefreshCommand}" BackgroundColor="#E6F4F2" TextColor="#0A8491" FontSize="12" />
                        <Button Grid.Column="1" Text="Close" Command="{Binding ToggleMapDetailsCommand}" BackgroundColor="Transparent" TextColor="#64748B" FontSize="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- The selector shares the approved account/server membership foundation. -->
            <ContentView IsVisible="{Binding IsCircleDropdownOpen}" BackgroundColor="#50000000" ZIndex="50">
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" HorizontalOptions="Center" VerticalOptions="Start" Margin="16,64,16,0" Padding="16" MaximumWidthRequest="360">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Your Circles" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Close" Command="{Binding ToggleCircleDropdownCommand}" BackgroundColor="Transparent" TextColor="#64748B" FontSize="12" />
                        </Grid>
                        <CollectionView ItemsSource="{Binding MyCircles}" SelectionMode="None" MaximumHeightRequest="220">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="sc:CircleMembership">
                                    <Button Text="{Binding Name}" BackgroundColor="#F1F5F9" TextColor="#0F172A" Margin="0,3" CornerRadius="8"
                                            Command="{Binding ViewModel.SelectCircleFromListCommand, Source={x:Reference SafetyCircleRoot}, x:DataType=local:SafetyCirclePage}" CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView><Label Text="No confirmed Circles to display." TextColor="#64748B" Padding="8" /></CollectionView.EmptyView>
                        </CollectionView>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Button Text="Create" Command="{Binding CreateCircleCommand}" IsEnabled="{Binding CanOpenCircleAction}" BackgroundColor="#0A8491" TextColor="White" CornerRadius="10" FontSize="12" Padding="8,0" />
                            <Button Grid.Column="1" Text="Join" Command="{Binding JoinCircleCommand}" IsEnabled="{Binding CanOpenCircleAction}" BackgroundColor="#E6F4F2" TextColor="#0A8491" CornerRadius="10" FontSize="12" Padding="8,0" />
                            <Button Grid.Column="2" Text="Invite code" Command="{Binding ShowInlineInviteCommand}" IsEnabled="{Binding CanShowInlineInvite}" BackgroundColor="#E6F4F2" TextColor="#0A8491" CornerRadius="10" FontSize="11" Padding="6,0" />
                        </Grid>
                        <Button Text="Manage memberships" Command="{Binding ManageCirclesCommand}" BackgroundColor="Transparent" TextColor="#64748B" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </ContentView>

            <!-- Floating Zoom Controls -->
            <Border BackgroundColor="#F8FAFC"
                    StrokeThickness="0"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="16,0,0,76"
                    Padding="0"
                    WidthRequest="44"
                    ZIndex="25"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.1}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsPeopleSheetOpen}" Value="True">
                        <Setter Property="Margin" Value="16,0,0,232" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Border BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ZoomInCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="6,0" />
                    <Border BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ZoomOutCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="-" TextColor="#0F172A" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-3,0,0"/>
                    </Border>
                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="6,0" />
                    <Border BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CenterOnMeCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="◎" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Single Floating Chat Action Button for Safety Circle Group Chat -->
            <Border BackgroundColor="#0A8491"
                    StrokeThickness="0"
                    WidthRequest="54"
                    HeightRequest="54"
                    Margin="16,0,16,76"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    ZIndex="25"
                    Shadow="{Shadow Brush=Black, Offset='0,6', Radius=10, Opacity=0.25}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsPeopleSheetOpen}" Value="True">
                        <Setter Property="Margin" Value="16,0,16,232" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
                </Border.GestureRecognizers>
                <Path Data="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z"
                      Fill="White"
                      Aspect="Uniform"
                      WidthRequest="24"
                      HeightRequest="24"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>

            <Label Text="© OpenStreetMap contributors · Maperitive" FontSize="9" TextColor="#334155"
                   BackgroundColor="#EFFFFFFF" HorizontalOptions="End" VerticalOptions="End" Margin="4,0,6,68" ZIndex="21" InputTransparent="True">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPeopleSheetOpen}" Value="True"><Setter Property="Margin" Value="4,0,6,224" /></DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- ========================================================== -->
            <!-- PEOPLE BOTTOM PANEL (Matching Safety Circles.png)         -->
            <!-- ========================================================== -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    HeightRequest="64"
                    Padding="18,14,18,6"
                    ZIndex="20"
                    Shadow="{Shadow Brush=Black, Offset='0,-4', Radius=16, Opacity=0.1}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsPeopleSheetOpen}" Value="True"><Setter Property="HeightRequest" Value="220" /></DataTrigger>
                </Border.Triggers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, *">
                    <!-- Section Title -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4,0,4,8">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding TogglePeopleSheetCommand}" /></Grid.GestureRecognizers>
                        <Label Text="People"
                               TextColor="#0D5C68"
                               FontSize="20"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding CircleMembers.Count, StringFormat='{0} people'}"
                               TextColor="#64748B"
                               FontSize="12"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="⌃" FontSize="20" TextColor="#0A8491" VerticalOptions="Center">
                            <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsPeopleSheetOpen}" Value="True"><Setter Property="Text" Value="⌄" /></DataTrigger></Label.Triggers>
                        </Label>
                    </Grid>

                    <!-- People List -->
                    <CollectionView Grid.Row="1"
                                    IsVisible="{Binding IsPeopleSheetOpen}"
                                    ItemsSource="{Binding CircleMembers}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Member details unavailable. Connect and Refresh."
                                   TextColor="#94A3B8"
                                   FontSize="13"
                                   HorizontalOptions="Center"
                                   Margin="0,20" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CircleMember">
                                <Grid Padding="2,7"
                                      ColumnDefinitions="Auto, *, Auto"
                                      ColumnSpacing="14"
                                      BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewModel.CenterOnMemberCommand, Source={x:Reference SafetyCircleRoot}, x:DataType=local:SafetyCirclePage}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Circular Avatar with Teal Border -->
                                    <Border Grid.Column="0"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            Stroke="#0A8491"
                                            StrokeThickness="3"
                                            BackgroundColor="#E6F4F2"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="24" />
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="{Binding Initials}"
                                                   TextColor="#0A8491"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding HasNoAvatarUrl}" />
                                            <Image Source="{Binding AvatarImage}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding HasAvatarUrl}" />
                                        </Grid>
                                    </Border>

                                    <!-- Member Info -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding Name}"
                                               TextColor="#0F172A"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding LocationSubtitle}"
                                               TextColor="#0A8491"
                                               FontSize="12.5"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding SinceTimeText}" TextColor="#64748B" FontSize="11" />
                                        <Label Text="{Binding BatteryText, StringFormat='Battery: {0}'}" TextColor="{Binding BatteryColor}" FontSize="11" />
                                    </VerticalStackLayout>

                                    <!-- Phone Call Action Button (Redirects to Phone App) -->
                                    <Border IsVisible="{Binding HasPhoneNumber}" Grid.Column="2"
                                            BackgroundColor="#E6F4F2"
                                            StrokeThickness="0"
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="19" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewModel.CallMemberCommand, Source={x:Reference SafetyCircleRoot}, x:DataType=local:SafetyCirclePage}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Path Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
                                              Fill="#0A8491"
                                              Aspect="Uniform"
                                              WidthRequest="18"
                                              HeightRequest="18"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

        </Grid>
        <!-- Inline Athena-style create/join/invite cards use the approved membership service. -->
        <ContentView Grid.RowSpan="3" IsVisible="{Binding IsCircleActionOpen}" BackgroundColor="#70000000" ZIndex="100">
            <Border HorizontalOptions="Center" VerticalOptions="Center" Margin="24" Padding="22" MaximumWidthRequest="360"
                    MaximumHeightRequest="520" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="White">
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding CircleDialogTitle}" TextColor="#0D5C68" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Close" Command="{Binding CloseInlineCircleActionCommand}" IsEnabled="{Binding CanEditCircleAction}" BackgroundColor="Transparent" TextColor="#64748B" Padding="4,0" FontSize="12" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding IsCreateCircleOpen}" Spacing="12" IsEnabled="{Binding CanEditCircleAction}">
                            <Label Text="Create a Circle, then share its invite code with the people you choose." TextColor="#64748B" FontSize="13" />
                            <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Padding="12,2">
                                <Entry Text="{Binding NewCircleName}" Placeholder="Circle name" MaxLength="60" TextColor="#0F172A" />
                            </Border>
                            <Button Text="Create Circle" Command="{Binding SubmitInlineCreateCommand}" BackgroundColor="#0A8491" TextColor="White" CornerRadius="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding IsJoinCircleOpen}" Spacing="12" IsEnabled="{Binding CanEditCircleAction}">
                            <Label Text="Enter the six-character invite code. A connection is required to confirm membership." TextColor="#64748B" FontSize="13" />
                            <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Padding="12,2">
                                <Entry Text="{Binding JoinInviteCode}" Placeholder="Invite code" MaxLength="6" CharacterSpacing="4" TextColor="#0F172A" />
                            </Border>
                            <Button Text="Join Circle" Command="{Binding SubmitInlineJoinCommand}" BackgroundColor="#0A8491" TextColor="White" CornerRadius="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding IsCircleInviteOpen}" Spacing="12">
                            <Label Text="{Binding CircleActionName}" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Border BackgroundColor="#E6F4F2" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16">
                                <Label Text="{Binding CircleInviteDisplay}" TextColor="#0A8491" FontSize="26" FontAttributes="Bold" CharacterSpacing="4" HorizontalTextAlignment="Center" />
                            </Border>
                            <Button Text="Copy invite code" IsVisible="{Binding HasCircleInviteCode}" Command="{Binding CopyInlineInviteCommand}" BackgroundColor="#0A8491" TextColor="White" CornerRadius="12" />
                        </VerticalStackLayout>
                        <ActivityIndicator IsRunning="{Binding IsCircleActionBusy}" IsVisible="{Binding IsCircleActionBusy}" Color="#0A8491" />
                        <Label Text="{Binding CircleActionStatus}" TextColor="#475569" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>
