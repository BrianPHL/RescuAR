<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Map"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    xmlns:models="clr-namespace:RescuAR.App.Models"
    x:Class="RescuAR.App.Views.Map.SafetyCirclePage"
    x:DataType="vm:SafetyCircleViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F2F7">

    <Grid>
        <!-- Mapsui Native Map -->
        <mapsui:MapControl x:Name="MapControl" 
                           HorizontalOptions="FillAndExpand" 
                           VerticalOptions="FillAndExpand" />

        <!-- Top Circle Selector Pill -->
        <Border BackgroundColor="White"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,50,0,0"
                Padding="16,10"
                Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.15}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleCircleDropdownCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="{Binding SelectedCircleName, FallbackValue='Select Circle'}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                <Path Data="M7 10l5 5 5-5z" Fill="#0F172A" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Circle Dropdown Overlay -->
        <ContentView IsVisible="{Binding IsCircleDropdownOpen}" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleCircleDropdownCommand}" />
            </ContentView.GestureRecognizers>
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="16,100,16,0"
                    Padding="0"
                    WidthRequest="340"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=16, Opacity=0.15}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <CollectionView ItemsSource="{Binding MyCircles}" SelectionMode="None" MaximumHeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SupabaseSafetyCircle">
                                <Grid Padding="16,12" ColumnDefinitions="Auto,*" BackgroundColor="White">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.SelectCircleCommand, Source={x:Reference MapControl}}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Path Grid.Column="0" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" Fill="#0F8068" Aspect="Uniform" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Margin="0,0,12,0"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding InviteCode, StringFormat='Invite Code: {0}'}" TextColor="#64748B" FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="No Circles Joined Yet" TextColor="#64748B" Margin="16" HorizontalOptions="Center"/>
                        </CollectionView.EmptyView>
                    </CollectionView>
                    
                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />
                    <Grid ColumnDefinitions="*,*" Padding="16" ColumnSpacing="12">
                        <Border Grid.Column="0" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CreateCircleCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="+" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Create a Circle" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding JoinCircleCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Path Data="M5 3l3.05 3.05-1.81 1.81H14v2h-7.76l1.81 1.81L5 14l-5-5.5L5 3z" Fill="#0F172A" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                <Label Text="Join a Circle" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </ContentView>

        <!-- Floating Zoom Controls -->
        <Border BackgroundColor="#F8FAFC"
                StrokeThickness="0"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="16,0,0,120"
                Padding="0"
                WidthRequest="48"
                Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.1}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="0">
                <Border BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="48">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ZoomInCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="+" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="8,0" />
                <Border BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="48">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ZoomOutCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="-" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-4,0,0"/>
                </Border>
                <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="8,0" />
                <Border BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="48">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ZoomResetCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="1x" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- Floating Chat Button for Safety Circle Group Chat -->
        <Border BackgroundColor="#0F8068"
                StrokeThickness="0"
                WidthRequest="60"
                HeightRequest="60"
                Margin="16, 16, 16, 110"
                HorizontalOptions="End"
                VerticalOptions="End"
                Shadow="{Shadow Brush=Black, Offset='0,6', Radius=10, Opacity=0.3}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
            </Border.GestureRecognizers>
            <Path Data="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z" 
                  Fill="White" 
                  Aspect="Uniform" 
                  WidthRequest="26" 
                  HeightRequest="26" 
                  HorizontalOptions="Center" 
                  VerticalOptions="Center" />
        </Border>

        <!-- People Button -->
        <Border BackgroundColor="#2D9A90"
                StrokeThickness="0"
                WidthRequest="64"
                HeightRequest="64"
                Margin="16, 16, 16, 32"
                HorizontalOptions="End"
                VerticalOptions="End"
                Shadow="{Shadow Brush=Black, Offset='0,6', Radius=10, Opacity=0.3}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding TogglePeopleSheetCommand}" />
            </Border.GestureRecognizers>
            <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" 
                  Fill="White" 
                  Aspect="Uniform" 
                  WidthRequest="28" 
                  HeightRequest="28" 
                  HorizontalOptions="Center" 
                  VerticalOptions="Center" />
        </Border>

        <!-- People Bottom Sheet Overlay -->
        <ContentView IsVisible="{Binding IsPeopleSheetOpen}" BackgroundColor="#40000000" HorizontalOptions="Fill" VerticalOptions="Fill">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding TogglePeopleSheetCommand}" />
            </ContentView.GestureRecognizers>
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    VerticalOptions="End"
                    HorizontalOptions="Fill"
                    Margin="0"
                    Padding="0"
                    HeightRequest="420"
                    Shadow="{Shadow Brush=Black, Offset='0,-4', Radius=12, Opacity=0.15}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" Padding="24,20" ColumnDefinitions="*,Auto">
                        <Label Text="People" TextColor="#64748B" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="✕" TextColor="#94A3B8" FontSize="18" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePeopleSheetCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    
                    <ScrollView Grid.Row="1" Padding="0">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CircleMembers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CircleMember">
                                    <Grid ColumnDefinitions="Auto, *" Padding="24,16">
                                        <!-- Avatar -->
                                        <Border Grid.Column="0" BackgroundColor="White" Stroke="{Binding ColorTheme}" StrokeThickness="2" WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Grid>
                                                <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                                                      Fill="{Binding ColorTheme}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Info -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0" Spacing="4">
                                            <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <Label Text="{Binding StatusText}" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                                                
                                                <!-- Battery Percentage Badge -->
                                                <Border IsVisible="{Binding HasBattery}" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="6,2" VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                        <Label Text="{Binding BatteryIcon}" FontSize="11" VerticalOptions="Center" />
                                                        <Label Text="{Binding BatteryText}" TextColor="{Binding BatteryColor}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        
                                        <BoxView Grid.ColumnSpan="2" VerticalOptions="End" HeightRequest="1" BackgroundColor="#F1F5F9" Margin="-24,0" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>