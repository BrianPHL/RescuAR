<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RescuAR.App.Views.Map"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Map"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    xmlns:models="clr-namespace:RescuAR.App.Models"
    x:Class="RescuAR.App.Views.Map.SafetyCirclePage"
    x:Name="SafetyCircleRoot"
    x:DataType="vm:SafetyCircleViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="Auto, *">

        <!-- Top App Bar / Header -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                HeightRequest="56"
                StrokeThickness="0"
                Padding="16,0"
                ZIndex="10"
                Shadow="{Shadow Brush=Black, Offset='0,2', Radius=4, Opacity=0.06}">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="RescuAR"
                       TextColor="#0F172A"
                       FontSize="16"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />

                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"
                          Fill="#334155"
                          Aspect="Uniform"
                          WidthRequest="20"
                          HeightRequest="20"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Map Area -->
        <Grid Grid.Row="1">
            <!-- Mapsui Native Map -->
            <mapsui:MapControl x:Name="MapControl" 
                               HorizontalOptions="FillAndExpand" 
                               VerticalOptions="FillAndExpand" />

            <!-- Top Circle Selector Pill -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,16,0,0"
                    Padding="16,10"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.15}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleCircleDropdownCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="{Binding SelectedCircleName, FallbackValue='Select Circle'}" 
                           TextColor="#0F172A" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center" />
                    <Path Data="M7 10l5 5 5-5z" 
                          Fill="#0F172A" 
                          Aspect="Uniform" 
                          WidthRequest="12" 
                          HeightRequest="12" 
                          VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Circle Dropdown Overlay Modal -->
            <ContentView IsVisible="{Binding IsCircleDropdownOpen}" 
                         BackgroundColor="#40000000" 
                         HorizontalOptions="Fill" 
                         VerticalOptions="Fill"
                         ZIndex="50">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleCircleDropdownCommand}" />
                </ContentView.GestureRecognizers>
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Margin="16,60,16,0"
                        Padding="0"
                        WidthRequest="340"
                        Shadow="{Shadow Brush=Black, Offset='0,8', Radius=20, Opacity=0.2}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout>
                        <!-- Modal Header -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto" BackgroundColor="#F8FAFC">
                            <Label Text="Safety Circles" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="28" HeightRequest="28">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleCircleDropdownCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="✕" TextColor="#64748B" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                        <!-- Circles List -->
                        <CollectionView ItemsSource="{Binding MyCircles}" SelectionMode="None" MaximumHeightRequest="240">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SupabaseSafetyCircle">
                                        <SwipeView Threshold="40">
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal">
                                                    <SwipeItemView Command="{Binding ViewModel.DeleteCircleCommand, Source={x:Reference SafetyCircleRoot}, x:DataType=local:SafetyCirclePage}"
                                                                   CommandParameter="{Binding .}">
                                                        <Border BackgroundColor="#EF4444" WidthRequest="74" StrokeThickness="0" Margin="4,0,0,0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8" />
                                                            </Border.StrokeShape>
                                                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                                      Fill="White" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center"/>
                                                                <Label Text="Delete" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </SwipeItemView>
                                                </SwipeItems>
                                            </SwipeView.RightItems>
                                            <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto" BackgroundColor="White">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ViewModel.SelectCircleFromListCommand, Source={x:Reference SafetyCircleRoot}, x:DataType=local:SafetyCirclePage}" CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                
                                                <!-- Circle Icon -->
                                                <Border Grid.Column="0" BackgroundColor="#E6F4F2" StrokeThickness="0" WidthRequest="38" HeightRequest="38" Margin="0,0,12,0" VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" 
                                                          Fill="#0A8491" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                                
                                                <!-- Circle Info -->
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                                    <Label Text="{Binding InviteCode, StringFormat='Invite Code: {0}'}" TextColor="#64748B" FontSize="11" />
                                                </VerticalStackLayout>

                                                <!-- Direct Delete Action -->
                                                <Border Grid.Column="2" BackgroundColor="#FEE2E2" StrokeThickness="0" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ViewModel.DeleteCircleCommand, Source={x:Reference SafetyCircleRoot}, x:DataType=local:SafetyCirclePage}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                          Fill="#DC2626" Aspect="Uniform" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                            </Grid>
                                        </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="No Circles Joined Yet" TextColor="#64748B" Margin="16" HorizontalOptions="Center"/>
                            </CollectionView.EmptyView>
                        </CollectionView>
                        
                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*" Padding="14" ColumnSpacing="10" BackgroundColor="#F8FAFC">
                            <Border Grid.Column="0" Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="White" Padding="10,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CreateCircleCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <Label Text="+" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="Create Circle" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="White" Padding="10,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding JoinCircleCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <Path Data="M5 3l3.05 3.05-1.81 1.81H14v2h-7.76l1.81 1.81L5 14l-5-5.5L5 3z" Fill="#0F172A" Aspect="Uniform" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
                                    <Label Text="Join Circle" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </ContentView>

            <!-- Floating Zoom Controls -->
            <Border BackgroundColor="#F8FAFC"
                    StrokeThickness="0"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="16,0,0,232"
                    Padding="0"
                    WidthRequest="44"
                    ZIndex="25"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.1}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Border BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ZoomInCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="6,0" />
                    <Border BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ZoomOutCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="-" TextColor="#0F172A" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-3,0,0"/>
                    </Border>
                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="6,0" />
                    <Border BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ZoomResetCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="1x" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Single Floating Chat Action Button for Safety Circle Group Chat -->
            <Border BackgroundColor="#0A8491"
                    StrokeThickness="0"
                    WidthRequest="54"
                    HeightRequest="54"
                    Margin="16,0,16,232"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    ZIndex="25"
                    Shadow="{Shadow Brush=Black, Offset='0,6', Radius=10, Opacity=0.25}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
                </Border.GestureRecognizers>
                <Path Data="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z" 
                      Fill="White" 
                      Aspect="Uniform" 
                      WidthRequest="24" 
                      HeightRequest="24" 
                      HorizontalOptions="Center" 
                      VerticalOptions="Center" />
            </Border>

            <!-- ========================================================== -->
            <!-- PEOPLE BOTTOM PANEL (Matching Safety Circles.png)         -->
            <!-- ========================================================== -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    HeightRequest="220"
                    Padding="18,14,18,6"
                    ZIndex="20"
                    Shadow="{Shadow Brush=Black, Offset='0,-4', Radius=16, Opacity=0.1}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, *">
                    <!-- Section Title -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,8">
                        <Label Text="People"
                               TextColor="#0D5C68"
                               FontSize="20"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding CircleMembers.Count, StringFormat='{0} active'}"
                               TextColor="#64748B"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- People List -->
                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding CircleMembers}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No members in circle yet."
                                   TextColor="#94A3B8"
                                   FontSize="13"
                                   HorizontalOptions="Center"
                                   Margin="0,20" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CircleMember">
                                <Grid Padding="2,7"
                                      ColumnDefinitions="Auto, *, Auto"
                                      ColumnSpacing="14"
                                      BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewModel.CenterOnMemberCommand, Source={x:Reference SafetyCircleRoot}, x:DataType=local:SafetyCirclePage}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Circular Avatar with Teal Border -->
                                    <Border Grid.Column="0"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            Stroke="#0A8491"
                                            StrokeThickness="3"
                                            BackgroundColor="#E6F4F2"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="24" />
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="{Binding Initials}"
                                                   TextColor="#0A8491"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding HasNoAvatarUrl}" />
                                            <Image Source="{Binding AvatarUrl}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding HasAvatarUrl}" />
                                        </Grid>
                                    </Border>

                                    <!-- Member Info -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding Name}"
                                               TextColor="#0F172A"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding LocationSubtitle}"
                                               TextColor="#0A8491"
                                               FontSize="12.5"
                                               LineBreakMode="TailTruncation" />
                                        <!-- Status & Battery Row with Dedicated Battery Vector Icon -->
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding SinceTimeText}"
                                                   TextColor="#64748B"
                                                   FontSize="11"
                                                   VerticalOptions="Center" />
                                            <Label Text="•"
                                                   TextColor="#94A3B8"
                                                   FontSize="11"
                                                   VerticalOptions="Center" />
                                            
                                            <!-- Dedicated Battery Vector Icon -->
                                            <Path Data="M15.67,4H14V2H10V4H8.33C7.6,4 7,4.6 7,5.33V20.67C7,21.4 7.6,22 8.33,22H15.67C16.4,22 17,21.4 17,20.67V5.33C17,4.6 16.4,4 15.67,4Z"
                                                  Fill="{Binding BatteryColor}"
                                                  Aspect="Uniform"
                                                  WidthRequest="9"
                                                  HeightRequest="13"
                                                  VerticalOptions="Center" />
                                            
                                            <Label Text="{Binding BatteryText}"
                                                   TextColor="{Binding BatteryColor}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Phone Call Action Button (Redirects to Phone App) -->
                                    <Border Grid.Column="2"
                                            BackgroundColor="#E6F4F2"
                                            StrokeThickness="0"
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="19" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewModel.CallMemberCommand, Source={x:Reference SafetyCircleRoot}, x:DataType=local:SafetyCirclePage}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Path Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
                                              Fill="#0A8491"
                                              Aspect="Uniform"
                                              WidthRequest="18"
                                              HeightRequest="18"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <!-- Custom "Circle Created!" Modal Dialog with Copy Button -->
            <ContentView IsVisible="{Binding IsCreatedCirclePopupOpen}" 
                         BackgroundColor="#70000000" 
                         HorizontalOptions="Fill" 
                         VerticalOptions="Fill"
                         ZIndex="100">
                <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Margin="24"
                            Padding="24"
                            WidthRequest="320"
                            Shadow="{Shadow Brush=Black, Offset='0,12', Radius=24, Opacity=0.3}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                            <!-- Shield Success Icon -->
                            <Border BackgroundColor="#E6F4F5"
                                    StrokeThickness="0"
                                    WidthRequest="56"
                                    HeightRequest="56"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>
                                <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                                      Fill="#0A8491"
                                      Aspect="Uniform"
                                      WidthRequest="28"
                                      HeightRequest="28"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="Safety Circle Created!"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding NewlyCreatedCircleName}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#0A8491"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Share this 6-character code with your family or friends to join:"
                                       FontSize="12"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,4,0,0" />
                            </VerticalStackLayout>

                            <!-- Invite Code Pill Card -->
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    BackgroundColor="#F8FAFC"
                                    Padding="16,10"
                                    HorizontalOptions="Fill">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="{Binding NewlyCreatedInviteCode}"
                                           FontSize="26"
                                           FontAttributes="Bold"
                                           TextColor="#0A8491"
                                           CharacterSpacing="4"
                                           HorizontalTextAlignment="Center" />

                                    <!-- Copy Button with Vector SVG Icon -->
                                    <Button Command="{Binding CopyInviteCodeCommand}"
                                            HeightRequest="36"
                                            Padding="14,0"
                                            CornerRadius="8"
                                            BackgroundColor="#E6F4F5"
                                            TextColor="#0A8491"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center">
                                        <Button.Text>
                                            <MultiBinding StringFormat="{}{0}">
                                                <Binding Path="IsCopiedSuccess" Converter="{StaticResource BooleanToStringConverter}" ConverterParameter="✓ Copied to Clipboard!:Copy Invite Code" />
                                            </MultiBinding>
                                        </Button.Text>
                                    </Button>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Done Button -->
                            <Button Text="Done"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    BackgroundColor="#0A8491"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    HorizontalOptions="Fill"
                                    Command="{Binding CloseCreatedCirclePopupCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ContentView>

            <!-- ========================================================== -->
            <!-- FIRST TIME TUTORIAL / GUIDE WIZARD POPUP MODAL             -->
            <!-- ========================================================== -->
            <ContentView IsVisible="{Binding IsTutorialPopupVisible}"
                         ZIndex="120"
                         BackgroundColor="#80000000"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill">
                <Grid Padding="24" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="420">
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="24,20"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#40000000" Offset="0,6" Radius="16" Opacity="0.3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <!-- Header -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                <Border BackgroundColor="#E6F4F2" StrokeThickness="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                          Fill="#0A8491" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Welcome to Safety Circles" FontSize="17" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Text="Quick Guide to Real-Time Safety" FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Features List -->
                            <VerticalStackLayout Spacing="10">
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                        <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                              Fill="#0A8491" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="Create or Join circles with your family using an Invite Code." FontSize="12" TextColor="#334155" />
                                    </Grid>
                                </Border>

                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                        <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                              Fill="#0A8491" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="View real-time member locations on the live map." FontSize="12" TextColor="#334155" />
                                    </Grid>
                                </Border>

                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                        <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                              Fill="#0A8491" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="Chat instantly with circle members during emergencies." FontSize="12" TextColor="#334155" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Close Button -->
                            <Button Text="Got it, Let's Start"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    BackgroundColor="#0A8491"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    HorizontalOptions="Fill"
                                    Command="{Binding CloseTutorialCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ContentView>

            <!-- ========================================================== -->
            <!-- CUSTOM STYLED DELETE CONFIRMATION MODAL OVERLAY            -->
            <!-- ========================================================== -->
            <ContentView IsVisible="{Binding IsDeleteConfirmPopupVisible}"
                         ZIndex="130"
                         BackgroundColor="#80000000"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill">
                <Grid Padding="24" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="400">
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="24,20"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#40000000" Offset="0,6" Radius="16" Opacity="0.3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <!-- Warning Icon -->
                            <Border BackgroundColor="#FEE2E2" StrokeThickness="0" WidthRequest="52" HeightRequest="52" HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                      Fill="#DC2626" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="Delete Safety Circle?" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding CircleToDelete.Name, StringFormat='Are you sure you want to remove \x22{0}\x22?'}" FontSize="13" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center" />
                                <Label Text="You will leave this group and lose access to its member tracking and chat history." FontSize="12.5" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <!-- Actions -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                <Button Grid.Column="0"
                                        Text="Cancel"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#475569"
                                        BackgroundColor="#F1F5F9"
                                        CornerRadius="10"
                                        HeightRequest="44"
                                        Command="{Binding CancelDeleteCircleCommand}" />

                                <Button Grid.Column="1"
                                        Text="Delete Circle"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        BackgroundColor="#DC2626"
                                        CornerRadius="10"
                                        HeightRequest="44"
                                        Command="{Binding ConfirmDeleteCircleCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ContentView>
        </Grid>
    </Grid>
</ContentPage>