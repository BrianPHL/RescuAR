<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RescuAR.App.Views.Camera.CameraPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:evergine="clr-namespace:RescuAR.MAUI.Evergine"
    xmlns:camera="clr-namespace:RescuAR.App.Views.Camera"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    Title="Camera"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#078F99"
    Shell.TabBarTitleColor="#078F99"
    Shell.TabBarUnselectedColor="#7D7D7D">

    <!--
        Camera module UI refinement aligned to the supplied Figma prototype.
        All ordinary interface glyphs in this page now use Lucide-compatible
        SVG assets rather than Unicode symbols or hand-drawn substitutes.
    -->
    <Grid RowDefinitions="56,Auto,*">

        <!-- ============================================================= -->
        <!-- TOP APP BAR                                                   -->
        <!-- ============================================================= -->
        <Grid
            Grid.Row="0"
            ZIndex="200"
            BackgroundColor="White"
            Padding="12,0"
            ColumnDefinitions="68,*,34,34"
            ColumnSpacing="0">

            <Grid
                x:Name="cameraHeaderBackGroup"
                Grid.Column="0"
                ColumnDefinitions="18,*"
                ColumnSpacing="1"
                VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCameraHeaderBackClicked" />
                </Grid.GestureRecognizers>
                <Image
                    Source="lucide_chevron_left_black.png"
                    WidthRequest="16"
                    HeightRequest="16"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="Back"
                    TextColor="#121212"
                    FontSize="11"
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center" />
            </Grid>

            <Label
                Grid.Column="1"
                Text="RescuAR"
                TextColor="#111111"
                FontSize="11"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Border
                Grid.Column="2"
                WidthRequest="34"
                HeightRequest="34"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCameraSettingsClicked" />
                </Border.GestureRecognizers>
                <Image
                    Source="lucide_settings_black.png"
                    WidthRequest="18"
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Border
                Grid.Column="3"
                WidthRequest="34"
                HeightRequest="34"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCameraNotificationsClicked" />
                </Border.GestureRecognizers>
                <Image
                    Source="lucide_bell_black.png"
                    WidthRequest="18"
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <BoxView
                Grid.ColumnSpan="4"
                HeightRequest="1"
                BackgroundColor="#E8EAEC"
                VerticalOptions="End" />
        </Grid>

        <!-- ============================================================= -->
        <!-- NAVIGATION SUB-TABS SEGMENT (AR / 2D MAP / FLOOD DEPTH)       -->
        <!-- ============================================================= -->
        <Grid
            Grid.Row="1"
            ZIndex="201"
            RowDefinitions="Auto,Auto"
            BackgroundColor="#FFFFFF"
            Padding="12,4,12,6">
            <Border
                BackgroundColor="#F1F5F9"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="3">
                <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="4" MinimumHeightRequest="38">
                    <!-- Tab 1: AR Evacuation Guidance -->
                    <Border
                        x:Name="subTabArButton"
                        Grid.Column="0"
                        BackgroundColor="#0A8491"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 7"
                        Padding="4,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnArCameraModeClicked" />
                        </Border.GestureRecognizers>
                        <Label
                            x:Name="subTabArLabel"
                            Text="AR Route"
                            TextColor="#FFFFFF"
                            FontSize="11.5"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Tab 2: 2D Map Guidance -->
                    <Border
                        x:Name="subTabMapButton"
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 7"
                        Padding="4,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMapModeClicked" />
                        </Border.GestureRecognizers>
                        <Label
                            x:Name="subTabMapLabel"
                            Text="2D Map"
                            TextColor="#64748B"
                            FontSize="11.5"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Tab 3: Flood Depth Visualization -->
                    <Border
                        x:Name="subTabFloodButton"
                        Grid.Column="2"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 7"
                        Padding="4,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFloodDepthModeClicked" />
                        </Border.GestureRecognizers>
                        <Label
                            x:Name="subTabFloodLabel"
                            Text="Flood Depth"
                            TextColor="#64748B"
                            FontSize="11.5"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <Border x:Name="cameraVoiceGuidanceButton" Grid.Column="3" WidthRequest="38" HeightRequest="38"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            BackgroundColor="#ECFFFFFF" Stroke="#F4FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 7" IsVisible="False">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVoiceGuidanceToggleClicked" />
                        </Border.GestureRecognizers>
                        <Image x:Name="cameraVoiceGuidanceIcon" Source="lucide_volume_x_black.png" InputTransparent="True"
                               WidthRequest="23" HeightRequest="23" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
            <Label x:Name="navigationFeedbackStatusLabel" Grid.Row="1" IsVisible="False" FontSize="11" TextColor="#B45309" Margin="4,4,4,0" />
        </Grid>

        <!-- ============================================================= -->
        <!-- CAMERA / AR WORKSPACE                                         -->
        <!-- ============================================================= -->
        <Grid
            x:Name="cameraWorkspace"
            Grid.Row="2"
            BackgroundColor="Black">

            <evergine:EvergineView
                x:Name="evergineView"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!--
                V7 depth-aware flood compositor.
                ARCore depth decides which visible real-world pixels are below
                the selected metric water surface. This prevents the flood
                tint from covering desks/chairs/monitors that are above water.
            -->
            <camera:FloodDepthOcclusionView
                x:Name="floodDepthOcclusionView"
                ZIndex="5"
                InputTransparent="True"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!-- 2D Map submodule: Full OSM & GeoJSON 2D Evacuation Map -->
            <Grid
                x:Name="mapModeLayer"
                IsVisible="False"
                ZIndex="6"
                BackgroundColor="#F4F5F6">
                <mapsui:MapControl x:Name="CameraMapControl"
                                   HorizontalOptions="FillAndExpand"
                                   VerticalOptions="FillAndExpand" />
                <Border VerticalOptions="End" Margin="8,8,8,12" Padding="8" StrokeShape="RoundRectangle 10" BackgroundColor="#F2FFFFFF" Stroke="#CBD5E1">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="mapModeStatusLabel" FontSize="10" TextColor="#334155" />
                        <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="4">
                            <Button Text="Recenter" Clicked="OnCameraMapRecenterClicked" FontSize="11" Padding="8,0" BackgroundColor="#E6F4F2" TextColor="#0A8491" />
                            <Button Grid.Column="1" Text="Overview" Clicked="OnCameraMapOverviewClicked" FontSize="11" Padding="8,0" BackgroundColor="#E6F4F2" TextColor="#0A8491" />
                            <Button Grid.Column="2" Text="Search" Clicked="OnOpenCenterSearchOverlayClicked" FontSize="11" Padding="8,0" BackgroundColor="#E6F4F2" TextColor="#0A8491" />
                            <Button Grid.Column="3" x:Name="mapReturnToRouteButton" Text="Active route" Clicked="OnCameraMapReturnToRouteClicked" IsVisible="False" FontSize="11" Padding="8,0" BackgroundColor="#E6F4F2" TextColor="#0A8491" />
                        </Grid>
                        <Label Text="© OpenStreetMap contributors · Maperitive" FontSize="9" TextColor="#64748B" HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 2D Map Google Maps Style Route Search Card -->
            <!-- 2D Map Google Maps Style Route Search Card -->
            <Border
                x:Name="mapRouteSearchCard"
                IsVisible="False"
                ZIndex="25"
                Margin="12,12,12,0"
                Padding="14,12"
                VerticalOptions="Start"
                BackgroundColor="#FFFFFF"
                Stroke="#CBD5E1"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,4" Radius="12" Opacity="0.16" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <!-- Card Header -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#0A8491" VerticalOptions="Center" />
                            <Label Text="Evacuation Route Planner" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2">
                            <Label Text="2D MAP" TextColor="#0A8491" FontSize="9.5" FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <!-- From / To Inputs with Google Maps vertical connector -->
                    <Grid Grid.Row="1" ColumnDefinitions="20,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <!-- Left indicator track: Dot -> Line -> Pin -->
                        <Grid Grid.RowSpan="2" HorizontalOptions="Center" VerticalOptions="Fill">
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="#0A8491" VerticalOptions="Start" Margin="0,10,0,0" />
                            <BoxView WidthRequest="2" BackgroundColor="#CBD5E1" VerticalOptions="Fill" Margin="0,22,0,22" />
                            <Path Data="M12,2A8,8 0 0,0 4,10C4,15.25 12,22 12,22C12,22 20,15.25 20,10A8,8 0 0,0 12,2M12,6A4,4 0 0,1 16,10A4,4 0 0,1 12,14A4,4 0 0,1 8,10A4,4 0 0,1 12,6Z"
                                  Fill="#DC2626" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="End" Margin="0,0,0,8" />
                        </Grid>

                        <!-- FROM: Current Location (auto-detected) -->
                        <Border Grid.Row="0" Grid.Column="1" Padding="10,7" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="FROM" TextColor="#64748B" FontSize="9" FontAttributes="Bold" />
                                    <Label x:Name="mapFromLocationLabel" Text="Current location unknown" TextColor="#0F172A" FontSize="12" LineBreakMode="WordWrap" />
                                    <Label x:Name="mapLocationNoticeLabel" Text="Waiting for a current validated GPS fix." TextColor="#64748B" FontSize="10" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="lucide_arrow_up_teal.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- TO: Stylized Destination Place Picker + Search Icon Button -->
                        <Border Grid.Row="1" Grid.Column="1" Padding="10,6" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenCenterSearchOverlayClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="TO (DESTINATION SHELTER)" TextColor="#64748B" FontSize="9" FontAttributes="Bold" />
                                    <Label x:Name="mapDestinationSelectedLabel"
                                           Text="Select Evacuation Center..."
                                           TextColor="#94A3B8"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- Dedicated Search Icon Button -->
                                <Border Grid.Column="1" WidthRequest="32" HeightRequest="32" BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 16" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOpenCenterSearchOverlayClicked" />
                                    </Border.GestureRecognizers>
                                    <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Fill="#0A8491" WidthRequest="15" HeightRequest="15" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <Image Grid.Column="2" Source="lucide_chevron_down_black.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" InputTransparent="True" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Start Routing Action Button inside card -->
                    <Button
                        Grid.Row="2"
                        x:Name="mapCardStartRoutingButton"
                        Text="Start Routing"
                        ImageSource="lucide_arrow_up_white.png"
                        ContentLayout="Left,8"
                        TextColor="#FFFFFF"
                        BackgroundColor="#0A8491"
                        FontAttributes="Bold"
                        FontSize="13.5"
                        HeightRequest="42"
                        CornerRadius="10"
                        Clicked="OnStartRoutingClicked" />
                </Grid>
            </Border>

            <!-- 2D Map Minimized Route Overview Bar (Google Maps Style) -->
            <Border
                x:Name="mapRouteSummaryPanel"
                IsVisible="False"
                ZIndex="25"
                Margin="12,12,12,0"
                Padding="12,8"
                VerticalOptions="Start"
                BackgroundColor="#FFFFFF"
                Stroke="#CBD5E1"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,4" Radius="10" Opacity="0.14" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <!-- Route icon -->
                    <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                        <Image Source="lucide_arrow_up_teal.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <!-- Destination & Distance/Time Stats -->
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label x:Name="mapRouteDestinationNameLabel" Text="To: Evacuation Center" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        <Label x:Name="mapRouteStatsLabel" Text="Preparing route…" TextColor="#0A8491" FontSize="11" FontAttributes="Bold" />
                        <Label x:Name="mapCurrentGuidanceLabel" Text="Waiting for accepted guidance." TextColor="#0F172A" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="mapCurrentDistanceLabel" Text="" TextColor="#64748B" FontSize="11" />
                        <Button x:Name="mapRetryRouteButton" Text="Retry route" Clicked="OnCameraMapRetryRouteClicked" IsVisible="False" FontSize="11" Padding="8,0" BackgroundColor="#E6F4F2" TextColor="#0A8491" />
                    </VerticalStackLayout>

                    <!-- Action buttons: Steps & Stop Guidance -->
                    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                        <Button Text="Steps" TextColor="#0A8491" BackgroundColor="#F0FDFA" BorderColor="#CCFBF1" BorderWidth="1" CornerRadius="8" HeightRequest="32" FontSize="11" FontAttributes="Bold" Padding="8,0"
                                Clicked="OnRouteDirectionsButtonClicked" />
                        <Button Text="Stop" TextColor="#FFFFFF" BackgroundColor="#DC2626" CornerRadius="8" HeightRequest="32" FontSize="11" FontAttributes="Bold" Padding="10,0"
                                Clicked="OnEndNavigationClicked" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- 2D Map Google Maps-Style Evacuation Center Search Sheet / Modal -->
            <Grid
                x:Name="mapCenterSearchOverlay"
                IsVisible="False"
                ZIndex="75"
                BackgroundColor="#80000000"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <Border
                    Margin="0,40,0,0"
                    Padding="16,14"
                    BackgroundColor="#FFFFFF"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20 20 0 0"
                    VerticalOptions="FillAndExpand">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                        <!-- Header bar with back button & Search Entry -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCloseCenterSearchOverlayClicked" />
                                </Border.GestureRecognizers>
                                <Image Source="lucide_chevron_left_black.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Google Maps style Search Bar -->
                            <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="12,0" HeightRequest="44">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Fill="#64748B" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           x:Name="centerModalSearchEntry"
                                           Placeholder="Search evacuation-center names…"
                                           PlaceholderColor="#94A3B8"
                                           TextColor="#0F172A"
                                           FontSize="13.5"
                                           TextChanged="OnCenterModalSearchTextChanged"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="2" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" StrokeThickness="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnClearCenterSearchClicked" />
                                        </Border.GestureRecognizers>
                                        <Image Source="lucide_x_gray.png" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Button Grid.Column="2" Text="Cancel" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent" Padding="4,0"
                                    Clicked="OnCloseCenterSearchOverlayClicked" />
                        </Grid>

                        <!-- Section Title -->
                        <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="4,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Evacuation-center directory" TextColor="#64748B" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Refresh" Clicked="OnCameraDirectoryRefreshClicked" BackgroundColor="Transparent" TextColor="#0A8491" FontSize="11" Padding="8,0" />
                            </Grid>
                            <Label x:Name="mapSearchOrderLabel" Text="Loading directory…" TextColor="#64748B" FontSize="10.5" />
                        </VerticalStackLayout>

                        <!-- Search Results CollectionView -->
                        <CollectionView
                            Grid.Row="2"
                            x:Name="centerSearchResultsView"
                            SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label x:Name="cameraDirectoryEmptyLabel" Text="No evacuation centers listed." TextColor="#64748B" Padding="12" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="camera:ShelterSearchDisplayItem">
                                    <Border Margin="0,4" Padding="12,10" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnShelterSearchResultSelected" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                            <!-- Safe Haven Icon -->
                                            <Border WidthRequest="36" HeightRequest="36" BackgroundColor="#E6F4F2" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                                <Image Source="lucide_shield_check_white.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>

                                            <!-- Name & Info -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="13.5" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding DetailsText}" TextColor="#64748B" FontSize="11" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <!-- Distance & Badge -->
                                            <Border Grid.Column="2" Padding="8,4" BackgroundColor="#F0FDFA" Stroke="#CCFBF1" StrokeThickness="1" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                                                <Label Text="{Binding DistanceText}" TextColor="#0A8491" FontSize="11.5" FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Keep the native surface running beneath an opaque startup cover. -->
            <Grid x:Name="cameraStartupOverlay" ZIndex="70" BackgroundColor="#0B132B"
                  HorizontalOptions="Fill" VerticalOptions="Fill">
                <VerticalStackLayout Padding="28" Spacing="12" MaximumWidthRequest="360"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator x:Name="cameraStartupSpinner" IsRunning="True" Color="#5ED4D8"
                                       WidthRequest="42" HeightRequest="42" HorizontalOptions="Center" />
                    <Label x:Name="cameraStartupTitle" Text="Starting AR camera…" TextColor="White"
                           FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label x:Name="cameraStartupMessage"
                           Text="The live view will appear as soon as the camera is ready."
                           TextColor="#CBD5E1" FontSize="13" HorizontalTextAlignment="Center" />
                    <Label Text="You can switch to 2D Map at any time." TextColor="#94A3B8"
                           FontSize="12" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Route Calculation Loading Screen Overlay -->
            <Grid
                x:Name="routeCalculatingOverlay"
                IsVisible="False"
                ZIndex="90"
                BackgroundColor="#66000000"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <Border
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="24,20"
                    BackgroundColor="#FFFFFF"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    MaximumWidthRequest="320">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,6" Radius="16" Opacity="0.25" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                        <ActivityIndicator IsRunning="True" Color="#0A8491" WidthRequest="42" HeightRequest="42" HorizontalOptions="Center" />
                        <Label Text="Preparing pedestrian route…" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Using the existing destination and hazard-aware routing flow." TextColor="#64748B" FontSize="11.5" HorizontalTextAlignment="Center" />
                        <Button Text="Cancel navigation" Clicked="OnEndNavigationClicked" BackgroundColor="#E2E8F0" TextColor="#334155" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- AR CAMERA STATUS + TURN GUIDANCE                          -->
            <!-- ========================================================= -->
            <VerticalStackLayout
                x:Name="arNavigationOverlays"
                ZIndex="23"
                Margin="8,8,8,0"
                Spacing="6"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                InputTransparent="True"
                CascadeInputTransparent="False">
                <Border
                    x:Name="cameraModeStatusBanner"
                    ZIndex="20"
                    Margin="0"
                    Padding="8,4"
                    MinimumHeightRequest="34"
                    VerticalOptions="Start"
                    BackgroundColor="#DDF7E8"
                    Stroke="#BDE9D0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5">
                    <Grid>
