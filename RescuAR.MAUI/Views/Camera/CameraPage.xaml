                                        WidthRequest="17"
                                        HeightRequest="17"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Grid>

                                <BoxView Grid.Row="1" BackgroundColor="#E5E5E5" />

                                <Grid Grid.Row="2" Padding="10,6" ColumnDefinitions="34,*,24">
