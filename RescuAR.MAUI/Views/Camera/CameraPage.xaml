<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RescuAR.App.Views.Camera.CameraPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:evergine="clr-namespace:RescuAR.MAUI.Evergine"
    Title="Camera"
    BackgroundColor="Black">

    <Grid>
        <evergine:EvergineView
            x:Name="evergineView"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!--
            Milestone 3 pedestrian turn guidance.
            InputTransparent keeps the overlay from interfering with AR touch
            handling or MAUI navigation gestures.
        -->
        <Border
            x:Name="turnGuidancePanel"
            IsVisible="False"
            InputTransparent="True"
            ZIndex="10"
            Margin="16,18,16,0"
            Padding="16,10"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            BackgroundColor="#CC111111"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout
                Spacing="2"
                HorizontalOptions="Center">
                <Label
                    x:Name="turnInstructionLabel"
                    Text="Continue straight"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="turnDistanceLabel"
                    Text=""
                    TextColor="#E6FFFFFF"
                    FontSize="13"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <!--
            Stage 5 Safe Zone Confirmation.
            Full-screen completion state aligned with the approved green
            safe-zone UI direction. It is intentionally hidden until repeated
            GPS + route-progress checks confirm arrival.
        -->
        <Grid
            x:Name="safeZoneConfirmationOverlay"
            IsVisible="False"
            ZIndex="100"
            BackgroundColor="#F20C6B43"
            Padding="28">

            <VerticalStackLayout
                Spacing="16"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="420">

                <Border
                    WidthRequest="96"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    BackgroundColor="#26FFFFFF"
                    Stroke="#B3FFFFFF"
                    StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="48" />
                    </Border.StrokeShape>
                    <Label
                        Text="✓"
                        TextColor="White"
                        FontSize="58"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                </Border>

                <Label
                    Text="You've Reached a Safe Zone"
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="safeZoneDestinationLabel"
                    Text="Evacuation Center"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="safeZoneDetailsLabel"
                    Text="Arrival confirmed."
                    TextColor="#E6FFFFFF"
                    FontSize="14"
                    HorizontalTextAlignment="Center" />

                <Button
                    Text="Finish Navigation"
                    Margin="0,12,0,0"
                    Padding="18,12"
                    BackgroundColor="White"
                    TextColor="#0C6B43"
                    FontAttributes="Bold"
                    Clicked="OnFinishNavigationClicked" />
            </VerticalStackLayout>
        </Grid>

        <!--
            TEMPORARY developer validation controls.
            Stage 5 safe-zone validation is enabled for the current test build;
            the older Milestone 3 controls remain disabled.
        -->
        <VerticalStackLayout
            ZIndex="20"
            Margin="20,0,20,28"
            Spacing="8"
            HorizontalOptions="Center"
            VerticalOptions="End">

            <Button
                x:Name="developerSafeZoneTestButton"
                Text="DEV: Arm Safe Zone Test"
                IsVisible="False"
                Padding="14,10"
                BackgroundColor="#CC0C6B43"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnDeveloperSafeZoneTestClicked" />

            <Button
                x:Name="developerTurnTestButton"
                Text="DEV: Validate Turn States"
                IsVisible="False"
                Padding="14,10"
                BackgroundColor="#CC1F4F7A"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnDeveloperTurnTestClicked" />

            <Button
                x:Name="developerRerouteTestButton"
                Text="DEV: Simulate Off-Route Reroute"
                IsVisible="False"
                Padding="14,10"
                BackgroundColor="#CC7A1F1F"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnDeveloperRerouteTestClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
