                <Border x:Name="floodDepthModeControlPanel"><Label x:Name="floodModeDepthSummaryLabel" /></Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- STAGE 6 EMERGENCY ALERT OVERLAY                           -->
            <!-- ========================================================= -->
            <Grid
                x:Name="emergencyAdvisoryOverlay"
                IsVisible="False"
                ZIndex="80"
                BackgroundColor="#D0B00000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border
                        x:Name="emergencyAdvisoryTopBanner"
                        Grid.Row="0"
                        Margin="8,8,8,0"
                        Padding="8,4"
                        BackgroundColor="#70FF5A5A"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                            <Label
                                Text="Emergency Detected"
                                TextColor="#8E1010"
                                FontSize="10"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                x:Name="emergencyAdvisoryTopSeverityLabel"
                                Text="Flood Advisory - High Severity"
                                TextColor="#8E1010"
                                FontSize="8.5"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout
                            Padding="20,6,20,4"
                            Spacing="8"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center">

                            <!-- Figma flood hero: Lucide ArrowUp + Waves. -->
                            <Grid
                                x:Name="emergencyFloodIcon"
                                IsVisible="False"
                                WidthRequest="124"
                                HeightRequest="106"
                                HorizontalOptions="Center">
                                <Image
                                    Source="lucide_arrow_up_white.png"
                                    WidthRequest="58"
                                    HeightRequest="58"
                                    Margin="0,0,0,34"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <Image
                                    Source="lucide_waves_white.png"
                                    WidthRequest="120"
                                    HeightRequest="58"
                                    Margin="0,48,0,0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Grid>

                            <Image
                                x:Name="emergencyEarthquakeIcon"
                                IsVisible="False"
                                Source="lucide_activity_white.png"
                                WidthRequest="112"
                                HeightRequest="92"
                                HorizontalOptions="Center" />

                            <Image
                                x:Name="emergencyGenericIcon"
                                IsVisible="True"
                                Source="lucide_triangle_alert_white.png"
                                WidthRequest="92"
                                HeightRequest="80"
                                HorizontalOptions="Center" />

                            <Label
                                x:Name="emergencyAdvisoryHeroTitleLabel"
                                Text="Emergency Nearby!"
                                TextColor="White"
                                FontSize="31"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.02" />
                            <Label
                                x:Name="emergencyAdvisoryBodySeverityLabel"
                                Text="Emergency Advisory - High Severity"
                                TextColor="White"
                                FontSize="11"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                x:Name="emergencyAdvisoryBodyMessageLabel"
                                Text="Follow the latest verified emergency guidance."
                                TextColor="White"
                                FontSize="12.5"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                LineHeight="1.1"
                                Margin="8,12,8,0" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <VerticalStackLayout
                        Grid.Row="2"
                        Padding="18,0,18,12"
                        Spacing="5">
                        <Label
                            x:Name="emergencyAdvisoryCountdownLabel"
                            IsVisible="False"
                            Text="Popup will close in 5 seconds. AR Evacuation Guidance will proceed..."
                            TextColor="#F7FFFFFF"
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />
                        <Button
                            x:Name="emergencyStartGuidanceButton"
                            Text="Start AR Evacuation Guidance"
                            ImageSource="lucide_chevron_right_white.png"
                            ContentLayout="Right,8"
                            HeightRequest="42"
                            CornerRadius="6"
                            BackgroundColor="#FF3B43"
                            TextColor="White"
                            FontSize="12"
                            FontAttributes="Bold"
                            Clicked="OnEmergencyStartGuidanceClicked" />
                        <Button
                            x:Name="emergencyDismissButton"
                            Text="Dismiss"
                            HeightRequest="32"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            Clicked="OnEmergencyAdvisoryCloseClicked" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- STAGE 5 SAFE ZONE CONFIRMATION                            -->
            <!-- ========================================================= -->
            <Grid
                x:Name="safeZoneConfirmationOverlay"
                IsVisible="False"
                ZIndex="100"
                BackgroundColor="#CE0F7C49"
                Padding="22,18">
                <VerticalStackLayout
                    Spacing="5"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MaximumWidthRequest="420">

                    <Image
                        Source="lucide_shield_check_white.png"
                        WidthRequest="104"
                        HeightRequest="104"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="safeZoneTitleLabel"
                        Text="You're Near the&#10;Evacuation Center"
                        TextColor="White"
                        FontSize="27"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        LineHeight="1.0"
                        Margin="0,3,0,0" />

                    <Label
                        x:Name="safeZoneDestinationLabel"
                        Text="Malanday Elementary School"
                        TextColor="White"
                        FontSize="13"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        Margin="0,5,0,0" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Margin="0,6,0,3">
                        <VerticalStackLayout Spacing="0" HorizontalOptions="End">
                            <Label
                                x:Name="safeZoneDistanceTravelledLabel"
                                Text="0 meters"
                                TextColor="White"
                                FontSize="12"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Distance Traveled"
                                TextColor="#E8FFFFFF"
                                FontSize="9"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="Start">
                            <Label
                                x:Name="safeZoneTimeTakenLabel"
                                Text="0 minutes"
                                TextColor="White"
                                FontSize="12"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Time Taken"
                                TextColor="#E8FFFFFF"
                                FontSize="9"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label
                        x:Name="safeZoneDetailsLabel"
                        Text="Follow posted signs to the entrance and check local advisories."
                        TextColor="White"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        IsVisible="True" />

                    <Label
                        Text="Advisories remain active in surrounding areas."
                        TextColor="White"
                        FontSize="12"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        Margin="0,12,0,10" />

                    <Button
                        Text="End Guidance Session"
                        ImageSource="lucide_chevron_right_green.png"
                        ContentLayout="Right,8"
                        HeightRequest="42"
                        BackgroundColor="#CDEFD9"
                        TextColor="#086A3C"
                        FontSize="11"
                        FontAttributes="Bold"
                        CornerRadius="6"
                        Clicked="OnFinishNavigationClicked" />

                    <Button
                        Text="View Guidance Session Details"
                        HeightRequest="32"
                        Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="13"
                        FontAttributes="Bold"
                        Clicked="OnViewGuidanceSessionDetailsClicked" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
