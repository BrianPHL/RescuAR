<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RescuAR.App.Views.Camera.CameraPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:evergine="clr-namespace:RescuAR.MAUI.Evergine"
    Title="Camera"
    BackgroundColor="Black">

    <Grid>
        <evergine:EvergineView
            x:Name="evergineView"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!--
            Milestone 3 pedestrian turn guidance.
            InputTransparent keeps the overlay from interfering with AR touch
            handling or MAUI navigation gestures.
        -->
        <Border
            x:Name="turnGuidancePanel"
            IsVisible="False"
            InputTransparent="True"
            ZIndex="10"
            Margin="16,18,16,0"
            Padding="16,10"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            BackgroundColor="#CC111111"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout
                Spacing="2"
                HorizontalOptions="Center">
                <Label
                    x:Name="turnInstructionLabel"
                    Text="Continue straight"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="turnDistanceLabel"
                    Text=""
                    TextColor="#E6FFFFFF"
                    FontSize="13"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <!--
            Stage 7B Flood Depth Visualization.

            The actual water body is now rendered in Evergine AR space using
            the frame-coherent ARCore ground anchor and meter scale. This MAUI
            layer intentionally contains ONLY the compact information card.

            River-gauge values remain informational and never become a fake
            local water depth. Only an explicitly local depth can create the
            world-space water volume.
        -->
        <Grid
            x:Name="floodVisualizationLayer"
            IsVisible="False"
            InputTransparent="True"
            ZIndex="6">

            <Border
                x:Name="floodVisualizationBanner"
                Margin="14,84,14,0"
                Padding="12,10"
                VerticalOptions="Start"
                BackgroundColor="#E8E0F2FE"
                Stroke="#7DD3FC"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Grid
                        WidthRequest="34"
                        HeightRequest="34"
                        VerticalOptions="Center">
                        <Path
                            Data="M17,2 L27,12 L22,12 L22,21 L12,21 L12,12 L7,12 Z"
                            Fill="#0284C7"
                            Aspect="Uniform" />
                        <Path
                            Data="M2,25 C7,21 12,21 17,25 C22,29 27,29 32,25"
                            Stroke="#0284C7"
                            StrokeThickness="3"
                            Fill="Transparent"
                            Aspect="Uniform" />
                        <Path
                            Data="M2,31 C7,27 12,27 17,31 C22,35 27,35 32,31"
                            Stroke="#0284C7"
                            StrokeThickness="3"
                            Fill="Transparent"
                            Aspect="Uniform" />
                    </Grid>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="1">
                        <Label
                            x:Name="floodVisualizationTitleLabel"
                            Text="Flood depth visualization"
                            TextColor="#075985"
                            FontSize="13"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="floodVisualizationPrimaryLabel"
                            Text="Estimated local depth: 0.60 m"
                            TextColor="#0C4A6E"
                            FontSize="16"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="floodVisualizationSecondaryLabel"
                            Text="Water surface is rendered at the measured height above the detected ARCore ground plane."
                            TextColor="#075985"
                            FontSize="11"
                            LineBreakMode="WordWrap" />

                        <Label
                            x:Name="floodVisualizationSourceLabel"
                            Text="DEV synthetic local depth • AR ground-relative visualization"
                            TextColor="#0369A1"
                            FontSize="10"
                            Margin="0,2,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!--
            Stage 6 Emergency Alert Overlay.

            The alert presentation intentionally follows the approved Camera
            mockups: live camera remains visible underneath a red emergency
            treatment, the critical instruction is centered, and the only
            actions are Start AR Evacuation Guidance and Dismiss.

            HIGH/CRITICAL advisories additionally show the five-second
            automatic-start notice. Lower severities never auto-start.

            The Safe Zone completion overlay remains ZIndex=100 and therefore
            has visual priority over this emergency advisory overlay.
        -->
        <Grid
            x:Name="emergencyAdvisoryOverlay"
            IsVisible="False"
            ZIndex="80"
            BackgroundColor="#D0B00000">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Approved top emergency banner -->
                <Border
                    x:Name="emergencyAdvisoryTopBanner"
                    Grid.Row="0"
                    Margin="14,14,14,0"
                    Padding="14,10"
                    BackgroundColor="#70FF5A5A"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="0"
                        HorizontalOptions="Center">
                        <Label
                            Text="Emergency Detected"
                            TextColor="#8E1010"
                            FontSize="13"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />
                        <Label
                            x:Name="emergencyAdvisoryTopSeverityLabel"
                            Text="Flood Advisory - High Severity"
                            TextColor="#8E1010"
                            FontSize="12"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Main emergency message. Scrollable only on small screens. -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout
                        Padding="24,16,24,8"
                        Spacing="13"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center">

                        <!-- Flood icon from the approved mockup: up arrow + waves. -->
                        <Grid
                            x:Name="emergencyFloodIcon"
                            IsVisible="False"
                            WidthRequest="172"
                            HeightRequest="144"
                            HorizontalOptions="Center">
                            <Path
                                Data="M86,4 L118,38 L99,38 L99,78 L73,78 L73,38 L54,38 Z"
                                Fill="White"
                                Aspect="Uniform" />
                            <Path
                                Data="M12,94 C28,82 43,82 58,94 C73,106 88,106 103,94 C118,82 133,82 160,94"
                                Stroke="White"
                                StrokeThickness="10"
                                Fill="Transparent"
                                Aspect="Uniform" />
                            <Path
                                Data="M12,124 C28,112 43,112 58,124 C73,136 88,136 103,124 C118,112 133,112 160,124"
                                Stroke="White"
                                StrokeThickness="10"
                                Fill="Transparent"
                                Aspect="Uniform" />
                        </Grid>

                        <!-- Earthquake ECG-style icon from the approved mockup. -->
                        <Grid
                            x:Name="emergencyEarthquakeIcon"
                            IsVisible="False"
                            WidthRequest="172"
                            HeightRequest="144"
                            HorizontalOptions="Center">
                            <Path
                                Data="M8,78 L42,78 L58,28 L83,118 L108,66 L132,66 L142,48 L164,48"
                                Stroke="White"
                                StrokeThickness="10"
                                Fill="Transparent"
                                Aspect="Uniform" />
                        </Grid>

                        <!-- Generic emergency icon for non-flood/non-earthquake advisories. -->
                        <Grid
                            x:Name="emergencyGenericIcon"
                            IsVisible="True"
                            WidthRequest="146"
                            HeightRequest="120"
                            HorizontalOptions="Center">
                            <Label
                                Text="!"
                                TextColor="White"
                                FontSize="102"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Grid>

                        <Label
                            x:Name="emergencyAdvisoryHeroTitleLabel"
                            Text="Emergency Nearby!"
                            TextColor="White"
                            FontSize="43"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                        <Label
                            x:Name="emergencyAdvisoryBodySeverityLabel"
                            Text="Emergency Advisory - High Severity"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="emergencyAdvisoryBodyMessageLabel"
                            Text="Follow the latest verified emergency guidance."
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Margin="8,14,8,0" />
                    </VerticalStackLayout>
                </ScrollView>

                <!--
                    HIGH severity only:
                    this notice is hidden for Moderate/Low/etc. advisories.
                -->
                <VerticalStackLayout
                    Grid.Row="2"
                    Padding="20,0,20,18"
                    Spacing="9">

                    <Label
                        x:Name="emergencyAdvisoryCountdownLabel"
                        IsVisible="False"
                        Text="Popup will close in 5 seconds. AR Evacuation Guidance will proceed..."
                        TextColor="#F7FFFFFF"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                    <Button
                        x:Name="emergencyStartGuidanceButton"
                        Text="Start AR Evacuation Guidance  >"
                        HeightRequest="50"
                        CornerRadius="8"
                        BackgroundColor="#FF3B43"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        Clicked="OnEmergencyStartGuidanceClicked" />

                    <Button
                        x:Name="emergencyDismissButton"
                        Text="Dismiss"
                        HeightRequest="38"
                        Padding="0"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        Clicked="OnEmergencyAdvisoryCloseClicked" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!--
            Stage 5 Safe Zone Confirmation.
            Full-screen completion state aligned with the approved green
            safe-zone UI direction. It is intentionally hidden until repeated
            GPS + route-progress checks confirm arrival.
        -->
        <Grid
            x:Name="safeZoneConfirmationOverlay"
            IsVisible="False"
            ZIndex="100"
            BackgroundColor="#F20C6B43"
            Padding="28">

            <VerticalStackLayout
                Spacing="16"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="420">

                <Border
                    WidthRequest="96"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    BackgroundColor="#26FFFFFF"
                    Stroke="#B3FFFFFF"
                    StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="48" />
                    </Border.StrokeShape>
                    <Label
                        Text="✓"
                        TextColor="White"
                        FontSize="58"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                </Border>

                <Label
                    Text="You've Reached a Safe Zone"
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="safeZoneDestinationLabel"
                    Text="Evacuation Center"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="safeZoneDetailsLabel"
                    Text="Arrival confirmed."
                    TextColor="#E6FFFFFF"
                    FontSize="14"
                    HorizontalTextAlignment="Center" />

                <Button
                    Text="Finish Navigation"
                    Margin="0,12,0,0"
                    Padding="18,12"
                    BackgroundColor="White"
                    TextColor="#0C6B43"
                    FontAttributes="Bold"
                    Clicked="OnFinishNavigationClicked" />
            </VerticalStackLayout>
        </Grid>

        <!--
            TEMPORARY developer validation controls.
            Stage 5 safe-zone validation is enabled for the current test build;
            the older Milestone 3 controls remain disabled.
        -->
        <VerticalStackLayout
            ZIndex="20"
            Margin="20,0,20,28"
            Spacing="8"
            HorizontalOptions="Center"
            VerticalOptions="End">

            <Button
                x:Name="developerFloodDepthTestButton"
                Text="DEV: AR Flood Depth 0.60 m"
                IsVisible="False"
                Padding="14,10"
                BackgroundColor="#CC0284C7"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnDeveloperFloodDepthTestClicked" />

            <Button
                x:Name="developerSafeZoneTestButton"
                Text="DEV: Arm Safe Zone Test"
                IsVisible="False"
                Padding="14,10"
                BackgroundColor="#CC0C6B43"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnDeveloperSafeZoneTestClicked" />

            <Button
                x:Name="developerTurnTestButton"
                Text="DEV: Validate Turn States"
                IsVisible="False"
                Padding="14,10"
                BackgroundColor="#CC1F4F7A"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnDeveloperTurnTestClicked" />

            <Button
                x:Name="developerRerouteTestButton"
                Text="DEV: Simulate Off-Route Reroute"
                IsVisible="False"
                Padding="14,10"
                BackgroundColor="#CC7A1F1F"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnDeveloperRerouteTestClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
