<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Authentication"
    x:DataType="vm:RegistrationViewModel"
    x:Class="RescuAR.App.Views.Authentication.RegistrationPage"
    BackgroundColor="#FFFFFF"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <x:String x:Key="GoogleIcon">M 12 10.2 L 12 13.8 L 18.2 13.8 C 17.6 16.4 15.2 18.2 12 18.2 C 8.6 18.2 5.8 15.4 5.8 12 C 5.8 8.6 8.6 5.8 12 5.8 C 13.5 5.8 14.9 6.3 16 7.2 L 18.6 4.6 C 16.8 3 14.5 2 12 2 C 6.5 2 2 6.5 2 12 C 2 17.5 6.5 22 12 22 C 17.8 22 22 17.8 22 12 C 22 11.4 21.9 10.8 21.8 10.2 L 12 10.2 Z</x:String>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24, 10, 24, 40" Spacing="16">

                <!-- Header -->
                <VerticalStackLayout Spacing="4" Margin="0, 10, 0, 4">
                    <Label Text="Create RescuAR Account" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" />
                    <Label Text="Exclusive disaster response network for Marikina City residents." FontSize="13" TextColor="#64748B" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Page Toggle (Sign Up / Log In) -->
                <Border StrokeThickness="0" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 24" HeightRequest="48" Margin="0, 4, 0, 8">
                    <Grid ColumnDefinitions="*, *">
                        <!-- Sign Up (Active) -->
                        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="#0A8491" StrokeShape="RoundRectangle 24" Margin="3">
                            <Label Text="Sign Up" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- Log In -->
                        <Label Grid.Column="1" Text="Log In" TextColor="#64748B" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSignInCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

                <!-- Step Progress Header -->
                <Border BackgroundColor="#E6F4F2" StrokeThickness="1" Stroke="#2DD4BF" Padding="12,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="{Binding CurrentStep, StringFormat='STEP {0} OF 2'}" FontSize="11" FontAttributes="Bold" TextColor="#0A8491" VerticalOptions="Center" CharacterSpacing="1"/>
                        <Label Grid.Column="2" Text="{Binding StepTitle}" FontSize="11" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ================= STEP 1: MARIKINA RESIDENT VERIFICATION ================= -->
                <VerticalStackLayout IsVisible="{Binding IsStep1}" Spacing="14">
                        <Label Text="Middle name (optional)" TextColor="#0F172A" FontSize="12" />
                        <Entry Text="{Binding MiddleName}" Placeholder="Middle name" TextColor="#0F172A" />
                    <!-- First Name and Last Name Fields (Side by Side) -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="First Name" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="46" Padding="12, 0">
                                <Entry Text="{Binding FirstName}" Placeholder="Juan Miguel" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Last Name" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="46" Padding="12, 0">
                                <Entry Text="{Binding LastName}" Placeholder="Dela Cruz" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Mobile Number -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Mobile Number" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="46" Padding="12, 0">
                            <Entry Text="{Binding ContactNumber}" Placeholder="0917 123 4567" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" Keyboard="Telephone" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Birthday (for Age Tracking) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Birthday (Age Tracking)" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="46" Padding="12, 0">
                            <DatePicker Date="{Binding Birthday}" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" MaximumDate="{x:Static vm:RegistrationViewModel.TodayDate}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- House No / Lot / Block & Street Name -->
                    <Grid ColumnDefinitions="1.2*, 2*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="House/Lot/Blk" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="46" Padding="12, 0">
                                <Entry Text="{Binding HouseNumber}" Placeholder="e.g. 12-A" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Street Name" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="46" Padding="12, 0">
                                <Entry Text="{Binding StreetName}" Placeholder="e.g. J.P. Rizal St." TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Barangay Dropdown -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Barangay (Marikina City Only)" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="48" Padding="12, 0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Picker Grid.Column="0" ItemsSource="{Binding MarikinaBarangays}" SelectedItem="{Binding SelectedBarangay}" Title="Select Barangay" TextColor="#0F172A" TitleColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                                <Path Grid.Column="1" Data="M7 10l5 5 5-5z" Fill="#64748B" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" InputTransparent="True"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Proceed Button -->
                    <Button Text="Continue to Account Setup →"
                            BackgroundColor="#0A8491"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48"
                            Margin="0,8,0,0"
                            Command="{Binding ProceedToStep2Command}" />
                </VerticalStackLayout>

                <!-- ================= STEP 2: ACCOUNT REGISTRATION & PASSWORD ================= -->
                <VerticalStackLayout IsVisible="{Binding IsStep2}" Spacing="14">
                    <!-- Back Button to Step 1 -->
                    <HorizontalStackLayout Spacing="4">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackToStep1Command}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Path Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Fill="#0A8491" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Text="Edit Resident Information" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Email Address -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email Address" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="46" Padding="12, 0">
                            <Entry Text="{Binding Email}" Placeholder="email@example.com" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Password" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="46" Padding="12, 0">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Entry Grid.Column="0" Text="{Binding Password}" IsPassword="{Binding IsPasswordHidden}" Placeholder="Min. 10 characters" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
                                <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                    </Border.GestureRecognizers>
                                    <Path Data="M12 4.5C7 4.5 2.73 7.61 1 11.5 2.73 15.39 7 18.5 12 18.5 17 18.5 21.27 15.39 23 11.5 21.27 7.61 17 4.5 12 4.5zm0 11.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                          Fill="#64748B" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Password Criteria Indicator -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="2" ColumnSpacing="8" Margin="4,2,0,0">
                            <Label Grid.Row="0" Grid.Column="0" Text="✓ 10+ chars" FontSize="10.5" TextColor="#64748B">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding HasMinLength}" Value="True"><Setter Property="TextColor" Value="#16A34A" /></DataTrigger></Label.Triggers>
                            </Label>
                            <Label Grid.Row="0" Grid.Column="1" Text="✓ Uppercase" FontSize="10.5" TextColor="#64748B">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding HasUpperCase}" Value="True"><Setter Property="TextColor" Value="#16A34A" /></DataTrigger></Label.Triggers>
                            </Label>
                            <Label Grid.Row="1" Grid.Column="0" Text="✓ Number" FontSize="10.5" TextColor="#64748B">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding HasDigit}" Value="True"><Setter Property="TextColor" Value="#16A34A" /></DataTrigger></Label.Triggers>
                            </Label>
                            <Label Grid.Row="1" Grid.Column="1" Text="✓ Symbol" FontSize="10.5" TextColor="#64748B">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding HasSpecialChar}" Value="True"><Setter Property="TextColor" Value="#16A34A" /></DataTrigger></Label.Triggers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Confirm Password" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" HeightRequest="46" Padding="12, 0">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Entry Grid.Column="0" Text="{Binding ConfirmPassword}" IsPassword="{Binding IsConfirmPasswordHidden}" Placeholder="Confirm your password" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
                                <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleConfirmPasswordVisibilityCommand}" />
                                    </Border.GestureRecognizers>
                                    <Path Data="M12 4.5C7 4.5 2.73 7.61 1 11.5 2.73 15.39 7 18.5 12 18.5 17 18.5 21.27 15.39 23 11.5 21.27 7.61 17 4.5 12 4.5zm0 11.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                          Fill="#64748B" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Terms Checkbox -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" Margin="0, 4">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsTermsAccepted}" Color="#0A8491" VerticalOptions="Center" WidthRequest="24" HeightRequest="24" />
                        <Label Grid.Column="1" FontSize="12" TextColor="#64748B" VerticalOptions="Center" LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="I agree to the " />
                                    <Span Text="Terms of Service" TextColor="#0A8491" FontAttributes="Bold">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding GoToTermsCommand}" />
                                        </Span.GestureRecognizers>
                                    </Span>
                                    <Span Text=" and " />
                                    <Span Text="Privacy Policy" TextColor="#0A8491" FontAttributes="Bold">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding GoToPrivacyCommand}" />
                                        </Span.GestureRecognizers>
                                    </Span>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <!-- Sign Up Submit Button -->
                    <Grid Margin="0, 6, 0, 0">
                        <Button Text="Complete Registration &amp; Verify Email" BackgroundColor="#0A8491" TextColor="White" FontSize="15" FontAttributes="Bold" CornerRadius="12" HeightRequest="48" Command="{Binding CreateAccountCommand}" IsVisible="{Binding IsNotLoading}" />
                        <ActivityIndicator IsRunning="{Binding IsLoading}" Color="#0A8491" HeightRequest="48" HorizontalOptions="Center" IsVisible="{Binding IsLoading}" />
                    </Grid>

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*, Auto, *" VerticalOptions="Center" Margin="0, 8">
                        <BoxView Grid.Column="0" HeightRequest="1" BackgroundColor="#E2E8F0" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="OR SIGN UP WITH" Margin="12, 0" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" VerticalOptions="Center" CharacterSpacing="1"/>
                        <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#E2E8F0" VerticalOptions="Center" />
                    </Grid>

                    <!-- Google Sign-Up -->
                    <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" BackgroundColor="White" HeightRequest="46">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoogleSignUpCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, Auto" HorizontalOptions="Center" ColumnSpacing="10">
                            <Path Grid.Column="0" Data="{StaticResource GoogleIcon}" Fill="#4285F4" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Sign Up with Google" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Sign In Option Footer -->
                <Label HorizontalOptions="Center" FontSize="13" TextColor="#64748B" Margin="0, 10, 0, 10">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Already have an account? " />
                            <Span Text="Log In" TextColor="#0A8491" FontAttributes="Bold">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToSignInCommand}" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
