<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RescuAR.App.Views.Authentication.TermsAndConditionsPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F7F7">

    <Grid RowDefinitions="Auto, *">
        <!-- Header Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" HeightRequest="60" BackgroundColor="#EAEAEA" Padding="16, 0">
            <!-- Back button on top left -->
            <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="&lt;" FontFamily="OpenSansSemibold" FontSize="20" TextColor="#00848E" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0" />
            </Border>

            <!-- Centered Title -->
            <Label Grid.Column="1"
                   Text="RescuAR"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   TextColor="#1E1E1E"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="-40, 0, 0, 0" />
        </Grid>

        <!-- Main Content (Scrollable) -->
        <ScrollView x:Name="LegalDocumentScroll" Grid.Row="1" />
    </Grid>
</ContentPage>
