<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RescuAR.App.Views.Authentication.OtpVerificationPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F2F7">

    <Grid>
        <!-- Background Color instead of gradient -->
        <Grid.Background>
            <SolidColorBrush Color="#F2F2F7" />
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="25" Padding="20, 60, 20, 20">
                
                <!-- White Container Card -->
                <Border StrokeThickness="0" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="25, 40" Margin="0, 20, 0, 0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Icon Header -->
                        <Border StrokeShape="RoundRectangle 40" StrokeThickness="0" BackgroundColor="#E0F2F1" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center" Margin="0,0,0,10">
                            <!-- SVG Envelope Icon -->
                            <Path Data="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z" 
                                  Fill="#00848E" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" Aspect="Uniform" />
                        </Border>

                        <Label Text="Verify Your Email" TextColor="#1E1E1E" FontSize="28" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                        <Label Text="{Binding Email, StringFormat='We sent a 6-digit verification code to {0}. Please enter it below to confirm your account.'}" TextColor="#757575" FontSize="14" FontFamily="OpenSansRegular" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="10,0,10,10" />

                        <!-- Error Message -->
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#FADBD8" Stroke="#E74C3C" Padding="15" IsVisible="{Binding HasError}">
                            <Label Text="{Binding ErrorMessage}" TextColor="#C0392B" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </Border>

                        <!-- 6-Digit OTP Input -->
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,15,0,15">
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" StrokeThickness="1.5" BackgroundColor="#F9F9F9" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="entry1" Text="{Binding Digit1}" Keyboard="Numeric" MaxLength="1" TextColor="#1E1E1E" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextChanged="OnEntryTextChanged" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" StrokeThickness="1.5" BackgroundColor="#F9F9F9" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="entry2" Text="{Binding Digit2}" Keyboard="Numeric" MaxLength="1" TextColor="#1E1E1E" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextChanged="OnEntryTextChanged" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" StrokeThickness="1.5" BackgroundColor="#F9F9F9" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="entry3" Text="{Binding Digit3}" Keyboard="Numeric" MaxLength="1" TextColor="#1E1E1E" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextChanged="OnEntryTextChanged" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" StrokeThickness="1.5" BackgroundColor="#F9F9F9" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="entry4" Text="{Binding Digit4}" Keyboard="Numeric" MaxLength="1" TextColor="#1E1E1E" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextChanged="OnEntryTextChanged" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" StrokeThickness="1.5" BackgroundColor="#F9F9F9" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="entry5" Text="{Binding Digit5}" Keyboard="Numeric" MaxLength="1" TextColor="#1E1E1E" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextChanged="OnEntryTextChanged" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" StrokeThickness="1.5" BackgroundColor="#F9F9F9" WidthRequest="45" HeightRequest="55">
                                <Entry x:Name="entry6" Text="{Binding Digit6}" Keyboard="Numeric" MaxLength="1" TextColor="#1E1E1E" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextChanged="OnEntryTextChanged" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Verify Button -->
                        <Border StrokeThickness="0" BackgroundColor="#00848E" StrokeShape="RoundRectangle 25" HeightRequest="55" IsVisible="{Binding IsNotLoading}" Margin="0, 10, 0, 0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding VerifyOtpCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Verify &amp; Continue" TextColor="White" FontFamily="OpenSansSemibold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        
                        <!-- Loading Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#00848E" HorizontalOptions="Center" Margin="0,10,0,0" />
                        
                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- Custom Styled Success Popup Overlay -->
        <ContentView BackgroundColor="#99000000" IsVisible="{Binding IsSuccessPopupVisible}">
            <Grid>
                <!-- Popup Card -->
                <Border StrokeThickness="0" BackgroundColor="White" StrokeShape="RoundRectangle 24" Padding="30" Margin="30,0" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,15" Radius="30" Opacity="0.3" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="15">
                        
                        <!-- Success Icon Container -->
                        <Border StrokeShape="RoundRectangle 40" StrokeThickness="0" BackgroundColor="#E8F5E9" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center" Margin="0,0,0,5">
                            <!-- SVG Check Icon -->
                            <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" 
                                  Fill="#2E7D32" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="45" HeightRequest="45" Aspect="Uniform" />
                        </Border>

                        <Label Text="Verified!" TextColor="#1E1E1E" FontSize="26" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                        
                        <Label Text="Your email has been successfully verified. Let's finish setting up your account!" TextColor="#757575" FontSize="15" FontFamily="OpenSansRegular" HorizontalTextAlignment="Center" LineHeight="1.3" />
                        
                        <!-- Continue Button -->
                        <Border StrokeThickness="0" BackgroundColor="#00848E" StrokeShape="RoundRectangle 25" HeightRequest="50" Margin="0, 20, 0, 0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ContinueToAddressCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Continue" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ContentView>
    </Grid>
</ContentPage>
