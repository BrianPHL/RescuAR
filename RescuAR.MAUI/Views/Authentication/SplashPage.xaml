<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Authentication" xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="RescuAR.App.Views.Authentication.SplashPage" x:DataType="vm:SplashViewModel"
             NavigationPage.HasNavigationBar="False" BackgroundColor="#0D1B36">
    <Grid RowDefinitions="*,Auto" Padding="24">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="24">
            <skia:SKCanvasView x:Name="RadarCanvas" WidthRequest="270" HeightRequest="270" PaintSurface="OnRadarCanvasPaintSurface" InputTransparent="True" />
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                <Label Text="Rescu" FontSize="40" FontAttributes="Bold" TextColor="White" />
                <Label Text="AR" FontSize="40" FontAttributes="Bold" TextColor="#18B6BC" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,0,0,36" HorizontalOptions="Center">
            <Label Text="{Binding StatusText}" TextColor="#CBD5E1" FontSize="13" HorizontalTextAlignment="Center" />
            <Label Text="{Binding VersionText}" TextColor="#94A3B8" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
