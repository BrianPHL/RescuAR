<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Authentication"
    x:DataType="vm:SplashViewModel"
    x:Class="RescuAR.App.Views.Authentication.SplashPage"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="White">

    <Grid RowDefinitions="*, Auto" ColumnDefinitions="*">
        
        <!-- Center Content: Logo Card & Quote -->
        <VerticalStackLayout Grid.Row="0" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center"
                             Spacing="40"
                             Padding="24">
            
            <!-- Glassmorphic Logo Container -->
            <Border WidthRequest="160"
                    HeightRequest="160"
                    StrokeThickness="1"
                    Stroke="#E2E8F0"
                    BackgroundColor="#F8FAFC"
                    StrokeShape="RoundRectangle 40"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,10" Radius="30" Opacity="0.05" />
                </Border.Shadow>
                
                <Frame CornerRadius="30" Padding="0" IsClippedToBounds="True" HasShadow="False" BackgroundColor="White" Margin="16">
                    <Image Source="rescuar_logo.jpg"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                </Frame>
            </Border>

            <!-- App Title -->
            <Label Text="RescuAR"
                   FontFamily="OpenSansSemibold"
                   FontSize="36"
                   TextColor="#0F172A"
                   CharacterSpacing="2"
                   HorizontalOptions="Center" />
            
            <!-- Dynamic Safety Quote -->
            <Label Text="{Binding QuoteText}"
                   FontSize="16"
                   FontFamily="OpenSansRegular"
                   TextColor="#64748B"
                   FontAttributes="Italic"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   HorizontalOptions="Center"
                   Margin="20,0" />
            
        </VerticalStackLayout>

        <!-- Bottom Loading State & Version -->
        <VerticalStackLayout Grid.Row="1"
                             HorizontalOptions="Center"
                             VerticalOptions="End"
                             Margin="0,0,0,50"
                             Spacing="16">
            
            <ActivityIndicator IsRunning="True"
                               Color="#00848E"
                               WidthRequest="32"
                               HeightRequest="32"
                               HorizontalOptions="Center" />
            
            <Label Text="{Binding StatusText}"
                   FontSize="14"
                   FontFamily="OpenSansSemibold"
                   TextColor="#334155"
                   HorizontalOptions="Center" />
            
            <Label Text="{Binding VersionText}"
                   FontSize="12"
                   FontFamily="OpenSansRegular"
                   TextColor="#94A3B8"
                   HorizontalOptions="Center" />
            
        </VerticalStackLayout>
        
    </Grid>

</ContentPage>
