<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Authentication"
    x:DataType="vm:SplashViewModel"
    x:Class="RescuAR.App.Views.Authentication.SplashPage"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#0B132B">

    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

        <!-- Deep Ambient Background -->
        <BoxView BackgroundColor="#0B132B" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />

        <!-- Center Stage Stack -->
        <VerticalStackLayout HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="32">

            <!-- Official RescuAR Logo Banner from Uploaded Brand Assets -->
            <Image Source="rescuar_logo_banner.png"
                   HeightRequest="68"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <!-- Radar on Top of Map Display Widget (Animated Radar / Loading element) -->
            <Border x:Name="RadarBorder"
                    WidthRequest="260"
                    HeightRequest="260"
                    StrokeThickness="2.5"
                    Stroke="#1E3A5F"
                    StrokeShape="RoundRectangle 130"
                    BackgroundColor="#0D1B36"
                    HorizontalOptions="Center"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#0A8491" Offset="0,0" Radius="36" Opacity="0.55" />
                </Border.Shadow>

                <skia:SKCanvasView x:Name="RadarCanvas"
                                   WidthRequest="260"
                                   HeightRequest="260"
                                   PaintSurface="OnRadarCanvasPaintSurface"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
            </Border>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
