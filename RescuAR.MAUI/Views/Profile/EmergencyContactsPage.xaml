<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Profile"
    x:Class="RescuAR.App.Views.Profile.EmergencyContactsPage"
    x:Name="EmergencyContactsRootPage"
    x:DataType="vm:EmergencyContactsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">
        <!-- Top App Bar / Header (Uniform RescuAR Primary Teal Brand Palette) -->
        <Border Grid.Row="0" BackgroundColor="#0A8491" HeightRequest="56" StrokeThickness="0" Padding="14,0" ZIndex="10" Shadow="{Shadow Brush=Black, Offset='0,2', Radius=6, Opacity=0.15}">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <Border Grid.Column="0"
                        BackgroundColor="#065F69"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                          Fill="#FFFFFF"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1" Text="Emergency Contacts" TextColor="#FFFFFF" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />

                <BoxView Grid.Column="2" WidthRequest="36" HeightRequest="36" Color="Transparent" />
            </Grid>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="20,12,20,30">
                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#64748B" />
                <!-- Breadcrumb & Title -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Profile/" FontSize="13" TextColor="#64748B" FontAttributes="Bold" />
                    <Label Text="Emergency Contacts" FontSize="26" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Save trusted contacts for quick access during an emergency. A call shortcut needs both a name and a phone number." FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Contact 1 Card -->
                <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="18">
                    <VerticalStackLayout Spacing="14" IsEnabled="{Binding CanEdit}">
                        <!-- Header -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0" BackgroundColor="#E6F4F2" StrokeThickness="0" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      Fill="#0A8491"
                                      Aspect="Uniform"
                                      WidthRequest="16"
                                      HeightRequest="16"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="Primary Emergency Contact" FontAttributes="Bold" FontSize="14" TextColor="#0F172A" LineBreakMode="TailTruncation" />
                                <Label Text="First saved emergency contact" FontSize="11" TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="2"
                                Text="Import"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#0A8491"
                                BackgroundColor="#E6F4F5"
                                CornerRadius="8"
                                HeightRequest="32"
                                Padding="12,0"
                                Command="{Binding PickContact1Command}" IsEnabled="{Binding CanEdit}"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Full Name" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding Contact1Name}" Placeholder="e.g. Maria Santos" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Phone Number" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding Contact1Phone}" Placeholder="0917 123 4567" Keyboard="Telephone" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Relationship" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding Contact1Relationship}" Placeholder="e.g. Spouse, Parent, Sibling" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Contact 2 Card -->
                <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="18">
                    <VerticalStackLayout Spacing="14" IsEnabled="{Binding CanEdit}">
                        <!-- Header -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0" BackgroundColor="#E6F4F2" StrokeThickness="0" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      Fill="#0A8491"
                                      Aspect="Uniform"
                                      WidthRequest="16"
                                      HeightRequest="16"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="Secondary Contact" FontAttributes="Bold" FontSize="14" TextColor="#0F172A" LineBreakMode="TailTruncation" />
                                <Label Text="Alternate backup contact" FontSize="11" TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="2"
                                Text="Import"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#0A8491"
                                BackgroundColor="#E6F4F5"
                                CornerRadius="8"
                                HeightRequest="32"
                                Padding="12,0"
                                Command="{Binding PickContact2Command}" IsEnabled="{Binding CanEdit}"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Full Name" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding Contact2Name}" Placeholder="e.g. Juan Dela Cruz" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Phone Number" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding Contact2Phone}" Placeholder="0918 765 4321" Keyboard="Telephone" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Relationship" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                            <Border StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0" HeightRequest="46">
                                <Entry Text="{Binding Contact2Relationship}" Placeholder="e.g. Neighbor, Friend, Coworker" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Retry local sync" Command="{Binding RetryLocalSyncCommand}" IsVisible="{Binding CanRetryLocal}" IsEnabled="{Binding CanEdit}" />
                <!-- Save Contacts Button -->
                <Button
                    Text="Save Emergency Contacts"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#0A8491"
                    CornerRadius="12"
                    HeightRequest="48"
                    Command="{Binding SaveContactsCommand}" IsEnabled="{Binding CanEdit}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
