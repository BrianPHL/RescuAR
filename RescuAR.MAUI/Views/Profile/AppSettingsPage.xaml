<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Profile"
    x:Class="RescuAR.App.Views.Profile.AppSettingsPage"
    x:DataType="vm:AppSettingsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">
        <!-- Top Custom Header Bar (Uniform RescuAR Primary Teal Brand Palette) -->
        <Border Grid.Row="0"
                BackgroundColor="#0A8491"
                HeightRequest="56"
                StrokeThickness="0"
                Padding="16,0"
                ZIndex="10"
                Shadow="{Shadow Brush=Black, Offset='0,2', Radius=6, Opacity=0.15}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Back Button Pill -->
                <Border Grid.Column="0"
                        BackgroundColor="#065F69"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                          Fill="#FFFFFF"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Border>

                <!-- Page Title -->
                <Label Grid.Column="1"
                       Text="App Settings"
                       TextColor="#FFFFFF"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />

                <!-- Spacer -->
                <BoxView Grid.Column="2" WidthRequest="36" HeightRequest="36" Color="Transparent" />
            </Grid>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20,5,20,30">
                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#64748B" />
                <Label Text="{Binding DeviceInfo.StatusMessage}" FontSize="12" TextColor="#64748B" />
                <!-- Breadcrumb & Title -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Profile/" FontSize="14" TextColor="#64748B" />
                    <Label Text="App Settings" FontSize="30" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Choose navigation and advisory feedback, offline map detail and device permissions." FontSize="13" TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Section: Alerts & Notifications -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Alerts &amp; Notifications" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" Margin="4,0" />
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                        <VerticalStackLayout Spacing="16">
                            <!-- Push Notifications -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="In-app advisory popups" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Text="Show optional advisory dialogs. The advisory feed and camera emergency warnings remain active." FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding PushNotificationsEnabled}" OnColor="#0A8491" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Emergency Siren -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Automatic advisory sound" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Text="Play sound for new advisories. The manual Loud Siren shortcut stays available; device audio settings still apply." FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding EmergencySirenEnabled}" OnColor="#0A8491" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Advisory vibration -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Vibration feedback" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Text="Optional vibration for new advisories and qualified nearby turns when supported by the device." FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding HapticFeedbackEnabled}" OnColor="#0A8491" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Navigation" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" Margin="4,0" />
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Spoken directions" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Text="Speak current qualified guidance in AR and 2D. Starts Off; the Camera speaker button uses the same saved choice." FontSize="12" TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NavigationVoiceEnabled}" OnColor="#0A8491" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Section: Offline & Storage -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Offline Data &amp; Storage" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" Margin="4,0" />
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Detailed offline map" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Text="Packaged detail covers part of Marikina at zoom 13–18. Off keeps basic roads and points." FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding DetailedOfflineMapEnabled}" OnColor="#0A8491" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" />
                            <!-- Clear Cache Row -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Replaceable map cache" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="Current size: " FontSize="12" TextColor="#64748B" />
                                        <Label Text="{Binding CacheSizeText}" FontSize="12" FontAttributes="Bold" TextColor="#0A8491" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="Clear map cache"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#DC2626"
                                    BackgroundColor="#FEE2E2"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    Command="{Binding ClearCacheCommand}" IsEnabled="{Binding CanClearCache}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Section: Device Permissions -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Device Permissions" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" Margin="4,0" />
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Camera Access (AR Guidance)" FontSize="14" TextColor="#334155" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding DeviceInfo.CameraPermission}" FontSize="13" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="GPS Location (Routing &amp; Safety Circle)" FontSize="14" TextColor="#334155" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding DeviceInfo.LocationPermission}" FontSize="13" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Push Notifications (Disaster Alerts)" FontSize="14" TextColor="#334155" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding DeviceInfo.NotificationsPermission}" FontSize="13" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <Button
                                Text="Manage in Device Settings &gt;"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#0A8491"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Start"
                                Padding="0"
                                Margin="0,4,0,0"
                                Command="{Binding OpenDeviceSettingsCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
