<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RescuAR.App.Views.Profile.ProfilePage"
    Title="Profile"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F2F7">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0">
            
            <!-- Top Colored Banner -->
            <Grid BackgroundColor="#0A8491" HeightRequest="180" Padding="20,40,20,20">
                <Label Text="My Profile" TextColor="White" FontSize="28" FontAttributes="Bold" VerticalOptions="Start" />
            </Grid>

            <!-- Profile Info Card (Overlapping Banner) -->
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White" Margin="20,-80,20,20" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 40" StrokeThickness="4" Stroke="White" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeAvatarCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <!-- Default Icon (behind the image) -->
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                  Fill="#0A8491" WidthRequest="40" HeightRequest="40" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            
                            <!-- Profile Picture -->
                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                        </Grid>
                    </Border>
                    
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <!-- We bind directly to FullName which is fully observable -->
                        <Label Text="{Binding FullName}" TextColor="Black" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentUser.Email}" TextColor="Gray" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Menu List -->
            <VerticalStackLayout Spacing="15" Padding="20,0,20,20">
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.03" />
                    </Border.Shadow>
                    <VerticalStackLayout>
                    
                    <!-- Personal Information -->
                    <Grid Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPersonalInformationTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="36" HeightRequest="36" Margin="0,0,15,0">
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Personal Information" TextColor="Black" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&gt;" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F2F2F7" />

                    <!-- Health Information -->
                    <Grid Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHealthInformationTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="36" HeightRequest="36" Margin="0,0,15,0">
                            <!-- Medical Cross SVG Path -->
                            <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M18,13H13V18H11V13H6V11H11V6H13V11H18V13Z" Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Health Information" TextColor="Black" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&gt;" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F2F2F7" />

                    <!-- Safety Circle Management -->
                    <Grid Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSafetyCircleTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="36" HeightRequest="36" Margin="0,0,15,0">
                            <!-- Group/Circle Path -->
                            <Path Data="M16,11C17.66,11 18.99,9.66 18.99,8C18.99,6.34 17.66,5 16,5C14.34,5 13,6.34 13,8C13,9.66 14.34,11 16,11M8,11C9.66,11 10.99,9.66 10.99,8C10.99,6.34 9.66,5 8,5C6.34,5 5,6.34 5,8C5,9.66 6.34,11 8,11M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M16,13C15.71,13 15.38,13.02 15.03,13.05C16.19,13.89 17,15.02 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13Z" Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Safety Circle Management" TextColor="Black" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&gt;" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F2F2F7" />

                    <!-- Emergency Contacts -->
                    <Grid Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEmergencyContactsTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="36" HeightRequest="36" Margin="0,0,15,0">
                            <!-- ID Card Path -->
                            <Path Data="M20,4H4C2.89,4 2,4.89 2,6V18C2,19.1 2.89,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.89 21.1,4 20,4M13,10H20V12H13V10M13,14H20V16H13V14M8,13C6.34,13 5,11.66 5,10C5,8.34 6.34,7 8,7C9.66,7 11,8.34 11,10C11,11.66 9.66,13 8,13M4,17V16.5C4,14.17 6.67,13 8,13C9.33,13 12,14.17 12,16.5V17H4Z" Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Emergency Contacts" TextColor="Black" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&gt;" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F2F2F7" />

                    <!-- App Settings -->
                    <Grid Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAppSettingsTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="36" HeightRequest="36" Margin="0,0,15,0">
                            <!-- Gear Path -->
                            <Path Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.52,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98M12,15.5C10.07,15.5 8.5,13.93 8.5,12C8.5,10.07 10.07,8.5 12,8.5C13.93,8.5 15.5,10.07 15.5,12C15.5,13.93 13.93,15.5 12,15.5Z" Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="App Settings" TextColor="Black" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&gt;" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F2F2F7" />

                    <!-- Help Center -->
                    <Grid Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHelpCenterTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="36" HeightRequest="36" Margin="0,0,15,0">
                            <!-- Life Saver Path -->
                            <Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,19.92C7.63,19.92 4.08,16.37 4.08,12C4.08,7.63 7.63,4.08 12,4.08C16.37,4.08 19.92,7.63 19.92,12C19.92,16.37 16.37,19.92 12,19.92M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8M12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14Z" Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Help Center" TextColor="Black" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&gt;" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F2F2F7" />

                    <!-- Privacy Policy -->
                    <Grid Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPrivacyPolicyTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="36" HeightRequest="36" Margin="0,0,15,0">
                            <!-- Shield Path -->
                            <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,21.05C8.03,19.89 5,15.65 5,11V6.31L12,3.19L19,6.31V11C19,15.65 15.97,19.89 12,21.05Z" Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Privacy Policy" TextColor="Black" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&gt;" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F2F2F7" />

                    <!-- Terms & Conditions -->
                    <Grid Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTermsConditionsTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="36" HeightRequest="36" Margin="0,0,15,0">
                            <!-- Handshake Path (Doc/Handshake representation) -->
                            <Path Data="M14,2H6C4.89,2 4,2.89 4,4V20C4,21.1 4.89,22 6,22H18C19.1,22 20,21.1 20,20V8L14,2M13,3.5L18.5,9H13V3.5M16,11V13H8V11H16M14,15V17H8V15H14Z" Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Terms &amp; Conditions" TextColor="Black" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&gt;" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F2F2F7" />

                    <!-- System Information -->
                    <Grid Padding="15,12" ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSystemInformationTapped" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="36" HeightRequest="36" Margin="0,0,15,0">
                            <!-- System/Device Path -->
                            <Path Data="M16,1H8C6.34,1 5,2.34 5,4V20C5,21.66 6.34,23 8,23H16C17.66,23 19,21.66 19,20V4C19,2.34 17.66,1 16,1M17,19H7V5H17V19Z" Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="System Information" TextColor="Black" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="&gt;" TextColor="Black" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    </VerticalStackLayout>
                </Border>
                
                <Button Text="Log Out" Clicked="OnSignOutClicked" BackgroundColor="#D9534F" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="0,10,0,30" />
            </VerticalStackLayout>
        </VerticalStackLayout>
        </ScrollView>
        <!-- Subtle shadow/line for TabBar -->
        <BoxView VerticalOptions="End" HeightRequest="1" BackgroundColor="#D1D1D6" />

        <!-- Real-time SweetAlert Emergency Advisory Pop-Up Modal Overlay -->
        <Grid IsVisible="{Binding IsPopupVisible}" BackgroundColor="#90000000" Padding="20" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="380" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="#FFFFFF" Padding="0">
                <VerticalStackLayout Spacing="0">
                   
                    <Border BackgroundColor="{Binding SelectedAdvisory.AlertBadgeBg}" StrokeThickness="0" StrokeShape="RoundRectangle 24 24 0 0" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="{Binding SelectedAdvisory.AlertBadgeText}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SelectedAdvisory.HeaderTagText}" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="10" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedAdvisory.DisplayAlertLevelText}" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="15" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            
                            <Border Grid.Column="3" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClosePopupCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="✕" TextColor="#64748B" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollView MaximumHeightRequest="420" Padding="20">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="{Binding SelectedAdvisory.DisplayTitleText}" TextColor="#0F172A" FontSize="19" FontAttributes="Bold" />
                            <Label Text="{Binding SelectedAdvisory.DisplayMessageText}" TextColor="#334155" FontSize="13" LineBreakMode="WordWrap" CharacterSpacing="0.2" />

                            <Border IsVisible="{Binding SelectedAdvisory.HasActionPlan}" BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding SelectedAdvisory.ActionPlanHeaderTagText}" TextColor="#B45309" FontSize="10" FontAttributes="Bold" />
                                    <Label Text="{Binding SelectedAdvisory.DisplayActionPlanText}" TextColor="#92400E" FontSize="12" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding SelectedAdvisory.AffectedAreaHeaderTagText}" TextColor="#64748B" FontSize="10" FontAttributes="Bold" />
                                    <Label Text="{Binding SelectedAdvisory.DisplayAffectedAreaText}" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Text="{Binding SelectedAdvisory.CreatedAtText}" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
                                <Border Grid.Column="1" IsVisible="{Binding SelectedAdvisory.ShowWaterLevel}" BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                    <Label Text="{Binding SelectedAdvisory.WaterLevelText}" TextColor="#0284C7" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,16" BackgroundColor="#F8FAFC">
                        <Button Grid.Column="0" Text="{Binding SelectedAdvisory.CloseButtonText}" TextColor="#475569" BackgroundColor="#E2E8F0" CornerRadius="12" HeightRequest="44" FontSize="13" FontAttributes="Bold" Command="{Binding ClosePopupCommand}" />
                        <Button Grid.Column="1" Text="{Binding SelectedAdvisory.DetailsButtonText}" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="12" HeightRequest="44" FontSize="13" FontAttributes="Bold" Command="{Binding GoToAdvisoriesFeedCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>