<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RescuAR.App.Views.Profile.ProfilePage"
    Title="Profile"
    BackgroundColor="#F2F2F7">

    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
        <VerticalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
            <!-- Profile Icon -->
            <Border StrokeShape="RoundRectangle 40"
                    StrokeThickness="0"
                    BackgroundColor="#F2F2F7"
                    WidthRequest="80"
                    HeightRequest="80"
                    HorizontalOptions="Center">
                <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                      Fill="#0A8491"
                      WidthRequest="40"
                      HeightRequest="40"
                      Aspect="Uniform"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>

            <!-- Text Details -->
            <Label Text="User Profile"
                   TextColor="#000000"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Manage personal settings, emergency contacts, and disaster preparedness checklists."
                   TextColor="#7F7F7F"
                   FontSize="14"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   WidthRequest="300" />

            <!-- Sign Out Button -->
            <Button Text="Sign Out"
                    Clicked="OnSignOutClicked"
                    BackgroundColor="#D9534F"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Margin="0,20,0,0"
                    WidthRequest="200" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>