<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Profile"
    x:Class="RescuAR.App.Views.Profile.PersonalInformationPage"
    x:DataType="vm:PersonalInfoViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="Auto, *">
        <!-- Top App Bar / Header -->
        <Border Grid.Row="0" BackgroundColor="White" HeightRequest="56" StrokeThickness="0" Padding="12,0" ZIndex="10" Shadow="{Shadow Brush=Black, Offset='0,2', Radius=4, Opacity=0.06}">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Path Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Fill="#0F172A" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    <Label Text="Back" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Grid.Column="1" Text="RescuAR" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />

                <Path Grid.Column="2" Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"
                      Fill="#334155" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,4,0" />
            </Grid>
        </Border>

        <!-- Main Form Body -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="16">
                <Label Text="{Binding StatusMessage}" TextColor="#0A8491" FontSize="12" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0A8491" />
                <!-- Page Title Header -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Profile/" TextColor="#64748B" FontSize="13" FontAttributes="Bold" />
                    <Label Text="Personal Info" TextColor="#0F172A" FontSize="26" FontAttributes="Bold" />
                    <Label Text="Keep your personal information and address up to date." TextColor="#64748B" FontSize="12" />
                </VerticalStackLayout>

                <!-- Information Form Card -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="18,16" Shadow="{Shadow Brush=Black, Offset='0,3', Radius=8, Opacity=0.08}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14" IsEnabled="{Binding IsReady}">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        </VerticalStackLayout.Triggers>
                        <Label Text="Username (public display name)" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                        <Entry Text="{Binding Username}" Placeholder="Username" TextColor="#0F172A" />
                        <Label Text="Middle name (optional)" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                        <Entry Text="{Binding MiddleName}" Placeholder="Middle name" TextColor="#0F172A" />
                        <!-- Name Row (First Name + Last Name) -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="First Name" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                                <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,0" HeightRequest="46">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding FirstName}" Placeholder="First name" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Last Name" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                                <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,0" HeightRequest="46">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding LastName}" Placeholder="Last name" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Contact Number -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Mobile Phone Number" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding PhoneNumber}" Placeholder="09XXXXXXXXX" Keyboard="Telephone" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Email Address -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Email Address" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry IsReadOnly="True" Text="{Binding Email}" Placeholder="email@example.com" Keyboard="Email" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Barangay Dropdown -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Barangay (Marikina City)" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="12,0" HeightRequest="48">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Picker Grid.Column="0" ItemsSource="{Binding MarikinaBarangays}" SelectedItem="{Binding SelectedBarangay}" Title="Select Barangay" TextColor="#0F172A" TitleColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                                    <Path Grid.Column="1" Data="M7 10l5 5 5-5z" Fill="#64748B" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center" InputTransparent="True"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Street Address -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Street / House No." TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding StreetAddress}" Placeholder="e.g. 123 J.P. Rizal St." TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- City -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="City / Municipality" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                            <Border BackgroundColor="#F1F5F9" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,0" HeightRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding City}" IsReadOnly="True" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Save Information Button -->
                <Button Text="Save Information"
                        Command="{Binding SaveInformationCommand}"
                        BackgroundColor="#0A8491"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48"
                        Margin="0,6,0,24" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
