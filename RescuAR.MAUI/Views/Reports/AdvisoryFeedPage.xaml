<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Reports"
    xmlns:models="clr-namespace:RescuAR.App.Models"
    x:Class="RescuAR.App.Views.Reports.AdvisoryFeedPage"
    x:Name="AdvisoryPageRoot"
    x:DataType="vm:AdvisoryFeedViewModel"
    Title="Advisory Feed"
    Shell.NavBarIsVisible="True"
    BackgroundColor="#F8FAFC">
    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshAdvisoriesCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="20">

                    <!-- Page Title & Header Banner -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Reports / Advisories" TextColor="#64748B" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="#EF4444" VerticalOptions="Center" />
                                    <Label Text="LIVE" TextColor="#EF4444" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="{Binding CurrentDateTimeText}" TextColor="#334155" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <Label Text="Emergency Summary &amp; Advisories" TextColor="#0F172A" FontSize="26" FontAttributes="Bold" CharacterSpacing="-0.5" />
                        <Label Text="Real-time broadcasts from Marikina LGU &amp; Water Level Monitoring." TextColor="#475569" FontSize="13" />
                    </VerticalStackLayout>

                    <!-- Marikina River Monitoring Gauge Banner -->
                    <Border BackgroundColor="#0F766E" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Path Data="M12,3.25C12,3.25 6,10 6,14A6,6 0 0,0 12,20A6,6 0 0,0 18,14C18,10 12,3.25 12,3.25Z" Fill="#CCFBF1" WidthRequest="14" HeightRequest="14" Aspect="Uniform" VerticalOptions="Center" />
                                    <Label Text="Marikina River Monitoring" TextColor="#CCFBF1" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding CurrentAlertStatus}" TextColor="#FFFFFF" FontSize="18" FontAttributes="Bold" />
                                <Label Text="Pull down to refresh live advisories" TextColor="#99F6E4" FontSize="11" />
                            </VerticalStackLayout>

                            <!-- Water Level Meter Badge -->
                            <Border Grid.Column="1" BackgroundColor="#14B8A6" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10" VerticalOptions="Center">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                                    <Label Text="WATER LEVEL" TextColor="#E0F2FE" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="{Binding LatestWaterLevelText}" TextColor="#FFFFFF" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Filter Chips -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <!-- All -->
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding SelectedFilter}" Value="All">
                                                <Setter Property="BackgroundColor" Value="#0A8491" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="All" />
                                </Border.GestureRecognizers>
                                <Label Text="All Advisories" FontAttributes="Bold" FontSize="13">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="#475569" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding SelectedFilter}" Value="All">
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </Border>

                            <!-- Critical & Warnings -->
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding SelectedFilter}" Value="Critical">
                                                <Setter Property="BackgroundColor" Value="#EF4444" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="Critical" />
                                </Border.GestureRecognizers>
                                <Label Text="Critical &amp; Warnings" FontAttributes="Bold" FontSize="13">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="#475569" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding SelectedFilter}" Value="Critical">
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </Border>

                            <!-- Standby & Normal -->
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding SelectedFilter}" Value="Standby">
                                                <Setter Property="BackgroundColor" Value="#3B82F6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="Standby" />
                                </Border.GestureRecognizers>
                                <Label Text="Standby &amp; Normal" FontAttributes="Bold" FontSize="13">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="#475569" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding SelectedFilter}" Value="Standby">
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Advisories List -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Advisories}" Spacing="16">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DisasterAdvisory">
                                <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 20" BackgroundColor="#FFFFFF" Padding="18">
                                    <Border.Shadow>
                                        <Shadow Brush="#0F172A" Offset="0,4" Radius="8" Opacity="0.04" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.ShowAdvisoryDetailCommand, Source={x:Reference AdvisoryPageRoot}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    
                                    <VerticalStackLayout Spacing="14">
                                       
                                        <!-- Top Header Row: Alert Badge & Time Ago -->
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                <Border BackgroundColor="{Binding AlertBadgeBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,4" HorizontalOptions="Start">
                                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                        <Path Data="{Binding CategoryIconData}" Fill="{Binding AlertBadgeText}" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                                                        <Label Text="{Binding DisplayAlertLevelText}" TextColor="{Binding AlertBadgeText}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                                <Border IsVisible="{Binding ShowWaterLevel}" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                                                    <Label Text="Flood" TextColor="#475569" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <!-- Clock Icon -->
                                                <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                                      Fill="#94A3B8" WidthRequest="13" HeightRequest="13" Aspect="Uniform" VerticalOptions="Center" />
                                                <Label Text="{Binding TimeAgoText}" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- Title -->
                                        <Label Text="{Binding DisplayTitleText}" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" LineBreakMode="WordWrap" />

                                        <!-- Full Message Description Body -->
                                        <Label Text="{Binding DisplayMessageText}" TextColor="#334155" FontSize="13" LineBreakMode="WordWrap" CharacterSpacing="0.2" />

                                        <!-- 1. Dedicated Severity Recommendations Card with Aligned Shield Icon -->
                                        <Border IsVisible="{Binding HasActionPlan}" BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12">
                                            <VerticalStackLayout Spacing="6">
                                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                    <!-- Shield / Recommendation Icon -->
                                                    <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                                                          Fill="#B45309" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                                                    <Label Text="{Binding ActionPlanHeaderTagText}" TextColor="#B45309" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                
                                                <Label Text="{Binding DisplayActionPlanText}" TextColor="#92400E" FontSize="12" LineBreakMode="WordWrap" Margin="24,0,0,0" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- 2. Dedicated Nearest Safe Zone Card with Aligned Map Pin Icon -->
                                        <Border BackgroundColor="#F0FDFA" Stroke="#CCFBF1" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12">
                                            <VerticalStackLayout Spacing="6">
                                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                    <!-- Map Pin / Shelter Icon -->
                                                    <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                                          Fill="#0F766E" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                                                    <Label Text="{Binding AffectedAreaHeaderTagText}" TextColor="#0F766E" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                </HorizontalStackLayout>

                                                <Label Text="{Binding DisplayAffectedAreaText}" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap" Margin="24,0,0,0" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Bottom Navigation & Action Bar -->
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Margin="0,4,0,0">
                                            <Label Text="{Binding CreatedAtText}" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />

                                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                                <Border IsVisible="{Binding ShowWaterLevel}" BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Center">
                                                    <Label Text="{Binding WaterLevelText}" TextColor="#0284C7" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                </Border>

                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <HorizontalStackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding BindingContext.NavigateToEvacuationCentersCommand, Source={x:Reference AdvisoryPageRoot}}" />
                                                    </HorizontalStackLayout.GestureRecognizers>
                                                    <Label Text="View Safe Evacuation Hubs &amp; Route" TextColor="#0A8491" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                                    <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#0A8491" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </HorizontalStackLayout>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Pop-Up Advisory Overlay Modal Sheet -->
        <Grid IsVisible="{Binding IsPopupVisible}" BackgroundColor="#90000000" Padding="20" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="380" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="#FFFFFF" Padding="0">
                <VerticalStackLayout Spacing="0">
                   
                    <!-- Pop-up Header Banner -->
                    <Border BackgroundColor="{Binding SelectedAdvisory.AlertBadgeBg}" StrokeThickness="0" StrokeShape="RoundRectangle 24 24 0 0" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Path Data="{Binding SelectedAdvisory.CategoryIconData}" Fill="{Binding SelectedAdvisory.AlertBadgeText}" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SelectedAdvisory.HeaderTagText}" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="10" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedAdvisory.DisplayAlertLevelText}" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="15" FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <!-- Language Translation Button -->
                            <Border Grid.Column="2" BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="{Binding SelectedAdvisory.AlertBadgeText}" StrokeShape="RoundRectangle 12" Padding="10,5" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenTranslationMenuCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="Translation" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="▾" TextColor="{Binding SelectedAdvisory.AlertBadgeText}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Close Button -->
                            <Border Grid.Column="3" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClosePopupCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="✕" TextColor="#64748B" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Pop-up Body Content -->
                    <ScrollView MaximumHeightRequest="420" Padding="20">
                        <VerticalStackLayout Spacing="14">
                            <!-- Title -->
                            <Label Text="{Binding SelectedAdvisory.DisplayTitleText}" TextColor="#0F172A" FontSize="19" FontAttributes="Bold" />

                            <!-- Message Body -->
                            <Label Text="{Binding SelectedAdvisory.DisplayMessageText}" TextColor="#334155" FontSize="13" LineBreakMode="WordWrap" CharacterSpacing="0.2" />

                            <!-- Severity Recommendations -->
                            <Border IsVisible="{Binding SelectedAdvisory.HasActionPlan}" BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                                              Fill="#B45309" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                                        <Label Text="{Binding SelectedAdvisory.ActionPlanHeaderTagText}" TextColor="#B45309" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    
                                    <Label Text="{Binding SelectedAdvisory.DisplayActionPlanText}" TextColor="#92400E" FontSize="12" LineBreakMode="WordWrap" Margin="24,0,0,0" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Nearest Safe Zone Areas -->
                            <Border BackgroundColor="#F0FDFA" Stroke="#CCFBF1" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                              Fill="#0F766E" WidthRequest="16" HeightRequest="16" Aspect="Uniform" VerticalOptions="Center" />
                                        <Label Text="{Binding SelectedAdvisory.AffectedAreaHeaderTagText}" TextColor="#0F766E" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding SelectedAdvisory.DisplayAffectedAreaText}" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap" Margin="24,0,0,0" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Timestamp & Water Level -->
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Text="{Binding SelectedAdvisory.CreatedAtText}" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
                                <Border Grid.Column="1" IsVisible="{Binding SelectedAdvisory.ShowWaterLevel}" BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                    <Label Text="{Binding SelectedAdvisory.WaterLevelText}" TextColor="#0284C7" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Pop-up Footer Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,16" BackgroundColor="#F8FAFC">
                        <Button Grid.Column="0" Text="{Binding SelectedAdvisory.CloseButtonText}" TextColor="#475569" BackgroundColor="#E2E8F0" CornerRadius="12" HeightRequest="44" FontSize="13" FontAttributes="Bold" Command="{Binding ClosePopupCommand}" />
                        <Button Grid.Column="1" Text="View Evacuation Route" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="12" HeightRequest="44" FontSize="13" FontAttributes="Bold" Command="{Binding NavigateToEvacuationCentersCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
